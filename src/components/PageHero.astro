---
// Reusable blueprint-style page hero: faint grid, crosshair markers, a large
// faded watermark word behind a crisp headline, optional subtitle and chips.
interface Props {
  crumb: string;            // current page label for the breadcrumb
  eyebrow: string;
  heading: string;          // may include inline HTML (e.g. <br/>)
  watermark: string;        // large faded background word
  subtitle?: string;
  chips?: string[];
  i18nPrefix?: string;      // e.g. "export" → uses export.hero_eyebrow, .hero_heading, etc.
  i18nCrumb?: string;       // data-i18n key for the crumb label, e.g. "nav.how_we_export"
}
const { crumb, eyebrow, heading, watermark, subtitle, chips = [], i18nPrefix, i18nCrumb } = Astro.props;
// V2 ("Living Collage") puts the copy left and three rotating category tiles
// right; V1 keeps the centred blueprint hero below, unchanged.
import { isVersion } from "../data/site-options";
import CollageTiles from "./versions/v2/CollageTiles.astro";
import Vector from "./Vector.astro";
// The Journey (v3): small floating illustrations either side of the compact header.
const v3 = isVersion("v3");
const ART: Record<string, [string, number, string, number]> = {
  Products: ["sack", 92, "seeds", 110], Export: ["truck", 110, "crane", 112],
  About: ["farmer", 74, "fields", 104], Insights: ["moringa", 104, "scoop", 112], Contact: ["inquiry", 96, "plane", 112],
};
const art = v3 ? ART[watermark] : undefined;
const v2 = isVersion("v2");
// Vary the starting category per page so each page opens on different photos.
const start = [...watermark].reduce((n, ch) => n + ch.charCodeAt(0), 0) % 7;
---
{v2 ? (
<section class="v2-pagehero">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 v2-pagehero-inner">
    <div class="v2-pagehero-copy">
      <nav class="crumb text-sm" aria-label="Breadcrumb">
        <a href="/" data-i18n="nav.home">Home</a> <span class="text-slate-300 mx-1">/</span>
        <span class="text-slate-500" data-i18n={i18nCrumb || undefined}>{crumb}</span>
      </nav>
      <span class="eyebrow mt-5" data-i18n={i18nPrefix ? `${i18nPrefix}.hero_eyebrow` : undefined}>{eyebrow}</span>
      <h1 class="v2-pagehero-title" data-i18n-html={i18nPrefix ? `${i18nPrefix}.hero_heading` : undefined} set:html={heading}></h1>
      {subtitle && (
        <p class="v2-pagehero-sub" data-i18n={i18nPrefix ? `${i18nPrefix}.hero_sub` : undefined}>{subtitle}</p>
      )}
      {chips.length > 0 && (
        <div class="ph-chips v2-pagehero-chips">
          {chips.map((c, idx) => <span class="ph-chip" data-i18n={i18nPrefix ? `${i18nPrefix}.hero_chip${idx + 1}` : undefined}>{c}</span>)}
        </div>
      )}
    </div>
    <CollageTiles
      class="v2-collage--page"
      hero
      start={start}
      sizes={[
        "(max-width: 767px) 100vw, 520px",
        "(max-width: 767px) 50vw, 260px",
        "(max-width: 767px) 50vw, 260px",
      ]}
    />
  </div>
</section>
) : (
<section class="page-hero blueprint" data-ph={watermark}>
  {art && <span class="ph-art ph-art-l" aria-hidden="true"><Vector name={art[0]} size={art[1]} /></span>}
  {art && <span class="ph-art ph-art-r" aria-hidden="true"><Vector name={art[2]} size={art[3]} /></span>}
  <span class="bp-plus" style="top:16%;left:7%"></span>
  <span class="bp-plus" style="top:60%;left:13%"></span>
  <span class="bp-plus" style="top:28%;right:9%"></span>
  <span class="bp-plus" style="top:72%;right:17%"></span>
  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative">
    <nav class="crumb text-sm reveal" aria-label="Breadcrumb">
      <a href="/" data-i18n="nav.home">Home</a> <span class="text-slate-300 mx-1">/</span>
      <span class="text-slate-500" data-i18n={i18nCrumb || undefined}>{crumb}</span>
    </nav>
    <div class="ph-stack reveal d1">
      <span class="ph-watermark" aria-hidden="true">{watermark}</span>
      <div class="ph-fore">
        <span class="eyebrow center" data-i18n={i18nPrefix ? `${i18nPrefix}.hero_eyebrow` : undefined}>{eyebrow}</span>
        <h1 class="ph-h1 font-extrabold mt-4" data-i18n-html={i18nPrefix ? `${i18nPrefix}.hero_heading` : undefined} set:html={heading}></h1>
        {subtitle && (
          <p class="text-slate-600 text-lg mt-6 max-w-2xl mx-auto leading-relaxed" data-i18n={i18nPrefix ? `${i18nPrefix}.hero_sub` : undefined}>{subtitle}</p>
        )}
        {chips.length > 0 && (
          <div class="ph-chips mt-8">
            {chips.map((c, idx) => <span class="ph-chip" data-i18n={i18nPrefix ? `${i18nPrefix}.hero_chip${idx + 1}` : undefined}>{c}</span>)}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
)}
