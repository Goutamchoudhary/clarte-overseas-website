---
// Shared site footer + floating WhatsApp / scroll-to-top buttons.
// Layered gradient + trust strip + watermark (not a flat dark block).
import { SOCIAL, CONTACT } from "../consts";
import { categories } from "../data/products";
---
<footer class="site-footer text-slate-300">
  <div class="footer-topline"></div>
  <span class="footer-watermark" aria-hidden="true">Clarté</span>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-6">
    <!-- Columns -->
    <div class="grid md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-16">
      <!-- Brand + contact (left) -->
      <div class="lg:col-span-4">
        <img src="/assets/logo/logo-horizontal-white.svg" alt="Clarté Overseas" class="h-14 w-auto" />
        <p class="text-slate-400 text-sm mt-5 leading-relaxed max-w-xs"><span data-i18n="footer.description">Merchant exporters of dehydrated fruits, vegetables and powders, bringing India's harvest to kitchens around the world.</span></p>
        <ul class="mt-6 space-y-3 text-sm text-slate-400 max-w-xs">
          <li class="flex gap-2.5"><svg class="w-4 h-4 mt-0.5 text-[#7ee0d3] shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg><span>1st Floor, CW-59, Sanjay Gandhi Transport Nagar, Delhi, India. 110042</span></li>
          <li class="flex gap-2.5"><svg class="w-4 h-4 mt-0.5 text-[#7ee0d3] shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><a href="mailto:info@clarteoverseas.com" class="footer-link">info@clarteoverseas.com</a></li>
          <li class="flex gap-2.5"><svg class="w-4 h-4 mt-0.5 text-[#7ee0d3] shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg><div class="flex flex-col gap-0.5"><a href="tel:+919818915310" class="footer-link">(+91) 98189 15310 <span class="text-[#7ee0d3] text-xs font-semibold">WhatsApp</span></a><a href="tel:+918800242156" class="footer-link text-slate-500">(+91) 8800242156</a></div></li>
        </ul>
        <div class="flex gap-3 mt-6">
          <a href={SOCIAL.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="social-ico"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a>
          <a href={SOCIAL.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="social-ico"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
          <a href={SOCIAL.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="social-ico"><svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg></a>
        </div>
      </div>

      <!-- Company -->
      <div class="lg:col-span-2">
        <h4 class="font-head font-semibold text-white mb-4"><span data-i18n="footer.col_company">Company</span></h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="footer-link" data-i18n="nav.home">Home</a></li>
          <li><a href="/about" class="footer-link" data-i18n="nav.about">About Us</a></li>
          <li><a href="/how-we-export" class="footer-link" data-i18n="nav.how_we_export">How We Export</a></li>
          <li><a href="/certifications" class="footer-link" data-i18n="nav.certifications">Certifications</a></li>
          <li><a href="/contact" class="footer-link" data-i18n="nav.contact">Contact Us</a></li>
        </ul>
      </div>

      <!-- Products -->
      <div class="lg:col-span-3">
        <h4 class="font-head font-semibold text-white mb-4"><span data-i18n="footer.col_products">Products</span></h4>
        <ul class="space-y-2.5 text-sm">
          {categories.map((c) => (
            <li><a href={`/products/${c.slug}`} class="footer-link" data-i18n={`products.cat_${c.slug.replace(/-/g,'_')}_name`}>{c.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Get a Quote (right) -->
      <div class="lg:col-span-3">
        <h4 class="font-head font-semibold text-white mb-4"><span data-i18n="footer.col_quote">Get a Quote</span></h4>
        <p class="text-slate-400 text-sm mb-4 leading-relaxed"><span data-i18n="footer.quote_body">Tell us the product and your market. We will get back with specs and pricing.</span></p>
        <a href="/contact" class="btn btn-primary text-sm w-full mb-3"><span data-i18n="footer.btn_quote">Request a Quote</span></a>
        <a href="#" data-wa data-wa-msg="Hi Clarté Overseas, I found your website and I'd like to get in touch about your dehydrated food products." class="btn btn-wa text-sm w-full">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
          <span data-i18n="footer.btn_whatsapp">Chat on WhatsApp</span>
        </a>
        {CONTACT.calendlyUrl && (
          <a href={CONTACT.calendlyUrl} onclick={`Calendly.initPopupWidget({url:'${CONTACT.calendlyUrl}'});return false;`} class="btn btn-calendly text-sm w-full mt-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            Book a 20-min call
          </a>
        )}
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 mt-20 pt-8 flex flex-col sm:flex-row justify-between items-center gap-3 text-sm text-slate-500">
      <p>© <span id="year"></span> <span data-i18n="footer.copyright">Clarté Overseas. All rights reserved.</span></p>
      <p class="flex items-center gap-2"><span data-i18n="footer.tagline">Proudly exporting from India</span> <span class="text-base">🇮🇳</span></p>
    </div>
  </div>
</footer>

<!-- Floating buttons -->
<a href="#" data-wa data-wa-msg="Hi Clarté Overseas, I'm reaching out from your website — can we connect on WhatsApp?" class="fab-wa" aria-label="Chat or call on WhatsApp">
  <span class="fab-tip">
    <strong>Chat or Call on WhatsApp</strong>
    <span>(+91) 98189 15310</span>
  </span>
  <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413z"/></svg>
</a>
<button id="toTop" class="fab-top" aria-label="Scroll to top">
  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</button>
