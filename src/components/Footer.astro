---
// Shared site footer + floating WhatsApp / scroll-to-top buttons.
// Layered gradient + trust strip + watermark (not a flat dark block).
---
<footer class="site-footer text-slate-300">
  <div class="footer-topline"></div>
  <span class="footer-watermark" aria-hidden="true">Clarté</span>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-10">
    <!-- Trust strip -->
    <div class="trust-strip mb-14 reveal">
      <div class="trust-item">
        <span class="t-ico"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg></span>
        <div><div class="t-num">25+</div><div class="t-label">Countries served</div></div>
      </div>
      <div class="trust-item">
        <span class="t-ico"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12"/></svg></span>
        <div><div class="t-num">40+</div><div class="t-label">Dehydrated SKUs</div></div>
      </div>
      <div class="trust-item">
        <span class="t-ico"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></span>
        <div><div class="t-num">ISO &amp; HACCP</div><div class="t-label">Certified supply</div></div>
      </div>
      <div class="trust-item">
        <span class="t-ico"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M7 20h10M10 20c5.5-2.5.8-6.4 3-10M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4 2.2-.2 3.9.2 5.5.6z"/></svg></span>
        <div><div class="t-num">Farm-direct</div><div class="t-label">Traceable sourcing</div></div>
      </div>
    </div>

    <!-- Columns -->
    <div class="grid md:grid-cols-2 lg:grid-cols-12 gap-10">
      <!-- Get a Quote -->
      <div class="lg:col-span-3">
        <h4 class="font-head font-semibold text-white mb-4">Get a Quote</h4>
        <p class="text-slate-400 text-sm mb-4 leading-relaxed">Tell us the product and your market. We will get back with specs and pricing.</p>
        <a href="#quote" class="btn btn-primary text-sm w-full mb-3">Request a Quote</a>
        <a href="#" data-wa class="btn btn-wa text-sm w-full">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
          Chat on WhatsApp
        </a>
      </div>

      <!-- Contact -->
      <div class="lg:col-span-3 lg:pl-8">
        <h4 class="font-head font-semibold text-white mb-4">Contact</h4>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex gap-2.5"><svg class="w-4 h-4 mt-0.5 text-[#7ee0d3] shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg><span>1st Floor, CW-59, Sanjay Gandhi Transport Nagar, Delhi, India. 110042</span></li>
          <li class="flex gap-2.5"><svg class="w-4 h-4 mt-0.5 text-[#7ee0d3] shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><a href="mailto:info@clarteoverseas.com" class="footer-link">info@clarteoverseas.com</a></li>
          <li class="flex gap-2.5"><svg class="w-4 h-4 mt-0.5 text-[#7ee0d3] shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg><a href="#" data-wa class="footer-link">WhatsApp Business</a></li>
        </ul>
      </div>

      <!-- Explore (extra left space) -->
      <div class="lg:col-span-2 lg:pl-12">
        <h4 class="font-head font-semibold text-white mb-4">Explore</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#export" class="footer-link">Products</a></li>
          <li><a href="#portfolio" class="footer-link">Portfolio</a></li>
          <li><a href="#advantage" class="footer-link">Why Us</a></li>
          <li><a href="#markets" class="footer-link">Markets</a></li>
          <li><a href="#certifications" class="footer-link">Certifications</a></li>
        </ul>
      </div>

      <!-- Brand (right) -->
      <div class="lg:col-span-4 lg:text-right">
        <img src="/assets/logo/logo-horizontal-white.svg" alt="Clarté Overseas" class="h-10 w-auto lg:ml-auto" />
        <p class="text-slate-400 text-sm mt-5 leading-relaxed max-w-xs lg:ml-auto">Merchant exporters of dehydrated fruits, vegetables and powders, bringing India's harvest to kitchens around the world.</p>
        <div class="flex gap-3 mt-6 lg:justify-end">
          <a href="#" aria-label="Instagram" class="social-ico"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a>
          <a href="#" aria-label="LinkedIn" class="social-ico"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
          <a href="#" aria-label="Facebook" class="social-ico"><svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg></a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 mt-14 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-sm text-slate-500">
      <p>© <span id="year"></span> Clarté Overseas. All rights reserved.</p>
      <p class="flex items-center gap-2">Proudly exporting from India <span class="text-base">🇮🇳</span></p>
    </div>
  </div>
</footer>

<!-- Floating buttons -->
<a href="#" data-wa class="fab-wa" aria-label="Chat on WhatsApp">
  <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413z"/></svg>
</a>
<button id="toTop" class="fab-top" aria-label="Scroll to top">
  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</button>
