---
// Product detail page on "The Journey" (v3): everything between the navbar and
// the dialogs. Colours come from the category palette (body:has([data-cat])) in
// /css/site-v3.css. The gallery, zoom and form toggle scripts in [product].astro
// rely on the pd* ids and classes kept here.
import fs from "node:fs";
import path from "node:path";
import type { Product, Category } from "../data/products";
import { srcsetFor, smallest, SIZES } from "../lib/responsive-img";
import { artFor } from "../lib/product-art";
import { checksFor } from "../data/market-checks";
import Vector from "./Vector.astro";

interface Props {
  p: Product;
  cat: Category;
  specs: [string, string, string, string?][];
  faqs: { key: string; q: string; a: string }[];
  related: Product[];
  stockLabel: string;
  stockI18n: string;
  isUnavailable: boolean;
  isComingSoon: boolean;
}
const { p, cat, specs, faqs, related, stockLabel, stockI18n, isUnavailable, isComingSoon } = Astro.props;
const pk = p.slug.replace(/-/g, "_");
const ck = cat.slug.replace(/-/g, "_");
const art = `/assets/img/products/art/${p.slug}.svg`;
const hasArt = fs.existsSync(path.join(process.cwd(), "public", art));
const checks = checksFor(p.slug, cat.slug);
---
<section class="j-pd-hero" data-cat={cat.slug}>
  <div class="j-wrap">
    <nav class="j-cat-crumb" aria-label="Breadcrumb">
      <a href="/" data-i18n="nav.home">Home</a> <span aria-hidden="true">/</span>
      <a href="/products" data-i18n="nav.products">Products</a> <span aria-hidden="true">/</span>
      <a href={`/products/${cat.slug}`} data-i18n={`products.cat_${ck}_name`}>{cat.name}</a> <span aria-hidden="true">/</span>
      <span data-i18n={`cat.prod_${pk}_name`}>{p.name}</span>
    </nav>
    <div class="j-pd-grid">
      <div class="pd-media">
        <div class={`pd-frame${p.image ? " has-photo" : " no-img"}`} id="pdFrame">
          {p.image
            ? <img src={p.image} srcset={srcsetFor(p.image)} sizes={SIZES.detail} alt={p.name} id="pdImg" class="pd-img" fetchpriority="high" data-splash-hero />
            : hasArt ? <img src={art} alt={p.name} class="pd-art" width="320" height="320" data-splash-hero /> : <span class="pd-emoji">{p.emoji}</span>}
        </div>
        {p.image && p.gallery?.length ? (
          <div class="pd-thumbs" role="group" aria-label="Product photos">
            {[{ src: p.image, alt: p.name }, ...p.gallery].map((g, i) => (
              <button type="button" class={`pd-thumb${i === 0 ? " active" : ""}`} data-src={g.src} data-srcset={srcsetFor(g.src)} data-alt={g.alt} aria-label={g.alt} aria-pressed={i === 0 ? "true" : "false"}>
                <img src={smallest(g.src)} alt="" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        ) : null}
      </div>

      <div class="j-pd-info">
        <h1 class="j-pd-title">
          <span data-i18n={`cat.prod_${pk}_name`}>{p.name}</span>
          <small data-i18n="prod.title_kicker">Exporter &amp; Bulk Supplier in India</small>
        </h1>
        {p.botanical && <p class="j-pd-botanical">{p.botanical}</p>}
        <p class="j-pd-tagline" data-i18n={`cat.prod_${pk}_tagline`}>{p.tagline}</p>
        <div class="j-pd-meta">
          <span class="j-pd-hsn">HSN {p.hsn}</span>
          <div class={`pd-stock${isUnavailable ? " pd-stock-unavail" : isComingSoon ? " pd-stock-out" : ""}`}>
            <span class={isUnavailable ? "pd-stock-dot-unavail" : isComingSoon ? "pd-stock-dot-out" : "pd-stock-dot"} aria-hidden="true"></span>
            <span data-i18n={stockI18n}>{stockLabel}</span>
          </div>
        </div>
        {p.forms && (
          <div class="pd-forms">
            <span class="pd-forms-label" data-i18n="prod.available_in">Available in</span>
            <div class="pd-forms-toggle" role="group">
              {p.forms.map((f, i) => <button type="button" class={`pd-form-btn${i === 0 ? " active" : ""}`} data-form={f}>{f}</button>)}
            </div>
          </div>
        )}
        <div class="pd-cta">
          <button type="button" class="btn btn-primary" data-open-enquire data-product={p.name} data-category={cat.name}>
            <span data-i18n="prod.enquire_btn">Enquire / Request a quote</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <a href="#" data-wa data-wa-msg="Hi Clarté Overseas, I'm interested in your {product} — could you share pricing, MOQ and availability?" data-wa-product={p.name} class="btn btn-wa">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-.607z"/></svg>
            <span data-i18n="prod.whatsapp_btn">WhatsApp</span>
          </a>
        </div>
        <button type="button" class="j-pd-sample" data-open-enquire data-is-sample="true" data-product={p.name} data-category={cat.name}>
          <span data-i18n="prod.sample_req_btn">Request a Free Sample</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<section class="j-pd-sec">
  <div class="j-wrap j-pd-about">
    <div class="reveal">
      <p class="j-pd-label" data-i18n={`cat.prod_${pk}_name`}>{p.name}</p>
      <p class="j-pd-lead" data-i18n={`prod.${pk}_desc`}>{p.description}</p>
    </div>
    <div class="j-pd-panel reveal d1">
      {hasArt && p.image && <img class="j-pd-mascot" src={art} alt="" width="96" height="96" loading="lazy" decoding="async" />}
      <h2 class="j-pd-h2" data-i18n="prod.features_heading">Key features</h2>
      <ul class="j-pd-ticks">
        {p.features.map((f, i) => <li data-i18n={`prod.${pk}_f${i + 1}`}>{f}</li>)}
      </ul>
    </div>
  </div>
</section>

<section class="j-pd-sec j-pd-sec-tight">
  <div class="j-wrap">
    <h2 class="j-pd-h2 reveal" data-i18n="prod.uses_heading">Where it's used</h2>
    <div class="j-pd-uses">
      {p.uses.map((u, i) => (
        <div class={`j-pd-use reveal d${i}`}>
          <span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <p data-i18n={`prod.${pk}_u${i + 1}`}>{u}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="j-pd-sec">
  <div class="j-wrap j-pd-specs">
    <div class="j-pd-table reveal">
      <h2 class="j-pd-h2" data-i18n="prod.spec_heading">Specifications</h2>
      <dl class="pd-spec">
        {specs.map(([k, v, i18nKey, vKey]) => (
          <div class="pd-spec-row"><dt data-i18n={i18nKey}>{k}</dt><dd data-i18n={vKey}>{v}</dd></div>
        ))}
      </dl>
      <h3 class="j-pd-h3" data-i18n="prod.grades_heading">Typical grades</h3>
      <div class="j-pd-grades">
        {p.grades.map((g, i) => <span data-i18n={`prod.${pk}_g${i + 1}`}>{g}</span>)}
      </div>
      <p class="j-pd-note" data-i18n="prod.spec_note">Specs are indicative and can be tailored to your formulation. Full COA and spec sheet shared on request.</p>
    </div>
    <div class="j-pd-sheet reveal d1">
      <button type="button" class="j-lock-doc" data-open-specsheet data-slug={p.slug} data-product={p.name} data-category={cat.name} tabindex="-1" aria-hidden="true">
        <span class="pd-spec-btn-label" hidden></span>
        <span class="j-lock-under"></span>
        <span class="j-lock-paper">
          <span class="j-lock-band"><small data-i18n="prod.spec_card_label">Technical Data Sheet</small><b>{p.name}</b></span>
          <span class="j-lock-rows"><span class="j-lock-row"><i style="width:26%"></i><i style="width:40%"></i></span><span class="j-lock-row"><i style="width:34%"></i><i style="width:28%"></i></span><span class="j-lock-row"><i style="width:22%"></i><i style="width:46%"></i></span><span class="j-lock-row"><i style="width:30%"></i><i style="width:36%"></i></span><span class="j-lock-row"><i style="width:24%"></i><i style="width:44%"></i></span><span class="j-lock-row"><i style="width:36%"></i><i style="width:30%"></i></span><span class="j-lock-row"><i style="width:20%"></i><i style="width:42%"></i></span><span class="j-lock-row"><i style="width:28%"></i><i style="width:34%"></i></span></span>
        </span>
        <span class="j-lock-frost"></span>
        <span class="j-lock-badge">
          <svg viewBox="0 0 48 56" aria-hidden="true"><path class="j-lock-shackle" d="M13 25V15a11 11 0 0 1 22 0v10" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/><rect x="5" y="24" width="38" height="29" rx="8" fill="currentColor"/><circle cx="24" cy="36" r="4.5" fill="#fff"/><rect x="22" y="38" width="4" height="9" rx="2" fill="#fff"/></svg>
        </span>
      </button>
      <p class="j-pd-sheet-title" data-i18n="prod.lock_title">This spec sheet is locked</p>
      <p class="j-pd-sheet-sub"><span>{p.name}</span> · <span data-i18n="prod.spec_pdf_sub">PDF · full technical data sheet</span></p>
      <button type="button" class="j-pd-sheet-btn" data-open-specsheet data-slug={p.slug} data-product={p.name} data-category={cat.name} aria-label={`Download ${p.name} spec sheet`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <span class="pd-spec-btn-label" data-i18n="prod.lock_btn">Enter details to unlock</span>
      </button>
      <p class="j-pd-sheet-note" data-i18n="prod.spec_free_note">Free · share a few details to unlock the PDF</p>
      <button type="button" class="j-pd-sheet-link" data-open-enquire data-product={p.name} data-category={cat.name}><span data-i18n="prod.get_pricing">Get pricing &amp; samples</span></button>
    </div>
  </div>
</section>

<section class="j-pd-sec j-pd-mkt-sec">
  <div class="j-wrap">
    <div class="j-pd-mkt reveal">
      <div class="j-pd-mkt-head">
        <span class="j-pd-label" data-i18n="mkt.eyebrow">Export compliance</span>
        <h2 class="j-pd-h2" data-i18n="mkt.heading">What importers test this product for</h2>
        <p class="j-pd-mkt-intro" data-i18n="mkt.intro">The limits buyers in the EU, US and Japan check this product against. Tell us your destination and lots are tested against its limits before shipping, with results on the COA.</p>
        <p class="j-pd-mkt-note" data-i18n="mkt.note">Limits shown are the EU's, the strictest most buyers apply. Where your market's own limits differ, we work to those.</p>
      </div>
      <ul class="j-pd-mkt-list">
        {checks.map((c) => (
          <li>
            <span class="j-pd-mkt-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M8.5 12l2.4 2.4L15.5 9.8"/></svg></span>
            <span><b data-i18n={`mkt.${c.id}_t`}>{c.title}</b><small data-i18n={`mkt.${c.id}_b`}>{c.body}</small></span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="j-faq j-pd-faq">
  <div class="j-wrap j-faq-grid">
    <div class="reveal">
      <span class="eyebrow" data-i18n="prod.faq_eyebrow">Sourcing</span>
      <h2 class="j-h2 j-h2-md"><span data-i18n="prod.faq_heading_a">Buying </span><span data-i18n={`cat.prod_${pk}_name`}>{p.name}</span><span data-i18n="prod.faq_heading_b"> from India</span></h2>
      <p class="j-sub" data-i18n="prod.faq_intro">Clarté Overseas is an India-based merchant exporter and bulk supplier of dehydrated food ingredients, shipping food-grade material to manufacturers, flavour houses, nutraceutical brands and ingredient distributors worldwide. Below are the questions buyers ask most before a first order.</p>
      <span class="j-faq-art"><Vector name="buyer-questions" size={176} /></span>
    </div>
    <div class="reveal d1">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>
            <span data-i18n={`prod.${f.key}_q`}>{f.q}</span>
            <svg class="chev w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="faq-body" data-i18n={`prod.${f.key}_a`}>{f.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

{related.length > 0 && (
  <section class="j-cat-list j-pd-related">
    <div class="j-wrap">
      <div class="j-pd-related-head reveal">
        <h2 class="j-pd-h2"><span data-i18n="prod.related_prefix">More from</span> <span data-i18n={`products.cat_${ck}_name`}>{cat.name}</span></h2>
        <a href={`/products/${cat.slug}`} class="prod-view"><span data-i18n="prod.view_all">View all</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="prod-grid">
        {related.map((r) => (
          <article class="prod-card reveal">
            <a href={`/products/${cat.slug}/${r.slug}`} class="prod-media" aria-label={r.name}>
              {(r.listImage || r.image) ? <img src={r.listImage || r.image} srcset={srcsetFor(r.listImage || r.image)} sizes={SIZES.card} alt={r.name} loading="lazy" decoding="async" /> : artFor(r.slug) ? <img src={artFor(r.slug)} alt={r.name} class="prod-art" loading="lazy" decoding="async" /> : <span class="prod-emoji">{r.emoji}</span>}
            </a>
            <div class="prod-body">
              <span class="prod-hsn">HSN {r.hsn}</span>
              <h3 class="prod-name"><a href={`/products/${cat.slug}/${r.slug}`} data-i18n={`cat.prod_${r.slug.replace(/-/g, "_")}_name`}>{r.name}</a></h3>
              <p class="prod-tag" data-i18n={`cat.prod_${r.slug.replace(/-/g, "_")}_tagline`}>{r.tagline}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
