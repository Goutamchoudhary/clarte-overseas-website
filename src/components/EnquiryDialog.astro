---
// Reusable enquiry dialog. Any element with [data-open-enquire] opens it;
// the trigger's data-product / data-category pre-fill the form. Posts to
// Web3Forms (same backend as the contact page).
import { CONTACT } from "../consts";
---
<div class="enq-modal" id="enqModal" hidden>
  <div class="enq-card" role="dialog" aria-modal="true" aria-labelledby="enqTitle">
    <button type="button" class="enq-x" data-enq-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>

    <div class="enq-main" id="enqMain">
      <span class="eyebrow" id="enqEyebrow" data-i18n="enq.eyebrow">Enquiry</span>
      <h3 id="enqTitle" class="enq-title" data-i18n="enq.title">Request a quote</h3>
      <p class="enq-sub" id="enqSub" data-i18n="enq.sub">Tell us a little about your requirement — we reply within one business day, often the same day.</p>

      <div class="enq-chip" id="enqChip" hidden>
        <span class="enq-chip-dot"></span>
        <span><strong id="enqChipProduct"></strong><span id="enqChipCat" class="enq-chip-cat"></span></span>
      </div>

      <form id="enqForm" action="https://api.web3forms.com/submit" method="POST" class="enq-form">
        <input type="hidden" name="access_key" value={CONTACT.web3formsKey} />
        <input type="hidden" name="subject" id="enqSubject" value="Product enquiry — Clarté Overseas website" />
        <input type="hidden" name="from_name" value="Clarté Overseas website" />
        <input type="checkbox" name="botcheck" class="enq-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="category" id="enqCategory" value="" />
        <input type="hidden" name="product" id="enqProduct" value="" />

        <div class="enq-2col">
          <label class="enq-field"><span><span data-i18n="enq.field_name">Name</span> <i>*</i></span>
            <input name="name" type="text" required data-i18n-ph="enq.ph_name" placeholder="Your name" />
          </label>
          <label class="enq-field"><span><span data-i18n="enq.field_company">Company</span> <i>*</i></span>
            <input name="company" type="text" required data-i18n-ph="enq.ph_company" placeholder="Company" />
          </label>
        </div>
        <div class="enq-2col">
          <label class="enq-field"><span><span data-i18n="enq.field_email">Email</span> <i>*</i></span>
            <input name="email" type="email" required data-i18n-ph="enq.ph_email" placeholder="you@company.com" />
          </label>
          <label class="enq-field"><span><span data-i18n="enq.field_phone">Phone / WhatsApp</span> <i>*</i></span>
            <input name="phone" type="tel" required data-i18n-ph="enq.ph_phone" placeholder="+1 555 000 0000" />
          </label>
        </div>
        <label class="enq-field"><span><span data-i18n="enq.field_country">Destination country</span> <i>*</i></span>
          <input name="country" type="text" required data-i18n-ph="enq.ph_country" placeholder="Where it's headed" />
        </label>
        <label class="enq-field"><span><span data-i18n="enq.field_requirement">Your requirement</span> <i>*</i></span>
          <textarea name="message" required data-i18n-ph="enq.ph_requirement" placeholder="Quantity, grade, form, destination country, target price…"></textarea>
        </label>
        <button type="submit" class="enq-submit">
          <span data-i18n="enq.submit">Send enquiry</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>
    </div>

    <div class="enq-done" id="enqDone" hidden>
      <span class="enq-done-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path class="enq-done-tick" d="m5 13 4 4L19 7"/></svg></span>
      <h3 class="enq-title" data-i18n="enq.done_title">Enquiry sent — thank you!</h3>
      <p class="enq-sub" data-i18n="enq.done_body">We've received your message and will reply within one business day.</p>
      <button type="button" class="enq-submit" data-enq-close><span data-i18n="enq.done_btn">Done</span></button>
    </div>
  </div>
</div>

<!-- Hidden strings used by JS (translated at runtime via i18n engine) -->
<span id="enqStrSending" data-i18n="enq.sending" hidden>Sending…</span>
<span id="enqStrGeneral" data-i18n="enq.general" hidden>General enquiry</span>
<span id="enqStrEyebrow" data-i18n="enq.eyebrow" hidden>Enquiry</span>
<span id="enqStrTitle" data-i18n="enq.title" hidden>Request a quote</span>
<span id="enqStrSub" data-i18n="enq.sub" hidden>Tell us a little about your requirement — we reply within one business day, often the same day.</span>
<span id="enqStrSampleEyebrow" data-i18n="enq.sample_eyebrow" hidden>Free Sample</span>
<span id="enqStrSampleTitle" data-i18n="enq.sample_title" hidden>Request a free sample</span>
<span id="enqStrSampleSub" data-i18n="enq.sample_sub" hidden>Fill in your details and we'll arrange a sample shipment to evaluate quality before you commit to an order.</span>
<span id="enqStrSampleMessage" data-i18n="enq.sample_message" hidden>I would like to request a free sample of {"{product}"}. Please let me know the quantities available and any shipping or courier charges that may apply.</span>
<span id="enqStrSamplePrefix" data-i18n="enq.sample_prefix" hidden>Sample: </span>
<span id="enqStrErrorGeneric" data-i18n="enq.error_generic" hidden>Something went wrong. Please email info@clarteoverseas.com.</span>
<span id="enqStrErrorNetwork" data-i18n="enq.error_network" hidden>Network error — please try again or email info@clarteoverseas.com.</span>

<script>
  const modal = document.getElementById("enqModal");
  if (modal) {
    const form = document.getElementById("enqForm") as HTMLFormElement;
    const main = document.getElementById("enqMain");
    const done = document.getElementById("enqDone");
    const chip = document.getElementById("enqChip");
    const chipProduct = document.getElementById("enqChipProduct");
    const chipCat = document.getElementById("enqChipCat");
    const fCat = document.getElementById("enqCategory") as HTMLInputElement;
    const fProd = document.getElementById("enqProduct") as HTMLInputElement;
    const fSubject = document.getElementById("enqSubject") as HTMLInputElement;
    const strSending = () => document.getElementById("enqStrSending")?.textContent || "Sending…";
    const strGeneral = () => document.getElementById("enqStrGeneral")?.textContent || "General enquiry";
    const strEyebrow = () => document.getElementById("enqStrEyebrow")?.textContent || "Enquiry";
    const strTitle = () => document.getElementById("enqStrTitle")?.textContent || "Request a quote";
    const strSub = () => document.getElementById("enqStrSub")?.textContent || "Tell us a little about your requirement — we reply within one business day, often the same day.";
    const strSampleEyebrow = () => document.getElementById("enqStrSampleEyebrow")?.textContent || "Free Sample";
    const strSampleTitle = () => document.getElementById("enqStrSampleTitle")?.textContent || "Request a free sample";
    const strSampleSub = () => document.getElementById("enqStrSampleSub")?.textContent || "Fill in your details and we'll arrange a sample shipment to evaluate quality before you commit to an order.";
    const strSampleMessage = (product: string) =>
      (document.getElementById("enqStrSampleMessage")?.textContent ||
        "I would like to request a free sample of {product}. Please let me know the quantities available and any shipping or courier charges that may apply."
      ).replace("{product}", product);
    const strSamplePrefix = () => document.getElementById("enqStrSamplePrefix")?.textContent || "Sample: ";
    const strErrorGeneric = () => document.getElementById("enqStrErrorGeneric")?.textContent || "Something went wrong. Please email info@clarteoverseas.com.";
    const strErrorNetwork = () => document.getElementById("enqStrErrorNetwork")?.textContent || "Network error — please try again or email info@clarteoverseas.com.";

    const open = (product: string, category: string, isSample = false) => {
      fProd.value = product || "";
      fCat.value = category || "";

      const title = document.getElementById("enqTitle");
      const eyebrow = document.getElementById("enqEyebrow");
      const sub = document.getElementById("enqSub");
      const msgArea = form.querySelector("textarea[name='message']") as HTMLTextAreaElement;

      if (isSample) {
        if (fSubject) fSubject.value = "Sample request — Clarté Overseas website";
        if (eyebrow) eyebrow.textContent = strSampleEyebrow();
        if (title) title.textContent = strSampleTitle();
        if (sub) sub.textContent = strSampleSub();
        if (msgArea && product) msgArea.value = strSampleMessage(product);
      } else {
        if (fSubject) fSubject.value = "Product enquiry — Clarté Overseas website";
        if (eyebrow) eyebrow.textContent = strEyebrow();
        if (title) title.textContent = strTitle();
        if (sub) sub.textContent = strSub();
        if (msgArea && !msgArea.value) msgArea.value = "";
      }

      if (product || category) {
        chip.hidden = false;
        chipProduct.textContent = (isSample ? strSamplePrefix() : "") + (product || strGeneral());
        chipCat.textContent = category ? "  ·  " + category : "";
      } else {
        chip.hidden = true;
      }
      main.hidden = false;
      done.hidden = true;
      modal.hidden = false;
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      modal.hidden = true;
      document.body.style.overflow = "";
      // reset sample-mode overrides so next open starts clean
      const msgArea = form.querySelector("textarea[name='message']") as HTMLTextAreaElement;
      if (msgArea) msgArea.value = "";
    };

    document.querySelectorAll("[data-open-enquire]").forEach((b) =>
      b.addEventListener("click", () =>
        open(
          b.getAttribute("data-product") || "",
          b.getAttribute("data-category") || "",
          b.getAttribute("data-is-sample") === "true"
        )
      )
    );
    modal.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t === modal || t.closest("[data-enq-close]")) close();
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.hidden) close(); });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const btn = form.querySelector(".enq-submit") as HTMLButtonElement;
      const original = btn.innerHTML;
      btn.disabled = true; btn.textContent = strSending();
      try {
        const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
        const data = await res.json().catch(() => null);
        if (res.ok && data && data.success) { form.reset(); main.hidden = true; done.hidden = false; }
        else { alert((data && data.message) || strErrorGeneric()); }
      } catch { alert(strErrorNetwork()); }
      finally { btn.disabled = false; btn.innerHTML = original; }
    });
  }
</script>
