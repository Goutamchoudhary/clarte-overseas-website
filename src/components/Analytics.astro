---
// Analytics loader — consent-gated.
// On first visit nothing fires; CookieBanner calls window.__initAnalytics() on accept.
// On return visits with stored consent, analytics fires immediately.
import { ANALYTICS } from "../consts";
const { gtm, ga4, googleTag, clarity } = ANALYTICS;
---
<script is:inline define:vars={{ gtm, ga4, googleTag, clarity }}>
(function () {
  function loadAnalytics() {
    if (window.__analyticsLoaded) return;
    window.__analyticsLoaded = true;
    if (gtm) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      var s = document.createElement("script");
      s.async = true;
      s.src = "https://www.googletagmanager.com/gtm.js?id=" + gtm;
      document.head.appendChild(s);
    } else {
      var gtagId = googleTag || ga4;
      if (gtagId) {
        var gs = document.createElement("script");
        gs.async = true;
        gs.src = "https://www.googletagmanager.com/gtag/js?id=" + gtagId;
        document.head.appendChild(gs);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag("js", new Date());
        if (googleTag) window.gtag("config", googleTag);
        if (ga4) window.gtag("config", ga4);
      }
      if (clarity) {
        (function (c, l, a, r, i) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          var t = l.createElement(r); t.async = 1;
          t.src = "https://www.clarity.ms/tag/" + i;
          var y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", clarity);
      }
    }
  }
  window.__initAnalytics = loadAnalytics;
  try { var _c = localStorage.getItem("cookie-consent"); if (_c === "accepted" || _c === "not-required") loadAnalytics(); } catch (e) {}
})();
</script>
