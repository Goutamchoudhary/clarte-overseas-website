---
// Analytics loader — consent-gated.
// On first visit nothing fires; CookieBanner calls window.__initAnalytics() on accept.
// On return visits with stored consent, analytics fires immediately.
import { ANALYTICS } from "../consts";
const { gtm, ga4, googleTag, clarity, linkedinPartnerId } = ANALYTICS;
---
<script is:inline define:vars={{ gtm, ga4, googleTag, clarity, linkedinPartnerId }}>
(function () {
  function loadAnalytics() {
    if (window.__analyticsLoaded) return;
    window.__analyticsLoaded = true;
    if (gtm) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      var s = document.createElement("script");
      s.async = true;
      s.src = "https://www.googletagmanager.com/gtm.js?id=" + gtm;
      document.head.appendChild(s);
    } else {
      var gtagId = googleTag || ga4;
      if (gtagId) {
        var gs = document.createElement("script");
        gs.async = true;
        gs.src = "https://www.googletagmanager.com/gtag/js?id=" + gtagId;
        document.head.appendChild(gs);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag("js", new Date());
        if (googleTag) window.gtag("config", googleTag);
        if (ga4) window.gtag("config", ga4);
      }
      if (clarity) {
        (function (c, l, a, r, i) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          var t = l.createElement(r); t.async = 1;
          t.src = "https://www.clarity.ms/tag/" + i;
          var y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", clarity);
      }
    }
    // LinkedIn Insight Tag — fires alongside GTM/GA4 after consent
    if (linkedinPartnerId) {
      window._linkedin_partner_id = linkedinPartnerId;
      window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
      window._linkedin_data_partner_ids.push(linkedinPartnerId);
      if (!window.lintrk) {
        window.lintrk = function (a, b) { window.lintrk.q.push([a, b]); };
        window.lintrk.q = [];
      }
      var li = document.createElement("script");
      li.type = "text/javascript"; li.async = true;
      li.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
      document.head.appendChild(li);
    }
  }
  window.__initAnalytics = loadAnalytics;
  // Defer to idle time (falling back to a short timeout on browsers without
  // requestIdleCallback, e.g. Safari) instead of firing the instant this
  // script runs. GTM's container loads several tags of its own (GA4,
  // Clarity, etc.) once gtm.js executes, and having all of that compete
  // with the page's own GSAP/ScrollTrigger init for the main thread at the
  // exact same moment shows up as extra Total Blocking Time — this doesn't
  // reduce the work, just lets the critical rendering path go first.
  function schedule(fn) {
    if (window.requestIdleCallback) window.requestIdleCallback(fn, { timeout: 2000 });
    else setTimeout(fn, 1500);
  }
  try {
    var _c = localStorage.getItem("cookie-consent");
    if (_c === "accepted" || _c === "not-required") schedule(loadAnalytics);
  } catch (e) {}
})();
</script>
