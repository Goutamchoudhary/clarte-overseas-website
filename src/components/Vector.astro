---
// Inline SVG from the vector kit (docs/design/vector-kit/<name>.svg). Inline so
// its loop animation classes (vl-*, vk-*) work; each instance gets a unique
// clip-path id so a vector can appear more than once on a page.
interface Props {
  name: string;
  /** Rendered width in px (height follows the artwork). Omit to fill the parent. */
  size?: number;
  class?: string;
}
const files = import.meta.glob("/docs/design/vector-kit/*.svg", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const { name, size, class: cls = "" } = Astro.props;
const raw = files[`/docs/design/vector-kit/${name}.svg`];
if (!raw) throw new Error(`Unknown vector: ${name}`);
const viewBox = /viewBox="([^"]+)"/.exec(raw)?.[1] ?? "0 0 200 200";
const uid = `v${Math.random().toString(36).slice(2, 8)}`;
const body = raw
  .replace(/<svg[^>]*>/, "")
  .replace(/<\/svg>\s*$/, "")
  .replace(/<!--[\s\S]*?-->/g, "")
  .replace(/vlsv/g, `vlsv${uid}`);
const style = size ? `width:${size}px` : "width:100%";
---
<svg class={`vec ${cls}`} viewBox={viewBox} aria-hidden="true" style={style} set:html={body} />
