---
// Shared site navigation (sticky full-width white bar). Links without a built
// page yet use data-nolink (no navigation); see /js/script.js.
import { LANGUAGES } from "../consts";
import { categories } from "../data/products";
const path = (Astro.url.pathname.replace(/\/+$/, "") || "/");
const isHome = path === "/";
const isAbout = path === "/about";
const isBlog = path === "/blogs" || path.startsWith("/blogs/");
const isCert = path === "/certifications";
const isExport = path === "/how-we-export";
---
<header id="navbar" class="nav-bar sticky top-0 z-50 w-full">
    <nav class="max-w-7xl mx-auto px-5 lg:px-10 flex items-center justify-between gap-4 py-3">
      <!-- Logo (larger) -->
      <a href="/" class="flex items-center shrink-0 relative -left-6 lg:-left-[35px]" aria-label="Clarté Overseas home">
        <img src="/assets/logo/logo-horizontal.svg" alt="Clarté Overseas" class="h-12 lg:h-14 w-auto" />
      </a>

      <!-- Desktop links (non-navigating placeholders) -->
      <div class="hidden lg:flex items-center gap-7">
        <a href="/" class={`nav-link text-[15px] ${isHome ? "active" : ""}`}><span data-i18n="nav.home">Home</span></a>
        <div class="nav-dd">
          <a href="/products" class={`nav-link text-[15px] inline-flex items-center gap-1 ${path.startsWith("/products") ? "active" : ""}`}><span data-i18n="nav.products">Products</span>
            <svg class="w-3.5 h-3.5 nav-dd-caret" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
          </a>
          <div class="nav-dd-menu">
            <div class="nav-dd-card">
              {categories.map((c) => (
                <a href={`/products/${c.slug}`} class="nav-dd-item" data-i18n={`products.cat_${c.slug.replace(/-/g,'_')}_name`}>{c.name}</a>
              ))}
            </div>
          </div>
        </div>
        <a href="/how-we-export" class={`nav-link text-[15px] ${isExport ? "active" : ""}`}><span data-i18n="nav.how_we_export">How We Export</span></a>
        <a href="/certifications" class={`nav-link text-[15px] ${isCert ? "active" : ""}`}><span data-i18n="nav.certifications">Certifications</span></a>
        <a href="/about" class={`nav-link text-[15px] ${isAbout ? "active" : ""}`}><span data-i18n="nav.about">About Us</span></a>
        <a href="/blogs" class={`nav-link text-[15px] ${isBlog ? "active" : ""}`}><span data-i18n="nav.blogs">Blogs</span></a>
      </div>

      <!-- Right actions -->
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="lang-dd hidden sm:block" translate="no">
          <button class="lang-chip" id="langBtn" aria-label="Select language" aria-haspopup="true">
            <span id="langFlag" class="lang-chip-flag hidden text-base leading-none">🌐</span>
            <svg id="langGlobe" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
            <span id="langLabel">EN</span>
            <svg class="caret w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="lang-dd-menu">
            <div class="lang-dd-card">
              {LANGUAGES.map((l) => (
                <button class="lang-dd-item" type="button" data-lang={l.code} data-short={l.short}>
                  <span class="lang-flag">{l.flag}</span>{l.label}
                </button>
              ))}
            </div>
          </div>
        </div>
        <span class="nav-sep hidden sm:block"></span>
        <a href="#" data-wa class="wa-chip hidden sm:flex" aria-label="Chat or call on WhatsApp">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413z"/></svg>
        </a>
        <a href="/contact" class="btn-quote"><span data-i18n="nav.contact">Contact Us</span>
          <svg class="qarrow w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>

        <!-- Mobile hamburger -->
        <button id="menuBtn" class="lg:hidden w-10 h-10 flex items-center justify-center rounded-full text-navy hover:bg-slate-100 transition" aria-label="Open menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </nav>
  </header>

  <!-- Mobile menu -->
  <div id="mobileMenu" class="mobile-menu hidden-menu fixed inset-0 z-[55] bg-navy/95 backdrop-blur-md lg:hidden">
    <div class="flex justify-between items-center px-6 pt-6">
      <img src="/assets/logo/logo-horizontal-white.svg" alt="Clarté Overseas" class="h-9 w-auto" />
      <button id="menuClose" class="w-10 h-10 flex items-center justify-center rounded-full text-white hover:bg-white/10" aria-label="Close menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <nav class="flex flex-col items-center justify-center gap-7 h-[80%] text-white font-head text-2xl">
      <a href="/" class="mobile-link"><span data-i18n="nav.home">Home</span></a>
      <a href="/products" class="mobile-link"><span data-i18n="nav.products">Products</span></a>
      <div class="flex flex-col items-center gap-2.5 -mt-3 mb-1 px-6 text-center">
        {categories.map((c) => (
          <a href={`/products/${c.slug}`} class="mobile-sub" data-i18n={`products.cat_${c.slug.replace(/-/g,'_')}_name`}>{c.name}</a>
        ))}
      </div>
      <a href="/how-we-export" class="mobile-link"><span data-i18n="nav.how_we_export">How We Export</span></a>
      <a href="/certifications" class="mobile-link"><span data-i18n="nav.certifications">Certifications</span></a>
      <a href="/about" class="mobile-link"><span data-i18n="nav.about">About Us</span></a>
      <a href="/blogs" class="mobile-link"><span data-i18n="nav.blogs">Blogs</span></a>
      <select id="langSelect" class="lang-select" translate="no" aria-label="Select language">
        {LANGUAGES.map((l) => <option value={l.code}>{l.flag}  {l.label}</option>)}
      </select>
      <a href="/contact" class="btn btn-primary mt-2"><span data-i18n="nav.contact">Contact Us</span></a>
    </nav>
  </div>
