---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { CONTACT, SOCIAL } from "../consts";
import { categories as catData, products } from "../data/products";

const title = "Contact Clarté Overseas — Request a Quote | Dehydrated Food Exporter";
const description =
  "Get in touch with Clarté Overseas for quotes, samples and sourcing enquiries on dehydrated fruits, vegetables and powders. Based in New Delhi, shipping worldwide.";

const phoneWa = "(+91) 98189 15310";
const phoneWaHref = "tel:+919818915310";
const phoneAlt = "(+91) 8800242156";
const phoneAltHref = "tel:+918800242156";

const categories = [...catData.map((c) => c.name), "Something else / Not sure yet"];
// Products grouped by category for the optgroup select
const productGroups = catData.map((c) => ({
  label: c.name,
  items: products.filter((p) => p.category === c.slug).map((p) => p.name),
}));

// Google Maps embed (no API key needed) + share link for directions
const mapQuery = encodeURIComponent(CONTACT.address);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&z=15&output=embed`;
const mapLink = "https://maps.app.goo.gl/SVvjHRfum4CHLrJV8";
---

<BaseLayout title={title} description={description}>
  <!-- ===================== HERO ===================== -->
  <PageHero
    i18nPrefix="contact"
    i18nCrumb="nav.contact"
    crumb="Contact"
    eyebrow="Get in Touch"
    watermark="Contact"
    heading="Let's get your order moving"
    subtitle="Tell us the product, the form and your market. We'll come back with specifications, samples where useful, and a quote in your currency — usually within one business day."
    chips={["Replies within 1 business day", "Samples on request", "Quotes in your currency"]}
  />

  <!-- ===================== CONTACT CARD ===================== -->
  <section class="pb-20 lg:pb-24 -mt-4">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="contact-card reveal">
        <!-- Info panel -->
        <div class="cc-info">
          <span class="cc-glow" aria-hidden="true"></span>
          <span class="bp-plus cc-plus" style="top:14%;right:10%"></span>
          <span class="bp-plus cc-plus" style="bottom:30%;right:24%"></span>
          <h2 class="cc-info-h"><span data-i18n="contact.talk_heading">Talk to a real person</span></h2>
          <p class="cc-info-sub"><span data-i18n="contact.talk_sub">Reach us however suits you. We read every message and reply quickly — no call centres, no run-around.</span></p>

          <div class="cc-info-item">
            <span class="cc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
            <div>
              <span class="cc-label"><span data-i18n="contact.info_office">Office &amp; dispatch</span></span>
              <span class="cc-value">{CONTACT.address}</span>
            </div>
          </div>

          <div class="cc-info-item">
            <span class="cc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
            <div>
              <span class="cc-label"><span data-i18n="contact.info_email_label">Email</span></span>
              <span class="cc-value"><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></span>
            </div>
          </div>

          <div class="cc-info-item">
            <span class="cc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
            <div>
              <span class="cc-label"><span data-i18n="contact.info_phone_label">Phone &amp; WhatsApp</span></span>
              <span class="cc-value cc-value-phones">
                <a href={phoneWaHref}>{phoneWa} <span class="cc-wa-badge">WhatsApp</span></a>
                <a href={phoneAltHref} class="cc-phone-alt">{phoneAlt}</a>
              </span>
            </div>
          </div>

          <div class="cc-info-item">
            <span class="cc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <div>
              <span class="cc-label"><span data-i18n="contact.info_hours_label">Availability</span></span>
              <span class="cc-value"><span data-i18n="contact.info_hours_val">Replies within one business day — often the same day.</span></span>
            </div>
          </div>

          <a href="#" data-wa data-wa-msg="Hi Clarté Overseas, I'd like to connect directly on WhatsApp. Can we talk?" class="cc-wa">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
            <span data-i18n="contact.talk_whatsapp">Chat on WhatsApp</span>
          </a>

          <div class="cc-social">
            <a href={SOCIAL.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a>
            <a href={SOCIAL.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
            <a href={SOCIAL.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg></a>
          </div>
        </div>

        <!-- Form panel -->
        <div class="cc-form">
          <h2 class="cc-form-h"><span data-i18n="contact.form_heading">Request a quote</span></h2>
          <p class="cc-form-sub" data-i18n-html="contact.form_sub">The more you tell us, the sharper the quote. Fields marked <span class="req">*</span> are required.</p>

          <form id="quoteForm" action="https://api.web3forms.com/submit" method="POST" class="cc-fields" data-sheet={CONTACT.sheetWebhook}>
            <!-- Web3Forms config -->
            <input type="hidden" name="access_key" value={CONTACT.web3formsKey} />
            <input type="hidden" name="subject" value="New quote request — Clarté Overseas website" />
            <input type="hidden" name="from_name" value="Clarté Overseas website" />
            <!-- Web3Forms built-in honeypot (bots tick it, humans never see it) -->
            <input type="checkbox" name="botcheck" class="cc-hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

            <div class="cc-row two">
              <div class="field">
                <label for="name"><span data-i18n="contact.form_name">Full name</span> <span class="req">*</span></label>
                <input id="name" name="name" type="text" required placeholder="Your name" data-i18n-ph="contact.form_name" />
              </div>
              <div class="field">
                <label for="company"><span data-i18n="contact.form_company">Company</span> <span class="req">*</span></label>
                <input id="company" name="company" type="text" required placeholder="Company name" data-i18n-ph="contact.form_company" />
              </div>
            </div>

            <div class="cc-row two">
              <div class="field">
                <label for="email"><span data-i18n="contact.form_email">Email</span> <span class="req">*</span></label>
                <input id="email" name="email" type="email" required placeholder="you@company.com" />
              </div>
              <div class="field">
                <label for="phone"><span data-i18n="contact.form_phone">Phone / WhatsApp</span></label>
                <input id="phone" name="phone" type="tel" placeholder="+1 555 000 0000" />
              </div>
            </div>

            <div class="cc-row two">
              <div class="field">
                <label for="country"><span data-i18n="contact.form_country">Destination country</span> <span class="req">*</span></label>
                <input id="country" name="country" type="text" required placeholder="Where it's headed" data-i18n-ph="contact.form_country" />
              </div>
              <div class="field">
                <label for="quantity"><span data-i18n="contact.form_qty">Estimated quantity</span></label>
                <input id="quantity" name="quantity" type="text" placeholder="e.g. 5 MT / month" />
              </div>
            </div>

            <div class="cc-row two">
              <div class="field">
                <label for="category"><span data-i18n="contact.form_category">Product category</span></label>
                <select id="category" name="category">
                  <option value="" selected>Select a category</option>
                  {categories.map((c) => <option value={c}>{c}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="product"><span data-i18n="contact.form_product">Specific product</span></label>
                <select id="product" name="product">
                  <option value="" selected>Any / not sure yet</option>
                  {productGroups.map((g) => (
                    <optgroup label={g.label}>
                      {g.items.map((name) => <option value={name}>{name}</option>)}
                    </optgroup>
                  ))}
                </select>
              </div>
            </div>

            <div class="field">
              <label for="message"><span data-i18n="contact.form_requirement">Your requirement</span> <span class="req">*</span></label>
              <textarea id="message" name="message" required placeholder="Tell us the product, grade/mesh, packing, target price or any spec sheet you're working to." data-i18n-ph="contact.form_requirement"></textarea>
            </div>

            {CONTACT.turnstileSiteKey && (
              <div class="cf-turnstile mb-4" data-sitekey={CONTACT.turnstileSiteKey} data-theme="light"></div>
            )}

            <button type="submit" class="cc-submit">
              <span data-i18n="contact.form_submit">Send enquiry</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
            <p class="cc-note" data-i18n="contact.form_note">We'll only use your details to reply to this enquiry. No spam, ever.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== MAP (detached, framed) ===================== -->
  <section class="contact-map blueprint">
    <span class="bp-plus" style="top:12%;left:7%"></span>
    <span class="bp-plus" style="bottom:22%;right:8%"></span>
    <span class="bp-plus" style="top:24%;right:16%"></span>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative">
      <div class="map-head reveal">
        <span class="eyebrow center" data-i18n="contact.map_eyebrow">Find Us</span>
        <h2 class="tg-6 font-extrabold text-3xl sm:text-4xl mt-4" data-i18n="contact.map_heading">New Delhi, India — where it all ships from</h2>
        <p class="text-slate-500 text-lg mt-4" data-i18n="contact.map_sub">Working from the capital keeps documentation, freight and coordination moving without friction.</p>
      </div>
      <div class="map-shell reveal d1">
        <span class="map-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <span data-i18n="contact.map_badge">New Delhi, India</span>
        </span>
        <div class="map-inner">
          <iframe
            class="map-frame"
            src={mapEmbed}
            title="Clarté Overseas location on Google Maps"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <div class="map-card">
            <span class="cc-label" style="color:#1f4693">Our address</span>
            <p class="map-addr">{CONTACT.address}</p>
            <a href={mapLink} target="_blank" rel="noopener" class="map-dir">
              <span data-i18n="contact.map_directions">Get directions</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SUCCESS DIALOG ===================== -->
  <div class="cc-modal" id="ccModal" hidden>
    <div class="cc-modal-card" role="dialog" aria-modal="true" aria-labelledby="ccModalTitle">
      <button type="button" class="cc-modal-x" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      <span class="cc-modal-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
      </span>
      <h3 id="ccModalTitle" class="cc-modal-title"><span data-i18n="contact.success_heading">Message sent — thank you!</span></h3>
      <p class="cc-modal-text"><span data-i18n="contact.success_body">We've received your enquiry and will get back to you within one business day, usually sooner.</span></p>
      <button type="button" class="cc-modal-btn" data-close><span data-i18n="contact.success_close">Done</span></button>
    </div>
  </div>

  {CONTACT.turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}
</BaseLayout>

<style is:global>
  /* ====================== CONTACT PAGE ====================== */
  .contact-card {
    display: grid; grid-template-columns: 1fr; overflow: hidden;
    border-radius: 1.6rem; background: #fff; border: 1px solid #e7edf7;
    box-shadow: 0 36px 80px -44px rgba(31,70,147,.5);
  }
  @media (min-width: 940px) { .contact-card { grid-template-columns: 2fr 3fr; } }

  /* Info panel */
  .cc-info {
    position: relative; overflow: hidden; color: #fff;
    padding: 2.6rem 2.2rem; display: flex; flex-direction: column;
    background: linear-gradient(160deg, #16265a 0%, #1f4693 60%, #16306e 100%);
  }
  .cc-glow {
    position: absolute; width: 320px; height: 320px; right: -120px; top: -120px; pointer-events: none;
    background: radial-gradient(circle, rgba(214,179,106,.30), transparent 62%);
  }
  .cc-plus { position: absolute; }
  .cc-plus::before, .cc-plus::after { background: rgba(255,255,255,.22); }
  .cc-info-h { font-family: "Sora", sans-serif; font-weight: 800; font-size: 1.5rem; position: relative; }
  .cc-info-sub { color: #c7d5f1; font-size: .95rem; line-height: 1.6; margin-top: .7rem; position: relative; }
  .cc-info-item { display: flex; gap: .9rem; align-items: flex-start; margin-top: 1.5rem; position: relative; }
  .cc-ico { flex: none; width: 42px; height: 42px; border-radius: 11px; background: rgba(255,255,255,.12); display: grid; place-items: center; color: #cfe0ff; }
  .cc-ico svg { width: 20px; height: 20px; }
  .cc-label { display: block; font: 700 .68rem "Sora", sans-serif; letter-spacing: .08em; text-transform: uppercase; color: #9db4e6; }
  .cc-value { display: block; color: #eaf0fb; font-size: .95rem; margin-top: .2rem; line-height: 1.5; }
  .cc-value a:hover { text-decoration: underline; }
  .cc-wa {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem; margin-top: 1.8rem;
    font: 600 .9rem "Sora", sans-serif; color: #fff; background: #25d366; border-radius: 999px; padding: .7rem 1.2rem;
    box-shadow: 0 12px 26px -12px rgba(37,211,102,.7); transition: transform .2s ease, box-shadow .25s ease; position: relative;
  }
  .cc-wa:hover { transform: translateY(-2px); box-shadow: 0 18px 32px -12px rgba(37,211,102,.8); }
  .cc-social { display: flex; gap: .6rem; margin-top: auto; padding-top: 2rem; position: relative; }
  .cc-social a { width: 40px; height: 40px; border-radius: 10px; background: rgba(255,255,255,.1); display: grid; place-items: center; color: #fff; transition: transform .2s ease, background .2s ease, color .2s ease; }
  .cc-social a:hover { background: #fff; color: #1f4693; transform: translateY(-2px); }

  /* Form panel */
  .cc-form { padding: 2.6rem 2.2rem; }
  @media (min-width: 940px) { .cc-form { padding: 2.8rem 2.6rem; } }
  .cc-form-h { font-family: "Sora", sans-serif; font-weight: 800; font-size: 1.5rem; color: #16265a; }
  .cc-form-sub { color: #64708a; font-size: .92rem; margin-top: .4rem; }
  .req { color: #d6553a; }
  .cc-fields { margin-top: 1.5rem; }
  .cc-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .cc-row { display: grid; gap: 1rem; }
  @media (min-width: 560px) { .cc-row.two { grid-template-columns: 1fr 1fr; } }
  .field { margin-bottom: 1.05rem; }
  .field label { display: block; font: 600 .8rem "Sora", sans-serif; color: #3a4a68; margin-bottom: .4rem; }
  .cc-form input, .cc-form select, .cc-form textarea {
    width: 100%; font: 400 .95rem "Inter", sans-serif; color: #16265a; background: #f7f9fd;
    border: 1px solid #e2e9f5; border-radius: .7rem; padding: .75rem .9rem;
    transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
  }
  .cc-form input::placeholder, .cc-form textarea::placeholder { color: #9aa6bd; }
  .cc-form input:focus, .cc-form select:focus, .cc-form textarea:focus {
    outline: none; border-color: #1f4693; background: #fff; box-shadow: 0 0 0 3px rgba(31,70,147,.12);
  }
  .cc-form textarea { min-height: 130px; resize: vertical; }
  .cc-submit {
    display: inline-flex; align-items: center; gap: .5rem; margin-top: .4rem;
    font: 600 .98rem "Sora", sans-serif; color: #fff; border: none; cursor: pointer;
    background: linear-gradient(135deg, #2b57b0, #1f4693); border-radius: .8rem; padding: .9rem 1.6rem;
    box-shadow: 0 14px 30px -12px rgba(31,70,147,.7); transition: transform .2s ease, box-shadow .25s ease;
  }
  .cc-submit svg { width: 18px; height: 18px; transition: transform .2s ease; }
  .cc-submit:hover { transform: translateY(-2px); box-shadow: 0 20px 36px -12px rgba(31,70,147,.85); }
  .cc-submit:hover svg { transform: translateX(4px); }
  .cc-note { color: #94a0b7; font-size: .8rem; margin-top: .9rem; }

  /* Map — detached + framed */
  .contact-map { position: relative; padding: 2.75rem 0 5rem; }
  @media (min-width: 1024px) { .contact-map { padding: 3.5rem 0 7rem; } }
  .map-head { text-align: center; max-width: 44rem; margin: 0 auto 2.6rem; }
  .map-shell {
    position: relative; border-radius: 1.8rem; padding: 9px;
    background: linear-gradient(135deg, rgba(31,70,147,.32), rgba(214,179,106,.32));
    box-shadow: 0 46px 92px -50px rgba(31,70,147,.6);
  }
  .map-inner { position: relative; border-radius: 1.35rem; overflow: hidden; background: #fff; }
  .map-frame { width: 100%; height: 460px; border: 0; display: block; }
  .map-badge {
    position: absolute; top: -17px; left: 50%; transform: translateX(-50%); z-index: 4;
    display: inline-flex; align-items: center; gap: .45rem; white-space: nowrap;
    font: 700 .82rem "Sora", sans-serif; color: #fff;
    background: linear-gradient(135deg, #2b57b0, #1f4693); padding: .55rem 1.15rem; border-radius: 999px;
    box-shadow: 0 14px 28px -10px rgba(31,70,147,.75);
  }
  .map-badge svg { width: 16px; height: 16px; }
  .map-card {
    position: absolute; left: 1rem; right: 1rem; bottom: 1rem; z-index: 2;
    background: #fff; border: 1px solid #e7edf7; border-radius: 1rem; padding: 1.3rem 1.4rem;
    box-shadow: 0 26px 56px -30px rgba(31,70,147,.5);
  }
  .map-addr { color: #44516b; font-size: .95rem; line-height: 1.55; margin-top: .35rem; max-width: 22rem; }
  .map-dir {
    display: inline-flex; align-items: center; gap: .45rem; margin-top: .9rem;
    font: 600 .88rem "Sora", sans-serif; color: #1f4693;
  }
  .map-dir svg { width: 16px; height: 16px; transition: transform .2s ease; }
  .map-dir:hover svg { transform: translateX(4px); }
  @media (min-width: 768px) {
    .map-card { right: auto; left: 1.75rem; bottom: 1.75rem; max-width: 24rem; }
  }

  .cc-submit[disabled] { opacity: .65; cursor: progress; }

  /* Success dialog */
  .cc-modal {
    position: fixed; inset: 0; z-index: 120; display: grid; place-items: center; padding: 1.5rem;
    background: rgba(15,26,54,.55); backdrop-filter: blur(4px); animation: cc-fade .25s ease;
  }
  .cc-modal[hidden] { display: none; }
  .cc-modal-card {
    position: relative; width: 100%; max-width: 24rem; text-align: center;
    background: #fff; border-radius: 1.4rem; padding: 2.4rem 1.8rem 2rem;
    box-shadow: 0 40px 90px -30px rgba(15,26,54,.6); animation: cc-pop .35s cubic-bezier(.34,1.56,.64,1);
  }
  .cc-modal-x {
    position: absolute; top: .9rem; right: .9rem; width: 34px; height: 34px; border: none; cursor: pointer;
    border-radius: 50%; background: #f1f5fc; color: #64708a; display: grid; place-items: center; transition: background .2s ease, color .2s ease;
  }
  .cc-modal-x svg { width: 16px; height: 16px; }
  .cc-modal-x:hover { background: #e2e9f5; color: #1f4693; }
  .cc-modal-ico {
    width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; margin: 0 auto;
    color: #fff; background: linear-gradient(150deg, #18a86f, #0f7a52); box-shadow: 0 14px 28px -10px rgba(15,122,82,.6);
  }
  .cc-modal-ico svg { width: 30px; height: 30px; }
  .cc-modal-title { font-family: "Sora", sans-serif; font-weight: 800; font-size: 1.25rem; color: #16265a; margin-top: 1.1rem; }
  .cc-modal-text { color: #54627d; font-size: .95rem; line-height: 1.6; margin-top: .5rem; }
  .cc-modal-btn {
    margin-top: 1.5rem; font: 600 .95rem "Sora", sans-serif; color: #fff; border: none; cursor: pointer;
    background: linear-gradient(135deg, #2b57b0, #1f4693); border-radius: .8rem; padding: .75rem 1.8rem;
    box-shadow: 0 14px 30px -12px rgba(31,70,147,.7); transition: transform .2s ease;
  }
  .cc-modal-btn:hover { transform: translateY(-2px); }
  @keyframes cc-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes cc-pop { from { opacity: 0; transform: translateY(14px) scale(.96); } to { opacity: 1; transform: none; } }
</style>

<script>
  // Pre-fill category/product from URL params (e.g. /contact?category=...&product=...)
  (function () {
    const params = new URLSearchParams(location.search);
    const setSelect = (id, val) => {
      if (!val) return;
      const sel = document.getElementById(id) as HTMLSelectElement | null;
      if (!sel) return;
      const match = Array.from(sel.options).find(
        (o) => o.value.toLowerCase() === val.toLowerCase()
      );
      if (match) sel.value = match.value;
    };
    setSelect("category", params.get("category"));
    setSelect("product", params.get("product"));
  })();

  const form = document.getElementById("quoteForm") as HTMLFormElement | null;
  const modal = document.getElementById("ccModal");
  if (form && modal) {
    const btn = form.querySelector(".cc-submit") as HTMLButtonElement;
    const openModal = () => { modal.hidden = false; document.body.style.overflow = "hidden"; };
    const closeModal = () => { modal.hidden = true; document.body.style.overflow = ""; };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const original = btn ? btn.innerHTML : "";
      if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
      const fd = new FormData(form);
      // Also save the lead to a Google Sheet (+ WhatsApp alert) if configured — fire & forget
      const sheetUrl = form.dataset.sheet;
      if (sheetUrl) {
        fetch(sheetUrl, { method: "POST", body: fd, mode: "no-cors" }).catch(() => {});
      }
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: fd,
          headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(() => null);
        if (res.ok && data && data.success) {
          form.reset();
          openModal();
        } else {
          alert((data && data.message) || "Something went wrong. Please email us at info@clarteoverseas.com.");
        }
      } catch {
        alert("Network error — please try again, or email us at info@clarteoverseas.com.");
      } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = original; }
      }
    });

    modal.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t === modal || t.closest("[data-close]")) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.hidden) closeModal();
    });
  }
</script>
