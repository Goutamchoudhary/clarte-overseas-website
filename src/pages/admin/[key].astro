---
// Site admin: /admin/<ADMIN_URL_KEY>. Server-rendered on every request.
// Sign-in = a 6-digit Google Authenticator code (TOTP). See
// docs/handoff/admin.md for the security model and setup.
//
// Deliberately NOT built on BaseLayout: that pulls in GTM/analytics, which
// would send this page's URL (and its secret key) to third parties.
import crypto from "node:crypto";
import { adminEnv, missingAdminEnv } from "../../lib/admin/env";
import { verifyTotp } from "../../lib/admin/totp";
import { SESSION_COOKIE, createSession, verifySession, sessionCookieOptions } from "../../lib/admin/session";
import { isLocked, recordFailure, clearFailures, claimTotpStep, LOCK_SECONDS } from "../../lib/admin/store";
import { readConfigAt, writeConfig, configHistory, type HistoryItem } from "../../lib/admin/github";
import { GROUPS, normalizeConfig, siteConfig, type SiteConfig } from "../../data/site-options";

export const prerender = false;

const SECURITY_HEADERS: Record<string, string> = {
  "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet",
  "Cache-Control": "no-store, max-age=0",
  "Referrer-Policy": "no-referrer",
  "X-Frame-Options": "DENY",
  "X-Content-Type-Options": "nosniff",
  "Content-Security-Policy": "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
};
const notFound = () => new Response("Not found", { status: 404, headers: { ...SECURITY_HEADERS, "Content-Type": "text/plain" } });

// ---- 1. Secret URL key: anything else is a plain 404 ------------------------
const want = adminEnv.urlKey();
const got = Astro.params.key ?? "";
const keyOk = want.length >= 24 && got.length === want.length &&
  crypto.timingSafeEqual(Buffer.from(got), Buffer.from(want));
if (!keyOk) return notFound();

for (const [k, v] of Object.entries(SECURITY_HEADERS)) Astro.response.headers.set(k, v);

const self = Astro.url.pathname;
const missing = missingAdminEnv();
let error = "";
const FLASH: Record<string, string> = {
  published: "Published. The live site rebuilds in about 2 minutes.",
  reverted: "Reverted. The live site rebuilds in about 2 minutes.",
  out: "Signed out.",
};
const flash = FLASH[Astro.url.searchParams.get("m") ?? ""] ?? "";

let authed = verifySession(Astro.cookies.get(SESSION_COOKIE)?.value);

// ---- 2. Form posts (same-origin only) --------------------------------------
if (Astro.request.method === "POST") {
  const origin = Astro.request.headers.get("origin");
  const site = Astro.request.headers.get("sec-fetch-site");
  const sameOrigin = origin ? origin === Astro.url.origin : site === "same-origin" || site === "none";
  if (!sameOrigin) return new Response("Forbidden", { status: 403, headers: SECURITY_HEADERS });

  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");

  if (missing.length) {
    error = "The admin isn't fully configured yet (see below).";
  } else if (action === "login" && !authed) {
    try {
      if (await isLocked()) {
        error = `Too many wrong codes. Sign-in is locked for ${LOCK_SECONDS / 60} minutes.`;
      } else {
        const step = verifyTotp(adminEnv.totpSecret(), String(form.get("code") ?? ""));
        if (step !== null && (await claimTotpStep(step))) {
          await clearFailures();
          Astro.cookies.set(SESSION_COOKIE, createSession(), sessionCookieOptions);
          return Astro.redirect(self, 303);
        }
        await recordFailure();
        await new Promise((r) => setTimeout(r, 600));
        error = "That code didn't work. Wait for the next code and try again.";
      }
    } catch {
      error = "Sign-in is unavailable right now (rate-limit store unreachable).";
    }
  } else if (action === "logout") {
    Astro.cookies.delete(SESSION_COOKIE, { path: "/" });
    return Astro.redirect(`${self}?m=out`, 303);
  } else if (authed && action === "publish") {
    const next = normalizeConfig(Object.fromEntries(GROUPS.map((g) => [g.key, String(form.get(g.key) ?? "")])));
    try {
      await writeConfig(next, `Admin: hero=${next.hero} theme=${next.theme} edition=${next.edition} cta=${next.cta}`);
      return Astro.redirect(`${self}?m=published`, 303);
    } catch { error = "Publishing failed (GitHub didn't accept the change). Nothing on the live site changed."; }
  } else if (authed && action === "revert") {
    const sha = String(form.get("sha") ?? "");
    if (!/^[0-9a-f]{40}$/.test(sha)) error = "Unknown version.";
    else try {
      const { json } = await readConfigAt(sha);
      await writeConfig(normalizeConfig(json), `Admin: revert site config to ${sha.slice(0, 7)}`);
      return Astro.redirect(`${self}?m=reverted`, 303);
    } catch { error = "Revert failed. Nothing on the live site changed."; }
  }
}

// ---- 3. Data for the signed-in view ----------------------------------------
let current: SiteConfig = siteConfig;
let history: HistoryItem[] = [];
let ghError = false;
if (authed && !missing.length) {
  try {
    current = normalizeConfig((await readConfigAt(adminEnv.githubBranch())).json);
    history = await configHistory(8);
  } catch { ghError = true; }
}
const summary = (c: SiteConfig) => GROUPS.map((g) => g.options.find((o) => o.id === c[g.key])?.label ?? c[g.key]).join(" · ");
const fmt = (d: string) => new Date(d).toLocaleString("en-GB", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Kolkata" });
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="referrer" content="no-referrer" />
  <title>Site admin</title>
  <style is:inline>
    :root{--ink:#15123a;--muted:#5b5780;--line:#e7e4f3;--accent:#6d28d9;--bg:#f6f5fb}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
    .wrap{max-width:1080px;margin:0 auto;padding:24px 16px 64px}
    .card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px}
    h1{font-size:22px;margin:0 0 4px}
    .muted{color:var(--muted);font-size:14px}
    .btn{display:inline-block;border:0;cursor:pointer;border-radius:999px;padding:13px 22px;font:600 15px system-ui,sans-serif;color:#fff;background:linear-gradient(135deg,#1f4693 0%,#6d28d9 55%,#be185d 100%)}
    .btn:focus-visible,.opt input:focus-visible+span,input:focus-visible{outline:3px solid #a78bfa;outline-offset:2px}
    .btn-line{background:#fff;color:#3b2a7a;border:1px solid #ddd6fe}
    .msg{padding:12px 16px;border-radius:12px;margin:0 0 16px;font-size:14px}
    .ok{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}
    .err{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
    .login{max-width:400px;margin:12vh auto 0;display:flex;flex-direction:column;gap:16px}
    label.code{display:flex;flex-direction:column;gap:6px;font-size:14px;color:var(--muted)}
    label.code input{padding:13px 14px;border-radius:12px;border:1px solid #ddd6fe;font:600 24px ui-monospace,monospace;letter-spacing:.3em;text-align:center}
    header.top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px}
    .grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:20px}
    @media (max-width:860px){.grid{grid-template-columns:1fr}}
    fieldset{border:1px solid var(--line);border-radius:18px;background:#fff;padding:16px 18px;margin:0 0 16px}
    legend{font-weight:700;padding:0 6px}
    .opts{display:flex;flex-wrap:wrap;gap:10px;margin-top:6px}
    .opt{position:relative}
    .opt input{position:absolute;opacity:0;width:1px;height:1px}
    .opt span{display:flex;flex-direction:column;gap:2px;min-height:44px;padding:10px 14px;border-radius:12px;border:1px solid #e4defa;background:#fff;cursor:pointer;max-width:260px}
    .opt span small{color:var(--muted);font-size:12px}
    .opt input:checked+span{border:2px solid var(--accent);background:#f5f3ff}
    .opt input:disabled+span{opacity:.5;cursor:not-allowed}
    .tag{font-size:11px;font-weight:600;color:#9a3412}
    aside .card{display:flex;flex-direction:column;gap:12px;position:sticky;top:16px}
    ul.hist{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
    ul.hist li{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:13px;border-top:1px solid #f0eef8;padding-top:8px}
    ul.hist button{background:none;border:1px solid #ddd6fe;border-radius:999px;padding:6px 10px;color:#3b2a7a;cursor:pointer;font-size:12px}
    code{font-size:13px}
  </style>
</head>
<body>
  <main class="wrap">
    {flash && <p class="msg ok" role="status">{flash}</p>}
    {error && <p class="msg err" role="alert">{error}</p>}
    {missing.length > 0 && (
      <div class="msg err" role="alert">Missing environment variables: <code>{missing.join(", ")}</code>. Add them in Vercel → Settings → Environment Variables and redeploy.</div>
    )}

    {!authed ? (
      <form method="post" class="card login" autocomplete="off">
        <h1>Site admin</h1>
        <label class="code">6-digit code from Google Authenticator
          <input name="code" inputmode="numeric" pattern="[0-9 ]{6,7}" maxlength="7" autocomplete="one-time-code" required autofocus />
        </label>
        <input type="hidden" name="action" value="login" />
        <button class="btn" type="submit">Sign in</button>
        <span class="muted">5 wrong codes lock sign-in for 15 minutes. You stay signed in for 8 hours.</span>
      </form>
    ) : (
      <>
        <header class="top">
          <div><h1>Site configuration</h1><span class="muted">Live now: {summary(current)}</span></div>
          <form method="post"><input type="hidden" name="action" value="logout" /><button class="btn btn-line" type="submit">Sign out</button></form>
        </header>
        {ghError && <p class="msg err">Couldn't read the live config from GitHub — showing the deployed one. Check ADMIN_GITHUB_TOKEN.</p>}
        <div class="grid">
          <form method="post" id="cfg">
            <input type="hidden" name="action" value="publish" />
            {GROUPS.map((g) => (
              <fieldset>
                <legend>{g.title}</legend>
                <div class="opts">
                  {g.options.map((o) => (
                    <label class="opt">
                      <input type="radio" name={g.key} value={o.id} checked={current[g.key] === o.id} disabled={!o.ready} />
                      <span><strong>{o.label}</strong><small>{o.note}</small>{!o.ready && <small class="tag">In progress — not publishable yet</small>}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
          </form>
          <aside>
            <div class="card">
              <strong>Publish</strong>
              <span class="muted">Saves your choices to the site's GitHub repo; Vercel rebuilds and the live site updates in about 2 minutes.</span>
              <button class="btn" type="submit" form="cfg">Publish to live site</button>
              <strong style="margin-top:8px">History</strong>
              {history.length === 0 ? <span class="muted">No published changes yet.</span> : (
                <ul class="hist">
                  {history.map((h, i) => (
                    <li>
                      <span><span>{h.message}</span><br /><span class="muted">{fmt(h.date)}</span></span>
                      {i > 0 && (
                        <form method="post"><input type="hidden" name="action" value="revert" /><input type="hidden" name="sha" value={h.sha} /><button type="submit">Revert to this</button></form>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </aside>
        </div>
      </>
    )}
  </main>
</body>
</html>
