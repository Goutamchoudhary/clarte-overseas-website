---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import WaveDivider from "../components/WaveDivider.astro";
import CurveDivider from "../components/CurveDivider.astro";
import Testimonials from "../components/Testimonials.astro";
import { CONTACT } from "../consts";

const title = "About Clarté Overseas — Dehydrated Food Ingredient Exporter from India";
const description =
  "Clarté Overseas is a New Delhi based merchant exporter of dehydrated fruits, vegetables and food-grade ingredients, helping food brands and manufacturers worldwide source dependably from India.";

const services = [
  "Source dehydrated fruits and vegetables in flake and powder form",
  "Supply herbal, leaf, culinary, functional and fruit powders, plus hydrocolloids and additives",
  "Vet and coordinate trusted manufacturers and processors across India",
  "Run quality control and lab testing on every lot",
  "Handle export documentation and compliance end to end",
  "Offer flexible packaging, private label and made-to-spec grades",
  "Manage freight and on-time delivery to your port",
];

const values = [
  { t: "Consistent quality", d: "The same spec, batch after batch, so your line never has to adjust.", paths: ["M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z", "m9 12 2 2 4-4"] },
  { t: "Regulatory compliance", d: "Documentation and standards matched to each market you sell into.", paths: ["M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"] },
  { t: "Transparent process", d: "Clear pricing, clear timelines, and updates you do not have to ask for.", paths: ["M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z", "M12 9a3 3 0 100 6 3 3 0 000-6z"] },
  { t: "Customer-centric", d: "We build the grade, form and pack around your recipe, not ours.", paths: ["M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2", "M9 11a4 4 0 100-8 4 4 0 000 8z", "M22 21v-2a4 4 0 0 0-3-3.87", "M16 3.13a4 4 0 0 1 0 7.75"] },
  { t: "Dependable supply", d: "A vetted network and planning that keeps repeat orders steady.", paths: ["M3 7h11v8H3z", "M14 10h4l3 3v2h-7z", "M7 19a2 2 0 100-4 2 2 0 000 4z", "M18 19a2 2 0 100-4 2 2 0 000 4z"] },
  { t: "Long-term partnership", d: "We would rather grow with you than win a one-off order.", paths: ["M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"] },
];

const countries = [
  "United Kingdom","United States","Germany","France","Netherlands","Sweden",
  "Czech Republic","South Korea","Australia","New Zealand","United Arab Emirates",
  "Oman","South Africa","Sri Lanka","Russia",
];

const partners = [
  { t: "Importers & distributors", d: "Bulk supply with the paperwork and consistency your customers expect." },
  { t: "Agency & distributorship", d: "Represent our range in your market with dependable backing." },
  { t: "Contract manufacturing", d: "Made-to-spec grades and forms produced to your brief." },
  { t: "Private-label brands", d: "Your branding and packaging, our sourcing and quality control." },
  { t: "Business development", d: "Partners who can open doors to new buyers and regions." },
];

const aboutFaqs = [
  {
    q: "Where is Clarté Overseas based?",
    a: "We are based in New Delhi, India, and ship to buyers around the world. Working from a major trade and logistics hub keeps documentation, freight and coordination straightforward.",
  },
  {
    q: "Are you a manufacturer or an exporter?",
    a: "We are a merchant exporter. Rather than running a single factory, we work with a vetted network of manufacturers and processors across India, which lets us offer a wide range of grades and forms while keeping a close watch on quality and paperwork.",
  },
  {
    q: "How long have you been in business?",
    a: "Clarté Overseas was established in 2025. We are a young, focused company built specifically around making dehydrated-ingredient sourcing from India simple and dependable for overseas buyers.",
  },
  {
    q: "What makes you different from other exporters?",
    a: "Consolidated sourcing across several ingredient categories, quality control and lab testing on every lot, full batch traceability, transparent communication, and a genuine preference for long-term partnerships over one-off orders.",
  },
  {
    q: "Do you only work with large buyers?",
    a: "Not at all. We keep MOQs trial-friendly so smaller importers, manufacturers and private-label brands can start with a test order and scale as the relationship grows.",
  },
  {
    q: "What registrations and certifications do you hold?",
    a: "We are GST, IEC and RCMC registered, with FSSAI and ISO 9001 in place, and we provide complete export documentation with every shipment.",
  },
  {
    q: "How do we start working together?",
    a: "Tell us the product, the form and your target market through the quote form or WhatsApp. We will come back with specifications, samples where helpful, and a quote in your currency.",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- ===================== HERO ===================== -->
  <PageHero
    i18nPrefix="about"
    i18nCrumb="nav.about"
    crumb="About Us"
    eyebrow="About Us"
    watermark="About"
    heading="Bringing India's harvest to<br class='hidden sm:block'/> the world's food businesses"
    subtitle="Clarté Overseas is a New Delhi based merchant exporter of dehydrated fruits, vegetables and food-grade ingredients. We help food brands, manufacturers and distributors source from India without the usual friction."
    chips={["New Delhi, India", "Merchant exporter", "Shipping worldwide"]}
  />

  <!-- ===================== STORY + GLANCE ===================== -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-7 reveal">
        <span class="eyebrow"><span data-i18n="about.who_eyebrow">Who We Are</span></span>
        <h2 class="text-navy font-extrabold text-3xl sm:text-4xl mt-4 leading-tight"><span data-i18n="about.who_heading">Sourcing from India, made straightforward</span></h2>
        <div class="text-slate-600 leading-relaxed mt-6 space-y-5 text-[17px]">
          <p><span data-i18n="about.who_body1">We started Clarté Overseas in 2025 with one clear aim: make it easy for food businesses anywhere to buy dependable dehydrated ingredients from India. The country grows an extraordinary range of produce and botanicals, yet for an overseas buyer, finding a supplier who is consistent, compliant and genuinely easy to deal with is still surprisingly hard. Closing that gap is the whole reason we exist.</span></p>
          <p><span data-i18n="about.who_body2">We are a merchant exporter, not a single factory. We work with a vetted network of manufacturers and processors across the country, which lets us offer a broad range of grades and forms while keeping a close watch on quality, documentation and delivery. From raw-material selection and lab testing to packaging and export paperwork, every shipment is handled with the same care, whether it is a first trial order or a repeat container.</span></p>
          <p data-i18n="about.who_body3">The way we work comes down to three habits: clarity in how we communicate, compliance with the standards each market expects, and consistency you can plan your own production around.</p>
        </div>
      </div>

      <div class="lg:col-span-5 reveal d1">
        <div class="glance">
          <div class="px-6 pt-6 pb-4">
            <p class="font-head font-semibold text-xs tracking-[0.16em] uppercase text-slate-400"><span data-i18n="about.glance_heading">Company at a glance</span></p>
          </div>
          <div class="glance-row"><span class="k"><span data-i18n="about.glance_established">Established</span></span><span class="v"><span data-i18n="about.glance_established_val">2025</span></span></div>
          <div class="glance-row"><span class="k"><span data-i18n="about.glance_location">Head office</span></span><span class="v"><span data-i18n="about.glance_location_val">New Delhi, India</span></span></div>
          <div class="glance-row"><span class="k"><span data-i18n="about.glance_type">Business type</span></span><span class="v"><span data-i18n="about.glance_type_val">Merchant exporter</span></span></div>
          <div class="glance-row"><span class="k"><span data-i18n="about.glance_reg">Registered</span></span><span class="v">GST · IEC · RCMC · FSSAI · ISO 9001</span></div>
          <div class="glance-row"><span class="k"><span data-i18n="about.glance_categories">Product lines</span></span><span class="v" data-i18n="about.glance_categories_val">5 ingredient categories</span></div>
          <div class="glance-row"><span class="k"><span data-i18n="about.glance_markets">Target markets</span></span><span class="v" data-i18n="about.glance_markets_val">15+ countries</span></div>
          <div class="glance-row"><span class="k"><span data-i18n="about.glance_team">Team</span></span><span class="v"><span data-i18n="about.glance_team_val">Small, specialist</span></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== BY THE NUMBERS (light) ===================== -->
  <section class="py-16 bg-cream">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="card text-center p-7 reveal">
          <div class="stat-num text-grad-deep text-4xl sm:text-5xl" data-count="5">0</div>
          <div class="text-slate-500 text-sm mt-2"><span data-i18n="about.stats_categories">Ingredient categories</span></div>
        </div>
        <div class="card text-center p-7 reveal d1">
          <div class="stat-num text-grad-deep text-4xl sm:text-5xl" data-count="15" data-suffix="+">0</div>
          <div class="text-slate-500 text-sm mt-2"><span data-i18n="about.stats_markets">Markets in our sights</span></div>
        </div>
        <div class="card text-center p-7 reveal d2">
          <div class="stat-num text-grad-deep text-4xl sm:text-5xl" data-count="5">0</div>
          <div class="text-slate-500 text-sm mt-2"><span data-i18n="about.stats_continents">Continents</span></div>
        </div>
        <div class="card text-center p-7 reveal d3">
          <div class="stat-num text-grad-deep text-4xl sm:text-5xl">100%</div>
          <div class="text-slate-500 text-sm mt-2"><span data-i18n="about.stats_lots">Quality-checked lots</span></div>
        </div>
      </div>
    </div>
  </section>

  <WaveDivider topColor="#f7f8fb" bottomColor="#ffffff" />

  <!-- =====================================================================
       OUR MISSION & VISION
       ===================================================================== -->
  <section id="purpose" class="py-24 bg-white relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -top-28 -right-28 w-[26rem] h-[26rem] rounded-full" style="background: radial-gradient(closest-side, rgba(91,130,214,.16), transparent); filter: blur(10px);"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative">
      <!-- Header (left-aligned, editorial) -->
      <div class="max-w-3xl reveal">
        <span class="eyebrow"><span data-i18n="about.purpose_eyebrow">Our Purpose</span></span>
        <h2 class="tg-5 font-extrabold text-4xl sm:text-5xl mt-4 leading-[1.08]"><span data-i18n="about.purpose_heading">Building the world's go-to ingredient partner</span></h2>
        <p class="text-slate-500 text-lg mt-5 max-w-2xl" data-i18n="about.purpose_sub">We are not here just to fill orders. We are building Clarté Overseas into a name food businesses anywhere can source from with complete confidence.</p>
      </div>

      <!-- Mission / Vision as big numbered statements (no boxed cards) -->
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-0 mt-16">
        <div class="lg:pr-16 reveal">
          <div class="flex gap-5">
            <span class="mv-bar"></span>
            <div>
              <p class="mv-label"><span data-i18n="about.mission_label">Mission</span></p>
              <p class="mv-text text-xl sm:text-2xl"><span data-i18n="about.mission_body">Give food brands and manufacturers a dehydrated-ingredient partner they can fully rely on: steady quality, honest sourcing, and supply that lands on time, every single order.</span></p>
            </div>
          </div>
        </div>
        <div class="lg:pl-16 lg:border-l lg:border-slate-200 reveal d1">
          <div class="flex gap-5">
            <span class="mv-bar"></span>
            <div>
              <p class="mv-label"><span data-i18n="about.vision_label">Vision</span></p>
              <p class="mv-text text-xl sm:text-2xl"><span data-i18n="about.vision_body">Become the world's largest and most trusted exporter of dehydrated food ingredients, reaching buyers in as many countries as we possibly can.</span></p>
            </div>
          </div>
        </div>
      </div>

      <!-- What we're driving toward -->
      <div class="mt-20 reveal">
        <p class="font-head font-semibold text-xs tracking-[0.18em] uppercase text-slate-400 mb-7"><span data-i18n="about.goals_heading">What we're driving toward</span></p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-9">
          <div class="reveal">
            <span class="goal-bar"></span>
            <h4 class="font-head font-bold text-navy" data-i18n="about.goal1_title">Reach across the globe</h4>
            <p class="text-slate-500 text-sm mt-2 leading-relaxed" data-i18n="about.goal1_body">Serve buyers on every continent, then keep widening the map year on year.</p>
          </div>
          <div class="reveal d1">
            <span class="goal-bar"></span>
            <h4 class="font-head font-bold text-navy" data-i18n="about.goal2_title">Reliability, first</h4>
            <p class="text-slate-500 text-sm mt-2 leading-relaxed" data-i18n="about.goal2_body">Be the supplier our customers never have to chase, shipment after shipment.</p>
          </div>
          <div class="reveal d2">
            <span class="goal-bar"></span>
            <h4 class="font-head font-bold text-navy" data-i18n="about.goal3_title">Traceable &amp; responsible</h4>
            <p class="text-slate-500 text-sm mt-2 leading-relaxed" data-i18n="about.goal3_body">Full traceability and fair, sustainable sourcing, from the farm to the port.</p>
          </div>
          <div class="reveal d3">
            <span class="goal-bar"></span>
            <h4 class="font-head font-bold text-navy" data-i18n="about.goal4_title">Built to scale</h4>
            <p class="text-slate-500 text-sm mt-2 leading-relaxed" data-i18n="about.goal4_body">Capacity, systems and certifications that grow as fast as demand does.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== MARKETS MARQUEE ===================== -->
  <section class="py-20 lg:py-24 bg-cream overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center reveal mb-12">
      <span class="eyebrow center"><span data-i18n="about.markets_heading">Where We're Headed</span></span>
      <h2 class="tg-6 font-extrabold text-3xl sm:text-4xl mt-4"><span data-i18n="about.markets_sub">Markets we're building toward</span></h2>
      <p class="text-slate-500 text-lg mt-4 max-w-2xl mx-auto" data-i18n="about.markets_body">We already work with buyers across the UK, Europe, the Gulf and Australia, and we're actively opening up more. Here is where we're focused next.</p>
    </div>
    <div class="marquee reveal">
      <div class="marquee-track">
        {[...countries, ...countries].map((c) => (
          <span class="country-chip"><span class="dot"></span>{c}</span>
        ))}
      </div>
    </div>
  </section>

  <CurveDivider topColor="#f7f8fb" bottomColor="#ffffff" />

  <!-- ===================== VALUES ===================== -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="eyebrow center"><span data-i18n="about.values_eyebrow">What Sets Us Apart</span></span>
        <h2 class="tg-3 font-extrabold text-3xl sm:text-4xl mt-4"><span data-i18n="about.values_sub">The way we like to work</span></h2>
      </div>
      <div class="val-grid mt-14">
        {values.map((v, i) => (
          <div class={`val-card reveal ${["", "d1", "d2"][i % 3]}`}>
            <span class="val-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span class="val-ico">
              <svg fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                {v.paths.map((d) => <path d={d} />)}
              </svg>
            </span>
            <h3 class="val-title" data-i18n={`about.val${i + 1}_title`}>{v.t}</h3>
            <p class="val-desc" data-i18n={`about.val${i + 1}_body`}>{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PARTNER WITH US ===================== -->
  <section class="py-20 lg:py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="reveal">
        <span class="eyebrow"><span data-i18n="about.partners_eyebrow">Work With Us</span></span>
        <h2 class="tg-4 font-extrabold text-3xl sm:text-4xl mt-4 leading-tight"><span data-i18n="about.partners_sub">Who we partner with</span></h2>
        <p class="text-slate-500 text-lg mt-4" data-i18n="about.partners_body">If you source, distribute, manufacture or open markets in food ingredients, there is a way to work together.</p>
      </div>
      <div class="part-tags reveal d1">
        {partners.map((p, i) => (
          <span class="part-tag" data-i18n={`about.partner${i + 1}_tag`}>{p.t}</span>
        ))}
        <a href="#quote" class="part-tag part-tag-cta"><span data-i18n="about.partner_cta">Something else in mind?</span>
          <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Testimonials variant="light" />

  <!-- ===================== FAQ ===================== -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center reveal">
        <span class="eyebrow center"><span data-i18n="about.faq_eyebrow">FAQ</span></span>
        <h2 class="tg-2 font-extrabold text-3xl sm:text-4xl mt-4" data-i18n="about.faq_heading">Questions about Clarté Overseas</h2>
        <p class="text-slate-500 text-lg mt-4" data-i18n="about.faq_sub">A few things buyers often want to know before getting in touch.</p>
      </div>
      <div class="mt-12 reveal d1">
        {aboutFaqs.map((f, i) => (
          <details class="faq-item">
            <summary>
              <span data-i18n={`about.faq${i + 1}_q`}>{f.q}</span>
              <svg class="chev w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="faq-body" data-i18n={`about.faq${i + 1}_a`}>{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section id="quote" class="py-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="hero rounded-[2rem] px-8 py-16 sm:px-16 text-center relative overflow-hidden">
        <h2 class="text-white font-extrabold text-3xl sm:text-5xl reveal"><span data-i18n="about.cta_heading">Let's build something together</span></h2>
        <p class="text-slate-300 text-lg mt-5 max-w-xl mx-auto reveal d1"><span data-i18n="about.cta_sub">Tell us your requirement and target market. We'll reply with specs, samples and a quote in your currency.</span></p>
        <div class="flex flex-wrap justify-center gap-4 mt-9 reveal d2">
          <a href="#" data-wa data-wa-msg="Hi Clarté Overseas, I've read about your company and I'd like to explore a business partnership or place an order. Can we connect?" class="btn btn-wa"><span data-i18n="about.cta_btn">Chat on WhatsApp</span>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
          </a>
          <a href="/contact" class="btn btn-ghost" data-i18n="about.cta_btn_enquire">Enquire Us</a>
          {CONTACT.calendlyUrl && (
            <a href={CONTACT.calendlyUrl} onclick={`Calendly.initPopupWidget({url:'${CONTACT.calendlyUrl}'});return false;`} class="btn btn-calendly">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              <span data-i18n="cta.book_call">Book a 20-min call</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
