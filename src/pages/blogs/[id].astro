---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { posts } from "../../data/blogs";
import { SITE } from "../../consts";

export async function getStaticPaths() {
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const related = posts.filter((p) => p.id !== post.id).slice(0, 3);
const url = new URL(`/blogs/${post.id}`, SITE.url).href;

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  author: { "@type": "Person", name: post.author },
  publisher: { "@type": "Organization", name: SITE.name },
  mainEntityOfPage: url,
  articleSection: post.category,
};
---

<BaseLayout title={`${post.title} | Clarté Overseas`} description={post.excerpt}>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(schema)} />

  <article>
    <!-- Header -->
    <section class="about-hero pt-14 pb-12">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <nav class="crumb text-sm reveal" aria-label="Breadcrumb">
          <a href="/" data-i18n="nav.home">Home</a> <span class="text-slate-300 mx-1">/</span>
          <a href="/blogs" data-i18n="nav.blogs">Blog</a> <span class="text-slate-300 mx-1">/</span>
          <span class="text-slate-500">{post.category}</span>
        </nav>
        <div class="flex items-center gap-3 flex-wrap mt-6 reveal d1">
          <span class="blog-cat">{post.category}</span>
          <span class="blog-meta">{post.date} · {post.read}</span>
        </div>
        <h1 class="font-head font-extrabold text-navy text-3xl sm:text-4xl lg:text-5xl mt-5 leading-[1.1] reveal d1" data-i18n={`blog.post_${post.id.replace(/-/g,'_')}_title`}>{post.title}</h1>
        <p class="text-slate-600 text-lg mt-5 leading-relaxed reveal d2" data-i18n={`blog.post_${post.id.replace(/-/g,'_')}_excerpt`}>{post.excerpt}</p>
      </div>
    </section>

    <!-- Cover banner (placeholder until real cover image is added) -->
    <div class="max-w-4xl mx-auto px-6 lg:px-8 -mt-2">
      <div class="blog-banner rounded-3xl h-56 sm:h-72 reveal" style={`background:${post.accent}`}>
        <span class="b-emoji" style="font-size:4.5rem">{post.emoji}</span>
      </div>
    </div>

    <!-- Body -->
    <section class="py-14 lg:py-16 bg-white">
      <div class="max-w-3xl mx-auto px-6 lg:px-8">
        <div class="prose-article reveal" set:html={post.body} />

        <div class="mt-12 pt-8 border-t border-slate-100 flex items-center justify-between gap-4 flex-wrap reveal">
          <div class="flex items-center gap-3">
            <span class="w-11 h-11 rounded-full bg-brand-100 text-brand flex items-center justify-center font-head font-bold">{post.author.split(" ").map((n) => n[0]).join("").slice(0, 2)}</span>
            <div>
              <div class="font-head font-semibold text-navy text-sm">{post.author}</div>
              <div class="text-slate-400 text-xs">Clarté Overseas</div>
            </div>
          </div>
          <a href="/blogs" class="read-link"><svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg> <span data-i18n="blog.back">Back to blog</span></a>
        </div>
      </div>
    </section>

    <!-- Related -->
    <section class="py-16 lg:py-20 bg-cream">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <p class="font-head font-semibold text-xs tracking-[0.18em] uppercase text-slate-400 mb-8 reveal" data-i18n="blog.keep_reading">Keep reading</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-7">
          {related.map((p, i) => (
            <a href={`/blogs/${p.id}`} class={`blog-card-link card overflow-hidden flex flex-col reveal ${["", "d1", "d2"][i % 3]}`}>
              <div class="blog-banner h-40" style={`background:${p.accent}`}>
                <span class="b-emoji">{p.emoji}</span>
              </div>
              <div class="p-6 flex flex-col flex-1">
                <span class="blog-cat self-start">{p.category}</span>
                <h3 class="blog-title font-head font-bold text-lg text-navy mt-3 leading-snug" data-i18n={`blog.post_${p.id.replace(/-/g,'_')}_title`}>{p.title}</h3>
                <div class="blog-meta mt-4 pt-4 border-t border-slate-100">{p.date} · {p.read}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="quote" class="py-20">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class="hero rounded-[2rem] px-8 py-16 sm:px-16 text-center relative overflow-hidden">
          <h2 class="text-white font-extrabold text-3xl sm:text-5xl reveal" data-i18n="blog.detail_cta_heading">Let's talk ingredients</h2>
          <p class="text-slate-300 text-lg mt-5 max-w-xl mx-auto reveal d1" data-i18n="blog.detail_cta_sub">Tell us what you're sourcing and where it's headed. We'll come back with specs, samples and a quote.</p>
          <div class="flex flex-wrap justify-center gap-4 mt-9 reveal d2">
            <a href="#" data-wa data-wa-msg="Hi Clarté Overseas, I came across your blog and I'm interested in your products. Can we have a conversation?" class="btn btn-wa"><span data-i18n="blog.cta_btn_whatsapp">Chat on WhatsApp</span>
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
            </a>
            <a href="/contact" class="btn btn-ghost" data-i18n="blog.cta_btn_enquire">Enquire Us</a>
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
