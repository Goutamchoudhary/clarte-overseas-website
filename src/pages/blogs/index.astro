---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { posts, faqs } from "../../data/blogs";

const title = "Blog — Dehydrated Foods, Ingredients & India Export Insights | Clarté Overseas";
const description =
  "Practical reads on dehydrated food ingredients, buying powders and flakes, India's export market and sourcing well. From the team at Clarté Overseas.";

const [featured, ...rest] = posts;
---

<BaseLayout title={title} description={description}>
  <!-- ===================== HERO ===================== -->
  <section class="about-hero pt-14 pb-16 lg:pt-16 lg:pb-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <nav class="crumb text-sm reveal" aria-label="Breadcrumb">
        <a href="/">Home</a> <span class="text-slate-300 mx-1">/</span>
        <span class="text-slate-500">Blog</span>
      </nav>
      <div class="mt-6 reveal d1"><span class="eyebrow">The Clarté Blog</span></div>
      <h1 class="tg-2 font-extrabold text-4xl sm:text-5xl lg:text-6xl mt-5 max-w-4xl leading-[1.08] reveal d1">
        Notes on dehydrated foods, ingredients and exporting from India
      </h1>
      <p class="text-slate-600 text-lg mt-6 max-w-2xl leading-relaxed reveal d2">
        Plain, useful reads for anyone buying or selling dried food ingredients: market shifts,
        buyer guides and lessons from the world of global sourcing.
      </p>
    </div>
  </section>

  <!-- ===================== FEATURED ===================== -->
  <section class="py-14 lg:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <a href={`/blogs/${featured.id}`} class="blog-card-link card overflow-hidden grid lg:grid-cols-2 reveal">
        <div class="blog-banner h-60 lg:h-full min-h-[260px]" style={`background:${featured.accent}`}>
          <span class="b-emoji">{featured.emoji}</span>
        </div>
        <div class="p-8 lg:p-10 flex flex-col justify-center">
          <div class="flex items-center gap-3 flex-wrap">
            <span class="blog-cat">{featured.category}</span>
            <span class="blog-meta">{featured.date} · {featured.read}</span>
          </div>
          <h2 class="blog-title font-head font-extrabold text-2xl sm:text-3xl text-navy mt-4 leading-tight">{featured.title}</h2>
          <p class="text-slate-500 mt-4 leading-relaxed">{featured.excerpt}</p>
          <span class="read-link mt-6">Read article
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- ===================== LATEST GRID ===================== -->
  <section class="pb-20 lg:pb-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="font-head font-semibold text-xs tracking-[0.18em] uppercase text-slate-400 mb-8 reveal">More from the blog</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-7">
        {rest.map((p, i) => (
          <a href={`/blogs/${p.id}`} class={`blog-card-link card overflow-hidden flex flex-col reveal ${["", "d1", "d2"][i % 3]}`}>
            <div class="blog-banner h-44" style={`background:${p.accent}`}>
              <span class="b-emoji">{p.emoji}</span>
            </div>
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="blog-cat">{p.category}</span>
              </div>
              <h3 class="blog-title font-head font-bold text-lg text-navy mt-3 leading-snug">{p.title}</h3>
              <p class="text-slate-500 text-[15px] mt-2 leading-relaxed">{p.excerpt}</p>
              <div class="flex items-center justify-between mt-5 pt-4 border-t border-slate-100">
                <span class="blog-meta">{p.date} · {p.read}</span>
                <span class="read-link text-xs">Read
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="py-20 lg:py-24 bg-cream">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center reveal">
        <span class="eyebrow center">FAQ</span>
        <h2 class="tg-8 font-extrabold text-3xl sm:text-4xl mt-4">Questions buyers ask us</h2>
        <p class="text-slate-500 text-lg mt-4">The things importers and manufacturers most often want to know before they get in touch.</p>
      </div>
      <div class="mt-12 reveal d1">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>
              {f.q}
              <svg class="chev w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="faq-body">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section id="quote" class="py-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="hero rounded-[2rem] px-8 py-16 sm:px-16 text-center relative overflow-hidden">
        <h2 class="text-white font-extrabold text-3xl sm:text-5xl reveal">Have a sourcing question?</h2>
        <p class="text-slate-300 text-lg mt-5 max-w-xl mx-auto reveal d1">Tell us the product and your market. We'll reply with specs, samples and a quote in your currency.</p>
        <div class="flex flex-wrap justify-center gap-4 mt-9 reveal d2">
          <a href="#" data-wa class="btn btn-wa">Chat on WhatsApp
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
          </a>
          <a href="mailto:info@clarteoverseas.com" class="btn btn-ghost">Enquire Us</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
