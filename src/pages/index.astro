---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveDivider from '../components/WaveDivider.astro';
import CurveDivider from '../components/CurveDivider.astro';
import SlantDivider from '../components/SlantDivider.astro';
import { SITE } from '../consts';
const title = 'Clarté Overseas — Premium Dehydrated Fruits, Vegetables & Powders | Indian Exporter';
const description = 'Clarté Overseas is an India-based merchant exporter of premium dehydrated fruits, vegetables, flakes and powders, supplying food manufacturers, flavour houses and distributors worldwide.';
---
<BaseLayout title={title} description={description}>
<!-- =====================================================================
       HERO
       ===================================================================== -->
  <section id="home" class="hero flex items-center min-h-screen pt-20 pb-24">
    <!-- Optional photo layer (loads when online; gradient shows otherwise) -->
    <img class="hero-photo" data-src="https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?auto=format&fit=crop&w=1920&q=80" alt="" aria-hidden="true" />

    <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <!-- Content (now on the RIGHT on desktop) -->
      <div class="lg:order-2 lg:col-span-7">
        <span class="badge-pill reveal">🌿 Merchant exporter of dehydrated foods · India</span>

        <h1 class="reveal d1 text-white font-extrabold leading-[1.03] mt-6 text-5xl sm:text-6xl lg:text-[4.2rem]">
          India's Harvest,<br /><span class="text-grad">Preserved for the World.</span>
        </h1>

        <p class="reveal d2 text-slate-300 text-lg leading-relaxed mt-7 max-w-xl">
          We take freshly harvested Indian produce and turn it into shelf-stable
          flakes, granules and powders that travel well. Food manufacturers,
          flavour houses and distributors around the world rely on us for steady
          supply and consistent quality.
        </p>

        <div class="reveal d3 flex flex-wrap gap-4 mt-9">
          <a href="#export" class="btn btn-primary">Explore Products
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="/contact" class="btn btn-ghost">Request a Quote</a>
        </div>
      </div>

      <!-- Stat cards (now on the LEFT on desktop) -->
      <div class="lg:order-1 lg:col-span-5 reveal d4 flex flex-col gap-4 w-full max-w-md">
        <div class="hero-stat">
          <span class="hs-ico"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12"/></svg></span>
          <div>
            <div class="stat-num text-grad text-3xl sm:text-4xl" data-count="40" data-suffix="+">0</div>
            <div class="text-slate-300 text-sm">Dehydrated SKUs &amp; grades</div>
          </div>
        </div>
        <div class="hero-stat">
          <span class="hs-ico"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg></span>
          <div>
            <div class="stat-num text-grad text-3xl sm:text-4xl" data-count="5" data-suffix="+">0</div>
            <div class="text-slate-300 text-sm">Countries served worldwide</div>
          </div>
        </div>
        <div class="hero-stat">
          <span class="hs-ico"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <div class="stat-num text-grad text-3xl sm:text-4xl">100%</div>
            <div class="text-slate-300 text-sm">Quality-checked batches</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       WHAT WE EXPORT
       ===================================================================== -->
  <section id="export" class="py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-2xl reveal">
        <span class="eyebrow">Product Range</span>
        <h2 class="tg-1 font-extrabold text-4xl sm:text-5xl mt-4">Powders and ingredients for every formulation</h2>
        <p class="text-slate-500 text-lg mt-4">Indian-grown produce, dried and milled into clean powders and food-grade ingredients. Each grade is made for long shelf life, true flavour and reliable performance in your recipes.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7 mt-14">
        <!-- Card 1 -->
        <article class="card product-card reveal">
          <div class="ph-wrap img-ph h-48" data-emoji="🌿" data-img="/assets/img/categories/herbal-leaf.jpg">
            <span class="icon-badge on-image"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M7 20h10M10 20c5.5-2.5.8-6.4 3-10M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4 2.2-.2 3.9.2 5.5.6zM14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/></svg></span>
          </div>
          <div class="p-6">
            <div class="flex items-start justify-between gap-3 mb-3">
              <h3 class="font-head font-bold text-lg text-navy">Herbal &amp; Leaf Powders</h3>
              <span class="status-dot mt-1 is-available" title="Available" aria-label="Available"></span>
            </div>
            <p class="text-slate-500 text-[15px] leading-relaxed">Leaves and herbs such as moringa, curry leaf and spinach, dried gently and milled into clean, deep-green powders for teas, supplements and seasoning.</p>
            <a href="/products/herbal-leaf-powders" class="card-link mt-5 card-stretch">View Products<span class="arrow"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
          </div>
        </article>
        <!-- Card 2 -->
        <article class="card product-card reveal d1">
          <div class="ph-wrap img-ph h-48" data-emoji="🌶️" data-img="/assets/img/categories/culinary-spice-category.jpg">
            <span class="icon-badge on-image"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M7 20h10M10 20c5.5-2.5.8-6.4 3-10M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4 2.2-.2 3.9.2 5.5.6zM14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/></svg></span>
          </div>
          <div class="p-6">
            <div class="flex items-start justify-between gap-3 mb-3">
              <h3 class="font-head font-bold text-lg text-navy">Dehydrated Vegetable Powders &ndash; Culinary &amp; Spice Applications</h3>
              <span class="status-dot mt-1 is-available" title="Available" aria-label="Available"></span>
            </div>
            <p class="text-slate-500 text-[15px] leading-relaxed">Onion, garlic, tomato and chilli powders that carry real flavour into kitchens, ready blends and savoury mixes.</p>
            <a href="/products/culinary-spice-powders" class="card-link mt-5 card-stretch">View Products<span class="arrow"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
          </div>
        </article>
        <!-- Card 3 -->
        <article class="card product-card reveal d2">
          <div class="ph-wrap img-ph h-48" data-emoji="🥦" data-img="/assets/img/categories/dehydrated-veg-powder.jpg">
            <span class="icon-badge on-image"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M7 20h10M10 20c5.5-2.5.8-6.4 3-10M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4 2.2-.2 3.9.2 5.5.6zM14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/></svg></span>
          </div>
          <div class="p-6">
            <div class="flex items-start justify-between gap-3 mb-3">
              <h3 class="font-head font-bold text-lg text-navy">Dehydrated Vegetable Powders &ndash; Functional &amp; Nutritional</h3>
              <span class="status-dot mt-1 is-available" title="Available" aria-label="Available"></span>
            </div>
            <p class="text-slate-500 text-[15px] leading-relaxed">Beetroot, carrot, pumpkin and spinach powders chosen for natural colour, fibre and the nutrients buyers look for.</p>
            <a href="/products/functional-nutritional-powders" class="card-link mt-5 card-stretch">View Products<span class="arrow"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
          </div>
        </article>
        <!-- Card 4 -->
        <article class="card product-card reveal">
          <div class="ph-wrap img-ph h-48" data-emoji="🍓" data-img="/assets/img/categories/dehydrated-fruits-powder.jpg">
            <span class="icon-badge on-image"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06z"/><path d="M10 2c1 .5 2 2 2 5"/></svg></span>
          </div>
          <div class="p-6">
            <div class="flex items-start justify-between gap-3 mb-3">
              <h3 class="font-head font-bold text-lg text-navy">Dehydrated Fruit Powder Ingredients</h3>
              <span class="status-dot mt-1 is-available" title="Available" aria-label="Available"></span>
            </div>
            <p class="text-slate-500 text-[15px] leading-relaxed">Mango, banana, pineapple and berry powders made for bakery, cereal, dairy and beverage recipes.</p>
            <a href="/products/fruit-powders" class="card-link mt-5 card-stretch">View Products<span class="arrow"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
          </div>
        </article>
        <!-- Card 5 -->
        <article class="card product-card reveal d1">
          <div class="ph-wrap img-ph h-48" data-emoji="🧪">
            <span class="icon-badge on-image"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10 2v7.31L4.7 17.6a2 2 0 0 0 1.7 3h11.2a2 2 0 0 0 1.7-3L14 9.3V2"/><path d="M8.5 2h7M7 16h10"/></svg></span>
          </div>
          <div class="p-6">
            <div class="flex items-start justify-between gap-3 mb-3">
              <h3 class="font-head font-bold text-lg text-navy">Hydrocolloids &amp; Food Additives</h3>
              <span class="status-dot mt-1 is-available" title="Available" aria-label="Available"></span>
            </div>
            <p class="text-slate-500 text-[15px] leading-relaxed">Guar gum, gum acacia and related additives that bring texture, binding and stability to your formulations.</p>
            <a href="/products/hydrocolloids-food-additives" class="card-link mt-5 card-stretch">View Products<span class="arrow"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
          </div>
        </article>
        <!-- Card 6 -->
        <article class="card product-card reveal d2">
          <div class="ph-wrap img-ph h-48" data-emoji="➕">
            <span class="icon-badge on-image"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 4H14M10 4H3M21 12H12M8 12H3M21 20H16M12 20H3M14 2v4M8 10v4M16 18v4"/></svg></span>
          </div>
          <div class="p-6">
            <div class="flex items-start justify-between gap-3 mb-3">
              <h3 class="font-head font-bold text-xl text-navy">Custom Blends</h3>
              <span class="status-dot mt-1 is-soon" title="Coming soon" aria-label="Coming soon"></span>
            </div>
            <p class="text-slate-500 text-[15px] leading-relaxed">Private-label blends and made-to-spec grades, built around your recipe and packed to your brief.</p>
            <a href="/contact" class="card-link mt-5 card-stretch">Talk to Us<span class="arrow"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       WHY DEHYDRATED (compact benefits card — distinct, low-footprint)
       ===================================================================== -->
  <section id="why-dehydrated" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="wd-panel reveal">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-4">
            <span class="eyebrow">Why Dehydrated</span>
            <h2 class="tg-2 font-extrabold text-3xl sm:text-4xl mt-4 leading-tight">Smaller, lighter, longer&#8209;lasting</h2>
            <p class="text-slate-500 mt-3 leading-relaxed">Take out the water and you keep the goodness while cutting the cost and hassle of moving it.</p>
          </div>
          <div class="lg:col-span-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="wd-item reveal">
              <div class="wd-ico"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
              <h3 class="font-head font-bold text-navy text-[15px]">Long shelf life</h3>
              <p class="text-slate-500 text-[13px] mt-1 leading-snug">12 to 24 months with no cold chain.</p>
            </div>
            <div class="wd-item reveal d1">
              <div class="wd-ico"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="2"/><circle cx="18" cy="17" r="2"/></svg></div>
              <h3 class="font-head font-bold text-navy text-[15px]">Lighter to ship</h3>
              <p class="text-slate-500 text-[13px] mt-1 leading-snug">Less weight means lower freight.</p>
            </div>
            <div class="wd-item reveal d2">
              <div class="wd-ico"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg></div>
              <h3 class="font-head font-bold text-navy text-[15px]">All-year supply</h3>
              <p class="text-slate-500 text-[13px] mt-1 leading-snug">Available well beyond the harvest.</p>
            </div>
            <div class="wd-item reveal d3">
              <div class="wd-ico"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></div>
              <h3 class="font-head font-bold text-navy text-[15px]">Stable quality</h3>
              <p class="text-slate-500 text-[13px] mt-1 leading-snug">Same flavour and colour each batch.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       INDUSTRIES WE SERVE (split — image left, list right)
       ===================================================================== -->
  <section id="industries" class="py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 grid lg:grid-cols-2 gap-14 items-center">
      <div class="reveal from-left">
        <div class="img-ph rounded-3xl h-[300px] sm:h-[420px]" data-emoji="🥘"></div>
      </div>
      <div class="reveal d1 from-right">
        <span class="eyebrow">Who We Serve</span>
        <h2 class="tg-4 font-extrabold text-4xl sm:text-5xl mt-4">Industries we serve</h2>
        <p class="text-slate-500 text-lg mt-4">We supply dehydrated ingredients to businesses that build flavour into their products:</p>
        <ul class="mt-6 space-y-3 text-slate-600">
          <li class="flex items-start gap-3"><svg class="w-5 h-5 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg><span>Food &amp; beverage manufacturers</span></li>
          <li class="flex items-start gap-3"><svg class="w-5 h-5 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg><span>Flavour houses &amp; ingredient blenders</span></li>
          <li class="flex items-start gap-3"><svg class="w-5 h-5 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg><span>Seasoning &amp; formulation companies</span></li>
          <li class="flex items-start gap-3"><svg class="w-5 h-5 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg><span>Bakery &amp; confectionery</span></li>
          <li class="flex items-start gap-3"><svg class="w-5 h-5 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg><span>Nutraceutical &amp; health-food brands</span></li>
          <li class="flex items-start gap-3"><svg class="w-5 h-5 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg><span>HoReCa &amp; private-label retailers</span></li>
        </ul>
        <p class="text-slate-500 mt-6 leading-relaxed">Our role is to support these industries with reliable, food-grade ingredients that add real value to their end products.</p>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       WHY CHOOSE CLARTÉ (Our Advantage) + dark feature strip
       ===================================================================== -->
  <section id="advantage" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="eyebrow center">The Clarté Edge</span>
        <h2 class="tg-3 font-extrabold text-4xl sm:text-5xl mt-4">Why buyers choose Clarté Overseas</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-7 mt-14">
        <div class="card p-8 reveal">
          <div class="w-14 h-14 rounded-2xl bg-brand-100 flex items-center justify-center text-brand mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3 class="font-head font-bold text-xl text-navy">Compliance, Built In</h3>
          <p class="text-slate-500 mt-3 leading-relaxed">From FSSAI and ISO 22000 to HACCP and APEDA, every consignment ships with the certifications and paperwork your market expects.</p>
        </div>
        <div class="card p-8 reveal d1">
          <div class="w-14 h-14 rounded-2xl bg-brand-100 flex items-center justify-center text-brand mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M7 20h10M10 20c5.5-2.5.8-6.4 3-10M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4 2.2-.2 3.9.2 5.5.6zM14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/></svg>
          </div>
          <h3 class="font-head font-bold text-xl text-navy">Farm-Direct Sourcing</h3>
          <p class="text-slate-500 mt-3 leading-relaxed">We buy straight from India's growers and audited processing units, so there are no middlemen and quality stays traceable from farm to pack.</p>
        </div>
        <div class="card p-8 reveal d2">
          <div class="w-14 h-14 rounded-2xl bg-brand-100 flex items-center justify-center text-brand mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7zM7 19a2 2 0 100-4 2 2 0 000 4zM18 19a2 2 0 100-4 2 2 0 000 4z"/></svg>
          </div>
          <h3 class="font-head font-bold text-xl text-navy">Seamless Export Logistics</h3>
          <p class="text-slate-500 mt-3 leading-relaxed">Strategic port access, dependable freight partners and export-grade packaging keep every shipment safe and on schedule, worldwide.</p>
        </div>
        <div class="card p-8 reveal">
          <div class="w-14 h-14 rounded-2xl bg-brand-100 flex items-center justify-center text-brand mb-6">
