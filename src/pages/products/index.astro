---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { categories, productsByCategory } from "../../data/products";
import { COMING_SOON_PRODUCTS, UNAVAILABLE_PRODUCTS } from "../../consts";
import { smallest } from "../../lib/responsive-img";
import { isVersion } from "../../data/site-options";
import ProductShuffle from "../../components/ProductShuffle.astro";
import Vector from "../../components/Vector.astro";
const v3 = isVersion("v3");
import en from "../../../public/i18n/en.json";
// Questions already answered and translated for the How We Export page.
const faqs = [1, 2, 4, 6, 7].map((n) => ({
  qk: `export.faq${n}_q`, ak: `export.faq${n}_a`,
  q: (en as Record<string, string>)[`export.faq${n}_q`], a: (en as Record<string, string>)[`export.faq${n}_a`],
}));
const faqLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};

const hiddenFromThumbs = (slug: string) =>
  COMING_SOON_PRODUCTS.has(slug) || UNAVAILABLE_PRODUCTS.has(slug);

const title = "Dehydrated Powders Exporter & Bulk Supplier | Clarté Overseas";
const description =
  "Seven ranges from India: fruit, vegetable, culinary, functional and Ayurvedic powders, seeds and hydrocolloids. COA on every lot, mixed containers welcome.";

const cats = categories.map((c) => {
  const items = productsByCategory(c.slug);
  return {
    ...c,
    count: items.length,
    thumbs: c.thumbSlugs
      ? c.thumbSlugs
          .map((slug) => items.find((p) => p.slug === slug))
          .filter((p) => p && p.image && !hiddenFromThumbs(p.slug))
      : items.filter((p) => p.image && !hiddenFromThumbs(p.slug)).slice(0, 4),
    fallback: items.slice(0, 4),
    // Every available product with a photo, new photography first. A category
    // with fewer than three tops up from its coming-soon products.
    shuffle: (() => {
      const photo = items.filter((p) => p.image);
      const ready = photo.filter((p) => !hiddenFromThumbs(p.slug));
      const ordered = [...ready.filter((p) => p.listImage), ...ready.filter((p) => !p.listImage)];
      const extra = photo.filter((p) => hiddenFromThumbs(p.slug) && !UNAVAILABLE_PRODUCTS.has(p.slug));
      return (ordered.length >= 3 ? ordered : [...ordered, ...extra]).map((p) => ({
        name: p.name, key: `cat.prod_${p.slug.replace(/-/g, "_")}_name`, image: p.image!, href: `/products/${c.slug}/${p.slug}`,
      }));
    })(),
  };
});
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">{v3 && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}</Fragment>
  <PageHero
    i18nPrefix="products"
    i18nCrumb="nav.products"
    crumb="Products"
    eyebrow="Our Range"
    watermark="Products"
    heading="Dehydrated powders, milled for the world's food makers"
    subtitle="Seven focused categories, each grown and processed in India for clean flavour, true colour and dependable, spec-driven supply. Pick a category to see the full range."
    chips={["100% natural", "Spec-driven supply", "Private label ready"]}
  />

  <section class={`py-16 lg:py-20 bg-white${v3 ? " j-flow" : ""}`}>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-col gap-6 lg:gap-8">
      {cats.map((c, i) => (
        <div class={i === 0 ? "j-flow-first" : undefined}>
        <article class="cat-row" style={`--from:${c.accentFrom};--to:${c.accentTo}`} data-side={i % 2 === 0 ? "l" : "r"}>
          <div class="cat-row-text reveal">
            <div class="cat-row-head">
              <span class="cat-index">{String(i + 1).padStart(2, "0")}</span>
              <span class="cat-emoji">{c.emoji}</span>
            </div>
            <h2 class="cat-name" data-i18n={`products.cat_${c.slug.replace(/-/g, '_')}_name`}>{c.name}</h2>
            <p class="cat-desc" data-i18n={`products.cat_${c.slug.replace(/-/g, '_')}_desc`}>{c.description}</p>
            <div class="cat-row-foot">
              <a href={`/products/${c.slug}`} class="cat-cta">
                <span data-i18n="products.cat_explore">Explore range</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
              <span class="cat-count">{c.count}&nbsp;<span data-i18n="products.cat_count_unit">products</span></span>
            </div>
          </div>
          {v3 && c.shuffle.length >= 3 ? (
            <div class="reveal d1"><ProductShuffle items={c.shuffle} label={c.name} /></div>
          ) : (
          <a href={`/products/${c.slug}`} class="cat-row-media reveal d1" aria-label={c.name}>
            <span class="cat-media-tint" aria-hidden="true"></span>
            {(c.thumbs.length ? c.thumbs : c.fallback).map((p) => (
              <span class="cat-thumb">
                {p.image
                  ? <img src={smallest(p.image)} alt={p.name} loading="lazy" decoding="async" />
                  : <span class="cat-thumb-emoji">{p.emoji}</span>}
              </span>
            ))}
          </a>
          )}
        </article>
        </div>
      ))}
    </div>
  </section>

  {v3 && (
    <section class="j-docs">
      <div class="j-wrap">
        <div class="j-center reveal">
          <span class="eyebrow center"><span data-i18n="products.docs_eyebrow">Export Paperwork</span></span>
          <h2 class="j-h2" data-i18n="products.docs_heading">Everything that comes with an order</h2>
          <p class="j-sub" data-i18n="products.docs_sub">Five core documents travel with your shipment, prepared accurately and on time so your consignment moves without hold-ups.</p>
        </div>
        <div class="j-docs-grid">
          {[["doc-invoice", "Commercial Invoice", "The itemised record of your order, in your currency."], ["doc-packing-list", "Packing List", "Every bag and carton, with weights and marks."], ["doc-origin", "Certificate of Origin", "Confirms the goods were produced in India."], ["doc-analysis", "Certificate of Analysis", "Lab results for your lot, checked against spec."], ["doc-spec", "Product Specification", "The agreed grade, mesh and quality parameters."]].map(([v, t, d], i) => (
            <div class={`j-doc reveal d${i % 3}`}>
              <Vector name={v} size={104} />
              <h3 data-i18n={`products.doc${i + 1}_title`}>{t}</h3>
              <p data-i18n={`products.doc${i + 1}_desc`}>{d}</p>
            </div>
          ))}
        </div>
        <p class="j-docs-note" data-i18n="products.docs_note">Phytosanitary and other market-specific certificates are added when your destination requires them.</p>
      </div>
    </section>
  )}

  {v3 && (
    <section class="j-faq">
      <div class="j-wrap j-faq-grid">
        <div class="reveal">
          <span class="eyebrow" data-i18n="export.faq_eyebrow">FAQ</span>
          <h2 class="j-h2 j-h2-md" data-i18n="products.faq_heading">Buying from our range, answered</h2>
          <p class="j-sub" data-i18n="export.faq_sub">The practical questions buyers ask before the first shipment.</p>
          <span class="j-faq-art"><Vector name="buyer-questions" size={176} /></span>
        </div>
        <div class="reveal d1">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>
                <span data-i18n={f.qk}>{f.q}</span>
                <svg class="chev w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="faq-body" data-i18n={f.ak}>{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
