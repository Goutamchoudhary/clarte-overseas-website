---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EnquiryDialog from "../../../components/EnquiryDialog.astro";
import { categories, productsByCategory, getCategory } from "../../../data/products";
import { SITE, UNAVAILABLE_PRODUCTS, COMING_SOON_PRODUCTS } from "../../../consts";
import { srcsetFor, SIZES } from "../../../lib/responsive-img";
import { isVersion } from "../../../data/site-options";
import { collageCats } from "../../../lib/collage";
import Vector from "../../../components/Vector.astro";
import { categoryGuides, guideShelf } from "../../../data/category-guides";
import { artFor } from "../../../lib/product-art";

const v3 = isVersion("v3");

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const cat = getCategory(category)!;
const items = productsByCategory(category);
const catKey = `products.cat_${category.replace(/-/g, "_")}`;
const photo = collageCats.find((c) => c.slug === category)!;
const guide = categoryGuides[category];
const gk = `cat.guide_${category.replace(/-/g, "_")}`;

// Same reasoning as the product pages: lead with the words a sourcing manager
// types, not with our internal category phrasing.
const title = `${cat.name} Exporter in India | Clarté Overseas`;
const description = (
  `${cat.name} exporter in India. ${cat.tagline}. ` +
  `COA with every lot, mixed containers welcome.`
);

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Products", item: `${SITE.url}/products` },
    { "@type": "ListItem", position: 3, name: cat.name, item: `${SITE.url}/products/${cat.slug}` },
  ],
};
const listLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: cat.name,
  itemListElement: items.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: p.name,
    url: `${SITE.url}/products/${cat.slug}/${p.slug}`,
  })),
};
---

<BaseLayout title={title} description={description} image={photo.big}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(listLd)} />
  </Fragment>

  {v3 ? (
    <section class="j-cat-hero" data-cat={cat.slug}>
      <div class="j-wrap j-cat-hero-grid">
        <div>
          <nav class="j-cat-crumb" aria-label="Breadcrumb">
            <a href="/" data-i18n="nav.home">Home</a> <span aria-hidden="true">/</span>
            <a href="/products" data-i18n="nav.products">Products</a> <span aria-hidden="true">/</span>
            <span data-i18n={`${catKey}_name`}>{cat.name}</span>
          </nav>
          <h1 class="j-cat-title" data-i18n={`${catKey}_name`}>{cat.name}</h1>
          <p class="j-cat-desc" data-i18n={`${catKey}_desc`}>{cat.description}</p>
          <div class="j-cat-chips">
            <span data-i18n="cat.meta_origin">Export-grade, India</span>
            <span data-i18n="cat.meta_private">Private label ready</span>
            <span data-i18n="cat.meta_mixed">Mix products in one container</span>
          </div>
        </div>
        <div class="j-cat-arch">
          <span class="j-cat-arch-back" aria-hidden="true"></span>
          <img src={photo.src} srcset={photo.srcset} sizes="(min-width: 1024px) 340px, 70vw" alt="" width="900" height="900" decoding="async" data-splash-hero />
          <span class="j-cat-count">{items.length}&nbsp;<span data-i18n="cat.meta_count_unit">products</span></span>
        </div>
      </div>
      <div class="j-wrap">
        <div class="j-cat-rail">
          {categories.map((c) => (
            <a href={`/products/${c.slug}`} class={c.slug === cat.slug ? "on" : undefined} aria-current={c.slug === cat.slug ? "page" : undefined} data-i18n={`products.cat_${c.slug.replace(/-/g, "_")}_name`}>{c.name}</a>
          ))}
        </div>
      </div>
    </section>
  ) : (<Fragment>
  <!-- ===================== CATEGORY HERO ===================== -->
  <section class={`cathero${cat.heroImage ? " has-photo" : ""}`} style={`--from:${cat.accentFrom};--to:${cat.accentTo}`}>
    <span class="cathero-glow" aria-hidden="true"></span>
    {cat.bgImage && <span class="cathero-bg" style={`background-image:url(${cat.bgImage})`} aria-hidden="true"></span>}
    {cat.heroImage
      ? <span class="cathero-photo" style={`background-image:url(${cat.heroImage})`} aria-hidden="true"></span>
      : !cat.bgImage && <span class="cathero-motif" aria-hidden="true">{cat.emoji}</span>}
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative">
      <nav class="crumb crumb-on-dark text-sm reveal" aria-label="Breadcrumb">
        <a href="/" data-i18n="nav.home">Home</a> <span class="mx-1 opacity-50">/</span>
        <a href="/products" data-i18n="nav.products">Products</a> <span class="mx-1 opacity-50">/</span>
        <span class="opacity-80">{cat.name}</span>
      </nav>
      <span class="cathero-emoji reveal d1">{cat.emoji}</span>
      <h1 class="cathero-title reveal d1" data-i18n={`products.cat_${cat.slug.replace(/-/g,'_')}_name`}>{cat.name}</h1>
      <p class="cathero-sub reveal d2" data-i18n={`products.cat_${cat.slug.replace(/-/g,'_')}_desc`}>{cat.description}</p>
      <div class="cathero-meta reveal d3">
        <span>{items.length}&nbsp;<span data-i18n="cat.meta_count_unit">products</span></span>
        <span class="dotsep">•</span>
        <span data-i18n="cat.meta_origin">Export-grade, India</span>
        <span class="dotsep">•</span>
        <span data-i18n="cat.meta_private">Private label ready</span>
        <span class="dotsep">•</span>
        <span data-i18n="cat.meta_mixed">Mix products in one container</span>
      </div>
    </div>
  </section>
  </Fragment>)}

  <!-- ===================== PRODUCT GRID ===================== -->
  <section class={`py-16 lg:py-20 bg-white${v3 ? " j-cat-list" : ""}`}>
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="prod-grid">
        {items.map((p, i) => (
          <article class={`prod-card reveal ${["", "d1", "d2"][i % 3]}`} style={`--from:${cat.accentFrom};--to:${cat.accentTo}`}>
            <a href={`/products/${cat.slug}/${p.slug}`} class={`prod-media${p.listImage ? " has-photo" : ""}`} aria-label={p.name}>
              <span class="prod-media-tint" aria-hidden="true"></span>
              {(p.listImage || p.image)
                ? <img src={p.listImage || p.image} srcset={srcsetFor(p.listImage || p.image)} sizes={SIZES.card} alt={p.name} loading="lazy" decoding="async" />
                : artFor(p.slug) ? <img src={artFor(p.slug)} alt={p.name} class="prod-art" loading="lazy" decoding="async" /> : <span class="prod-emoji">{p.emoji}</span>}
              {p.forms && <span class="prod-badge">{p.forms.length}&nbsp;<span data-i18n="products.forms_unit">forms</span></span>}
              {UNAVAILABLE_PRODUCTS.has(p.slug) && <span class="prod-status prod-status-unavail">Currently Unavailable</span>}
              {COMING_SOON_PRODUCTS.has(p.slug) && <span class="prod-status prod-status-soon">Coming Soon</span>}
            </a>
            <div class="prod-body">
              <div class="prod-hsn-row">
                <span class="prod-hsn">HSN {p.hsn}</span>
                <span class={`prod-avail-dot ${UNAVAILABLE_PRODUCTS.has(p.slug) ? "unavail" : COMING_SOON_PRODUCTS.has(p.slug) ? "out" : ""}`} title={UNAVAILABLE_PRODUCTS.has(p.slug) ? "Currently Unavailable" : COMING_SOON_PRODUCTS.has(p.slug) ? "Coming Soon" : "In stock"}></span>
              </div>
              <h2 class="prod-name"><a href={`/products/${cat.slug}/${p.slug}`} data-i18n={`cat.prod_${p.slug.replace(/-/g,'_')}_name`}>{p.name}</a></h2>
              <p class="prod-tag" data-i18n={`cat.prod_${p.slug.replace(/-/g,'_')}_tagline`}>{p.tagline}</p>
              <div class="prod-actions">
                <a href={`/products/${cat.slug}/${p.slug}`} class="prod-view"><span data-i18n="products.view_details">View details</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
                <button type="button" class="prod-enq" data-open-enquire data-product={p.name} data-category={cat.name}><span data-i18n="products.enquire">Enquire</span></button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {v3 && guide && (
    <section class="j-cat-guide" aria-labelledby="catGuideTitle">
      <div class="j-wrap">
        <div class="j-cat-guide-card reveal">
          <div class="j-cat-guide-art" aria-hidden="true">
            <span class="j-cat-guide-disc"></span>
            <Vector name={guide.art} />
          </div>
          <div class="j-cat-guide-body">
            <span class="j-cat-guide-eyebrow" data-i18n="cat.guide_eyebrow">Inside this range</span>
            <h2 id="catGuideTitle" data-i18n={`${gk}_title`}>{guide.title}</h2>
            <p class="j-cat-guide-intro" data-i18n={`${gk}_intro`}>{guide.intro}</p>
            <dl class="j-cat-guide-facts">
              <div><dt data-i18n="cat.guide_regions">Key growing belts</dt><dd data-i18n={`${gk}_regions`}>{guide.regions}</dd></div>
              <div><dt data-i18n="cat.guide_uses">Where it's used</dt><dd data-i18n={`${gk}_uses`}>{guide.uses}</dd></div>
              <div><dt data-i18n="cat.guide_shelf">Shelf life</dt><dd data-i18n={`cat.guide_shelf_${guide.shelf}`}>{guideShelf[guide.shelf]}</dd></div>
              <div><dt data-i18n="cat.guide_spec">What to tell us</dt><dd data-i18n={`${gk}_spec`}>{guide.spec}</dd></div>
            </dl>
            <button type="button" class="j-cat-guide-btn" data-open-enquire data-product="" data-category={cat.name}>
              <span data-i18n="cat.guide_cta">Enquire about this range</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
          </div>
        </div>
      </div>
    </section>
  )}

  <EnquiryDialog />
</BaseLayout>

<script>
  // On phones the category pills scroll sideways: start with the current one in view.
  const rail = document.querySelector<HTMLElement>(".j-cat-rail");
  const on = rail?.querySelector<HTMLElement>("a.on");
  if (rail && on && rail.scrollWidth > rail.clientWidth) rail.scrollLeft = on.offsetLeft - rail.offsetLeft - 16;
</script>
