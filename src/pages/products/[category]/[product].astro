---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EnquiryDialog from "../../../components/EnquiryDialog.astro";
import SpecSheetDialog from "../../../components/SpecSheetDialog.astro";
import { products, productsByCategory, getCategory, getProduct } from "../../../data/products";
import { SITE, UNAVAILABLE_PRODUCTS, COMING_SOON_PRODUCTS } from "../../../consts";

export function getStaticPaths() {
  return products.map((p) => ({ params: { category: p.category, product: p.slug } }));
}

const { category, product } = Astro.params;
const cat = getCategory(category)!;
const p = getProduct(product)!;
const related = productsByCategory(category).filter((x) => x.slug !== p.slug).slice(0, 4);
const isUnavailable = UNAVAILABLE_PRODUCTS.has(p.slug);
const isComingSoon = COMING_SOON_PRODUCTS.has(p.slug);
const isOut = isUnavailable || isComingSoon;
const stockLabel = isUnavailable ? "Currently Unavailable" : isComingSoon ? "Coming Soon" : "In stock · Ships within 14 days";
const stockI18n = isUnavailable ? "prod.stock_unavailable" : isComingSoon ? "prod.stock_coming_soon" : "prod.stock_in";

// Title and description are written for how B2B buyers actually search, not for
// how we file the product internally. The old title spent its opening words on
// the category and the HSN code — nobody types "HSN 1302 32 90" into Google,
// while "<product> exporter" and "<product> supplier india" are exactly the
// phrases sourcing managers use. Keywords are front-loaded because Google
// truncates the display around 60-65 characters but still indexes the whole
// string, so the words that matter have to come first.
const title = `${p.name} Exporter & Supplier in India | Clarté Overseas`;
const description = (
  `Bulk ${p.name.toLowerCase()} exporter and supplier from India. ${p.tagline} ` +
  `Food-grade, COA with every lot, trial quantities to full containers.`
).slice(0, 200);
const url = `${SITE.url}/products/${cat.slug}/${p.slug}`;

/* Buyer-intent Q&A — the questions that actually arrive by email and WhatsApp
   before a first order. Every answer matches what the rest of the site already
   states (7-day samples, 15-21 day dispatch, the seven registrations, 25kg
   kraft) so there is one story sitewide.

   Deliberately phrased WITHOUT the product name so each Q and A is a fixed
   string translated once as a shared i18n key (prod.faq1_q … prod.faq6_a),
   exactly like the About / Certifications / How-We-Export FAQs. Any new product,
   in any future category, gets the whole translated block for free. The product
   keyword still saturates the page — title, meta, H1, the H1 kicker, the
   breadcrumb, the spec table, the description, and the FAQ section heading,
   which keeps the name via a prefix/suffix split around a data-i18n span.

   This English array is also the source for the FAQPage JSON-LD below, which
   stays English to match the default (English) server render. */
const faqs = [
  { key: "faq1", q: "Which countries do you export to?", a: "We ship from India to buyers across the United States, United Kingdom, UAE and the wider Middle East, Australia and South East Asia, with documentation matched to each destination's import requirements." },
  { key: "faq2", q: "What is the minimum order quantity?", a: "We keep MOQs trial-friendly, so you can start with a small test quantity and scale to full container loads once the grade is proven in your formulation. Tell us the volume you are targeting and we will confirm what is workable." },
  { key: "faq3", q: "Can I get a sample before placing a bulk order?", a: "Yes. Representative samples are typically delivered within about 7 days, so you can check grade, colour, mesh and aroma against your own specification before committing to a shipment." },
  { key: "faq4", q: "What certifications and documents come with each shipment?", a: "Every consignment ships with a full COA and specification sheet. Clarté Overseas is registered for ISO 9001:2015, APEDA, the Spices Board of India (RCMC), FSSAI, Udyam (MSME), IEC and GST, and the standard export set covers the commercial invoice, packing list and certificate of origin." },
  { key: "faq5", q: "How is the product packed for export?", a: "25 kg kraft bags with a food-grade liner as standard. Custom pack sizes, retail packaging and private-label branding are available on request." },
  { key: "faq6", q: "How quickly is an order dispatched after it is confirmed?", a: "Bulk orders are dispatched in 15–21 days from a confirmed order. Ocean transit time on top of that depends on your destination port, and we share an indicative timeline with the quote." },
];

const DRYING_KEYS: Record<string, string> = {
  "Spray, freeze or drum-dried — to your grade": "prod.drying_fruit",
  "Air, spray or freeze-dried — to your grade": "prod.drying_culinary",
  "Shade, air or freeze-dried — to your grade": "prod.drying_herbal",
  "Mechanically milled to specification": "prod.drying_milled",
};
const dryingI18n = DRYING_KEYS[p.drying || ""] || "prod.drying_default";

const specs: [string, string, string, string?][] = [
  ["HSN code", p.hsn, "prod.spec_hsn"],
  ["Botanical name", p.botanical || "—", "prod.spec_botanical"],
  ["Available forms", p.forms ? p.forms.join(", ") : "Powder", "prod.spec_forms"],
  ["Processing", p.drying || "Dehydrated", "prod.spec_processing", dryingI18n],
  ["Shelf life", "18–24 months", "prod.spec_shelf", "prod.spec_shelf_value"],
  ["Packaging", "25 kg kraft bags with food-grade liner (custom packing available)", "prod.spec_packaging", "prod.spec_packaging_value"],
  ["MOQ", "Trial quantities available, scaling to full containers", "prod.spec_moq", "prod.spec_moq_value"],
  ["Origin", "India", "prod.spec_origin", "prod.origin_value"],
];

/* Product schema. Deliberately carries no `offers`, `price` or `aggregateRating`:
   we don't publish prices, and inventing a price or a review count to unlock a
   rich result would be fabricating data. What's here is everything we can state
   truthfully — origin, HSN, packing, MOQ posture, who it's sold to — which is
   what helps Google understand the page is a real B2B supply listing. */
const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.name,
  ...(p.image ? { image: [p.image] } : {}),
  description: p.description,
  category: cat.name,
  sku: p.slug,
  url,
  brand: { "@type": "Brand", name: SITE.name },
  countryOfOrigin: { "@type": "Country", name: "India" },
  audience: { "@type": "BusinessAudience", audienceType: "Food manufacturers, flavour houses, ingredient distributors and private-label brands" },
  additionalProperty: [
    { "@type": "PropertyValue", name: "HSN code", value: p.hsn },
    ...(p.botanical ? [{ "@type": "PropertyValue", name: "Botanical name", value: p.botanical }] : []),
    ...(p.forms?.length ? [{ "@type": "PropertyValue", name: "Available forms", value: p.forms.join(", ") }] : []),
    { "@type": "PropertyValue", name: "Country of origin", value: "India" },
    { "@type": "PropertyValue", name: "Packaging", value: "25 kg kraft bags with food-grade liner (custom packing available)" },
    { "@type": "PropertyValue", name: "Minimum order quantity", value: "Trial quantities available, scaling to full containers" },
    { "@type": "PropertyValue", name: "Shelf life", value: "18–24 months" },
  ],
};
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Products", item: `${SITE.url}/products` },
    { "@type": "ListItem", position: 3, name: cat.name, item: `${SITE.url}/products/${cat.slug}` },
    { "@type": "ListItem", position: 4, name: p.name, item: url },
  ],
};
---

<BaseLayout title={title} description={description} image={p.image || undefined}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <section class="pd-top" style={`--from:${cat.accentFrom};--to:${cat.accentTo}`}>
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <nav class="crumb text-sm reveal" aria-label="Breadcrumb">
        <a href="/" data-i18n="nav.home">Home</a> <span class="text-slate-300 mx-1">/</span>
        <a href="/products" data-i18n="nav.products">Products</a> <span class="text-slate-300 mx-1">/</span>
        <a href={`/products/${cat.slug}`} data-i18n={`products.cat_${cat.slug.replace(/-/g,'_')}_name`}>{cat.name}</a> <span class="text-slate-300 mx-1">/</span>
        <span class="text-slate-500" data-i18n={`cat.prod_${p.slug.replace(/-/g,'_')}_name`}>{p.name}</span>
      </nav>

      <div class="pd-grid">
        <!-- Media -->
        <div class="pd-media reveal">
          <span class="pd-cat-pill">{cat.emoji} <span data-i18n={`products.cat_${cat.slug.replace(/-/g,'_')}_name`}>{cat.name}</span></span>
          <div class={`pd-frame${p.image ? "" : " no-img"}`} id="pdFrame">
            {p.image
              ? <img src={p.image} alt={p.name} id="pdImg" class="pd-img" fetchpriority="high" />
              : <span class="pd-emoji">{p.emoji}</span>}
            {p.image && <span class="pd-zoom-hint"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg> <span data-i18n="prod.zoom_hint">Hover to zoom · click to enlarge</span></span>}
          </div>

          {p.forms && (
            <div class="pd-forms">
              <span class="pd-forms-label" data-i18n="prod.available_in">Available in</span>
              <div class="pd-forms-toggle" role="tablist">
                {p.forms.map((f, i) => (
                  <button type="button" class={`pd-form-btn${i === 0 ? " active" : ""}`} data-form={f}>{f}</button>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Info -->
        <div class="pd-info reveal d1">
          <!-- The kicker is a real, visible second line, not hidden keyword text:
               the H1 is the strongest on-page signal Google reads, and every
               competitor ranking for "<product> exporter" says so in theirs. The
               product name keeps its own span so data-i18n (which overwrites
               textContent) can't wipe the kicker. -->
          <h1 class="pd-title">
            <span data-i18n={`cat.prod_${p.slug.replace(/-/g,'_')}_name`}>{p.name}</span>
            <span class="pd-title-kicker" data-i18n="prod.title_kicker">Exporter &amp; Bulk Supplier in India</span>
          </h1>
          {p.botanical && <p class="pd-botanical">{p.botanical}</p>}
          <p class="pd-tagline" data-i18n={`cat.prod_${p.slug.replace(/-/g,'_')}_tagline`}>{p.tagline}</p>
          <div class="pd-chips">
            <span class="pd-chip pd-chip-hsn">HSN {p.hsn}</span>
            {p.grades.slice(0, 2).map((g, i) => <span class="pd-chip" data-i18n={`prod.${p.slug.replace(/-/g,'_')}_g${i+1}`}>{g}</span>)}
          </div>
          <p class="pd-desc" data-i18n={`prod.${p.slug.replace(/-/g,'_')}_desc`}>{p.description}</p>

          <div class={`pd-stock${isUnavailable ? " pd-stock-unavail" : isComingSoon ? " pd-stock-out" : ""}`}>
            <span class={isUnavailable ? "pd-stock-dot-unavail" : isComingSoon ? "pd-stock-dot-out" : "pd-stock-dot"} aria-hidden="true"></span>
            <span data-i18n={stockI18n}>{stockLabel}</span>
          </div>

          <div class="pd-cta">
            <button type="button" class="btn btn-primary" data-open-enquire data-product={p.name} data-category={cat.name}>
              <span data-i18n="prod.enquire_btn">Enquire / Request a quote</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
            <a href="#" data-wa data-wa-msg="Hi Clarté Overseas, I'm interested in your {product} — could you share pricing, MOQ and availability?" data-wa-product={p.name} class="btn btn-wa">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
              <span data-i18n="prod.whatsapp_btn">WhatsApp</span>
            </a>
          </div>
          <button type="button" class="btn-sample-req" data-open-enquire data-is-sample="true" data-product={p.name} data-category={cat.name}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
            <span data-i18n="prod.sample_req_btn">Request a Free Sample</span>
          </button>

          <!-- quick specs -->
          <dl class="pd-quickspec">
            <div><dt data-i18n="prod.quickspec_form">Form selected</dt><dd id="pdSelForm">{p.forms ? p.forms[0] : "Powder"}</dd></div>
            <div><dt data-i18n="prod.quickspec_processing">Processing</dt><dd data-i18n={dryingI18n}>{p.drying || "Dehydrated"}</dd></div>
            <div><dt data-i18n="prod.quickspec_origin">Origin</dt><dd data-i18n="prod.origin_value">India</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== DETAILS ===================== -->
  <section class="py-14 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 grid lg:grid-cols-3 gap-10 lg:gap-14">
      <div class="lg:col-span-2 space-y-10">
        <div class="reveal">
          <h2 class="pd-h2" data-i18n="prod.features_heading">Key features</h2>
          <div class="pd-feat-grid">
            {p.features.map((f, i) => (
              <div class="pd-feat">
                <span class="pd-feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg></span>
                <span data-i18n={`prod.${p.slug.replace(/-/g,'_')}_f${i+1}`}>{f}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="reveal">
          <h2 class="pd-h2" data-i18n="prod.uses_heading">Where it's used</h2>
          <div class="pd-use-grid">
            {p.uses.map((u, i) => <span class="pd-use" data-i18n={`prod.${p.slug.replace(/-/g,'_')}_u${i+1}`}>{u}</span>)}
          </div>
        </div>

        <div class="reveal">
          <h2 class="pd-h2" data-i18n="prod.grades_heading">Typical grades</h2>
          <div class="pd-use-grid">
            {p.grades.map((g, i) => <span class="pd-grade" data-i18n={`prod.${p.slug.replace(/-/g,'_')}_g${i+1}`}>{g}</span>)}
          </div>
        </div>
      </div>

      <!-- spec sidebar -->
      <aside class="reveal d1">
        <div class="pd-spec-card">
          <h2 class="pd-spec-title" data-i18n="prod.spec_heading">Specifications</h2>
          <dl class="pd-spec">
            {specs.map(([k, v, i18nKey, vKey]) => (
              <div class="pd-spec-row"><dt data-i18n={i18nKey}>{k}</dt><dd data-i18n={vKey}>{v}</dd></div>
            ))}
          </dl>
          <!-- Product-specific spec sheet (PDF) — lead-gated download -->
          <div class="pd-speclock">
            <div class="pd-speclock-doc" aria-hidden="true">
              <span class="pd-speclock-band">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                <span data-i18n="prod.spec_card_label">Technical Data Sheet</span>
              </span>
              <div class="pd-speclock-rows">
                <span class="l w75"></span><span class="l w40"></span>
                <span class="l w90"></span><span class="l w55"></span>
                <span class="l w80"></span><span class="l w35"></span>
                <span class="l w65"></span><span class="l w50"></span>
              </div>
              <div class="pd-speclock-frost">
                <span class="pd-speclock-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                </span>
              </div>
            </div>
            <div class="pd-speclock-cap">
              <span class="pd-speclock-title">{p.name} <span data-i18n="prod.spec_sheet_word">spec sheet</span></span>
              <span class="pd-speclock-sub" data-i18n="prod.spec_pdf_sub">PDF · full technical data sheet</span>
            </div>
            <button type="button" class="pd-spec-btn primary pd-speclock-btn" data-open-specsheet data-slug={p.slug} data-product={p.name} data-category={cat.name} aria-label={`Download ${p.name} spec sheet`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
              <span class="pd-spec-btn-label" data-i18n="prod.spec_download_btn">Download spec sheet</span>
            </button>
            <span class="pd-speclock-note" data-i18n="prod.spec_free_note">Free · share a few details to unlock the PDF</span>
          </div>

          <button type="button" class="btn btn-primary w-full mt-4" data-open-enquire data-product={p.name} data-category={cat.name}><span data-i18n="prod.get_pricing">Get pricing &amp; samples</span></button>
          <p class="pd-spec-note" data-i18n="prod.spec_note">Specs are indicative and can be tailored to your formulation. Full COA and spec sheet shared on request.</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ===================== SOURCING FAQ =====================
       Carries the sourcing language buyers search with ("exporter", "bulk
       supplier", "MOQ", "from India") as genuine answers rather than as a
       keyword list, and gives the page the depth the directory listings that
       currently outrank us have. Answers are kept in step with the rest of the
       site — same 7-day samples, 15-21 day dispatch and registration list. -->
  <section class="py-14 lg:py-16 pd-faq-section">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="reveal">
        <span class="eyebrow" data-i18n="prod.faq_eyebrow">Sourcing</span>
        <!-- The heading keeps the product name for SEO; prefix and suffix are
             separate i18n keys so each language can put the noun where its
             grammar needs it, and the name keeps its own data-i18n span so
             textContent replacement can't wipe the wrapper. -->
        <h2 class="tg-1 tg-script tg-script--sm font-extrabold text-2xl sm:text-3xl mt-3">
          <span data-i18n="prod.faq_heading_a">Buying </span><span data-i18n={`cat.prod_${p.slug.replace(/-/g,'_')}_name`}>{p.name}</span><span data-i18n="prod.faq_heading_b"> from India</span>
        </h2>
        <p class="text-slate-500 mt-4 leading-relaxed" data-i18n="prod.faq_intro">
          Clarté Overseas is an India-based merchant exporter and bulk supplier of dehydrated food
          ingredients, shipping food-grade material to manufacturers, flavour houses, nutraceutical
          brands and ingredient distributors worldwide. Below are the questions buyers ask most before
          a first order.
        </p>
      </div>

      <div class="mt-8 reveal d1">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>
              <span data-i18n={`prod.${f.key}_q`}>{f.q}</span>
              <svg class="chev w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="faq-body" data-i18n={`prod.${f.key}_a`}>{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== RELATED ===================== -->
  {related.length > 0 && (
    <section class="py-14 lg:py-16 bg-cream">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4 mb-8 reveal">
          <h2 class="tg-1 tg-script tg-script--sm font-extrabold text-2xl sm:text-3xl"><span data-i18n="prod.related_prefix">More from</span> <span data-i18n={`products.cat_${cat.slug.replace(/-/g,'_')}_name`}>{cat.name}</span></h2>
          <a href={`/products/${cat.slug}`} class="read-link"><span data-i18n="prod.view_all">View all</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        <div class="prod-grid">
          {related.map((r) => (
            <article class="prod-card reveal" style={`--from:${cat.accentFrom};--to:${cat.accentTo}`}>
              <a href={`/products/${cat.slug}/${r.slug}`} class="prod-media" aria-label={r.name}>
                <span class="prod-media-tint" aria-hidden="true"></span>
                {r.image ? <img src={r.image} alt={r.name} loading="lazy" /> : <span class="prod-emoji">{r.emoji}</span>}
              </a>
              <div class="prod-body">
                <span class="prod-hsn">HSN {r.hsn}</span>
                <h3 class="prod-name"><a href={`/products/${cat.slug}/${r.slug}`} data-i18n={`cat.prod_${r.slug.replace(/-/g,'_')}_name`}>{r.name}</a></h3>
                <p class="prod-tag" data-i18n={`cat.prod_${r.slug.replace(/-/g,'_')}_tagline`}>{r.tagline}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <EnquiryDialog />
  <SpecSheetDialog />

  <!-- Lightbox -->
  {p.image && (
    <div class="pd-lightbox" id="pdLightbox" hidden>
      <button type="button" class="pd-lb-close" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      <img src={p.image} alt={p.name} class="pd-lb-img" id="pdLbImg" />
    </div>
  )}
</BaseLayout>

<script>
  // ---- Variety toggle ----
  const formBtns = document.querySelectorAll(".pd-form-btn");
  const selForm = document.getElementById("pdSelForm");
  formBtns.forEach((b) =>
    b.addEventListener("click", () => {
      formBtns.forEach((x) => x.classList.remove("active"));
      b.classList.add("active");
      if (selForm) selForm.textContent = b.getAttribute("data-form");
    })
  );

  // ---- Hover-zoom on the framed image ----
  const frame = document.getElementById("pdFrame");
  const img = document.getElementById("pdImg") as HTMLImageElement | null;
  if (frame && img) {
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    if (fine) {
      frame.addEventListener("pointermove", (e) => {
        const r = frame.getBoundingClientRect();
        const x = ((e.clientX - r.left) / r.width) * 100;
        const y = ((e.clientY - r.top) / r.height) * 100;
        img.style.transformOrigin = `${x}% ${y}%`;
        img.style.transform = "scale(2.1)";
      });
      frame.addEventListener("pointerleave", () => { img.style.transform = "scale(1)"; });
    }
    // ---- Click to enlarge (lightbox) ----
    const lb = document.getElementById("pdLightbox");
    if (lb) {
      const closeLb = () => { lb.hidden = true; document.body.style.overflow = ""; };
      frame.addEventListener("click", () => { lb.hidden = false; document.body.style.overflow = "hidden"; });
      lb.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest(".pd-lb-close") || e.target === lb) closeLb(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !lb.hidden) closeLb(); });
    }
  }
</script>
