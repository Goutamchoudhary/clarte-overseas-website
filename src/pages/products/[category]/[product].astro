---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EnquiryDialog from "../../../components/EnquiryDialog.astro";
import { products, productsByCategory, getCategory, getProduct } from "../../../data/products";
import { SITE, UNAVAILABLE_PRODUCTS } from "../../../consts";

export function getStaticPaths() {
  return products.map((p) => ({ params: { category: p.category, product: p.slug } }));
}

const { category, product } = Astro.params;
const cat = getCategory(category)!;
const p = getProduct(product)!;
const related = productsByCategory(category).filter((x) => x.slug !== p.slug).slice(0, 4);
const isUnavailable = UNAVAILABLE_PRODUCTS.has(p.slug);

const title = `${p.name} — ${cat.name} | HSN ${p.hsn} | Clarté Overseas`;
const description = `${p.tagline} ${p.description}`.slice(0, 180);
const url = `${SITE.url}/products/${cat.slug}/${p.slug}`;

const DRYING_KEYS: Record<string, string> = {
  "Spray, freeze or drum-dried — to your grade": "prod.drying_fruit",
  "Air, spray or freeze-dried — to your grade": "prod.drying_culinary",
  "Shade, air or freeze-dried — to your grade": "prod.drying_herbal",
  "Mechanically milled to specification": "prod.drying_milled",
};
const dryingI18n = DRYING_KEYS[p.drying || ""] || "prod.drying_default";

const specs: [string, string, string, string?][] = [
  ["HSN code", p.hsn, "prod.spec_hsn"],
  ["Botanical name", p.botanical || "—", "prod.spec_botanical"],
  ["Available forms", p.forms ? p.forms.join(", ") : "Powder", "prod.spec_forms"],
  ["Processing", p.drying || "Dehydrated", "prod.spec_processing", dryingI18n],
  ["Shelf life", "18–24 months", "prod.spec_shelf", "prod.spec_shelf_value"],
  ["Packaging", "25 kg kraft bags with food-grade liner (custom packing available)", "prod.spec_packaging", "prod.spec_packaging_value"],
  ["MOQ", "Trial quantities available, scaling to full containers", "prod.spec_moq", "prod.spec_moq_value"],
  ["Origin", "India", "prod.spec_origin", "prod.origin_value"],
];

const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.name,
  ...(p.image ? { image: [p.image] } : {}),
  description: p.description,
  category: cat.name,
  brand: { "@type": "Brand", name: SITE.name },
  ...(p.botanical ? { additionalProperty: [
    { "@type": "PropertyValue", name: "HSN code", value: p.hsn },
    { "@type": "PropertyValue", name: "Botanical name", value: p.botanical },
  ] } : { additionalProperty: [{ "@type": "PropertyValue", name: "HSN code", value: p.hsn }] }),
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Products", item: `${SITE.url}/products` },
    { "@type": "ListItem", position: 3, name: cat.name, item: `${SITE.url}/products/${cat.slug}` },
    { "@type": "ListItem", position: 4, name: p.name, item: url },
  ],
};
---

<BaseLayout title={title} description={description} image={p.image || undefined}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <section class="pd-top" style={`--from:${cat.accentFrom};--to:${cat.accentTo}`}>
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <nav class="crumb text-sm reveal" aria-label="Breadcrumb">
        <a href="/" data-i18n="nav.home">Home</a> <span class="text-slate-300 mx-1">/</span>
        <a href="/products" data-i18n="nav.products">Products</a> <span class="text-slate-300 mx-1">/</span>
        <a href={`/products/${cat.slug}`} data-i18n={`products.cat_${cat.slug.replace(/-/g,'_')}_name`}>{cat.name}</a> <span class="text-slate-300 mx-1">/</span>
        <span class="text-slate-500" data-i18n={`cat.prod_${p.slug.replace(/-/g,'_')}_name`}>{p.name}</span>
      </nav>

      <div class="pd-grid">
        <!-- Media -->
        <div class="pd-media reveal">
          <span class="pd-cat-pill">{cat.emoji} <span data-i18n={`products.cat_${cat.slug.replace(/-/g,'_')}_name`}>{cat.name}</span></span>
          <div class={`pd-frame${p.image ? "" : " no-img"}`} id="pdFrame">
            {p.image
              ? <img src={p.image} alt={p.name} id="pdImg" class="pd-img" />
              : <span class="pd-emoji">{p.emoji}</span>}
            {p.image && <span class="pd-zoom-hint"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg> <span data-i18n="prod.zoom_hint">Hover to zoom · click to enlarge</span></span>}
          </div>

          {p.forms && (
            <div class="pd-forms">
              <span class="pd-forms-label" data-i18n="prod.available_in">Available in</span>
              <div class="pd-forms-toggle" role="tablist">
                {p.forms.map((f, i) => (
                  <button type="button" class={`pd-form-btn${i === 0 ? " active" : ""}`} data-form={f}>{f}</button>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Info -->
        <div class="pd-info reveal d1">
          <h1 class="pd-title" data-i18n={`cat.prod_${p.slug.replace(/-/g,'_')}_name`}>{p.name}</h1>
          {p.botanical && <p class="pd-botanical">{p.botanical}</p>}
          <p class="pd-tagline" data-i18n={`cat.prod_${p.slug.replace(/-/g,'_')}_tagline`}>{p.tagline}</p>
          <div class="pd-chips">
            <span class="pd-chip pd-chip-hsn">HSN {p.hsn}</span>
            {p.grades.slice(0, 2).map((g, i) => <span class="pd-chip" data-i18n={`prod.${p.slug.replace(/-/g,'_')}_g${i+1}`}>{g}</span>)}
          </div>
          <p class="pd-desc" data-i18n={`prod.${p.slug.replace(/-/g,'_')}_desc`}>{p.description}</p>

          <div class={`pd-stock${isUnavailable ? " pd-stock-out" : ""}`}>
            <span class={isUnavailable ? "pd-stock-dot-out" : "pd-stock-dot"} aria-hidden="true"></span>
            <span>{isUnavailable ? "Coming Soon" : "In stock · Ships within 14 days"}</span>
          </div>

          <div class="pd-cta">
            <button type="button" class="btn btn-primary" data-open-enquire data-product={p.name} data-category={cat.name}>
              <span data-i18n="prod.enquire_btn">Enquire / Request a quote</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
            <a href="#" data-wa data-wa-msg="Hi Clarté Overseas, I'm interested in your {product} — could you share pricing, MOQ and availability?" data-wa-product={p.name} class="btn btn-wa">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
              <span data-i18n="prod.whatsapp_btn">WhatsApp</span>
            </a>
          </div>
          <button type="button" class="btn-sample-req" data-open-enquire data-is-sample="true" data-product={p.name} data-category={cat.name}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
            Request a Free Sample
          </button>

          <!-- quick specs -->
          <dl class="pd-quickspec">
            <div><dt data-i18n="prod.quickspec_form">Form selected</dt><dd id="pdSelForm">{p.forms ? p.forms[0] : "Powder"}</dd></div>
            <div><dt data-i18n="prod.quickspec_processing">Processing</dt><dd data-i18n={dryingI18n}>{p.drying || "Dehydrated"}</dd></div>
            <div><dt data-i18n="prod.quickspec_origin">Origin</dt><dd data-i18n="prod.origin_value">India</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== DETAILS ===================== -->
  <section class="py-14 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 grid lg:grid-cols-3 gap-10 lg:gap-14">
      <div class="lg:col-span-2 space-y-10">
        <div class="reveal">
          <h2 class="pd-h2" data-i18n="prod.features_heading">Key features</h2>
          <div class="pd-feat-grid">
            {p.features.map((f, i) => (
              <div class="pd-feat">
                <span class="pd-feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg></span>
                <span data-i18n={`prod.${p.slug.replace(/-/g,'_')}_f${i+1}`}>{f}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="reveal">
          <h2 class="pd-h2" data-i18n="prod.uses_heading">Where it's used</h2>
          <div class="pd-use-grid">
            {p.uses.map((u, i) => <span class="pd-use" data-i18n={`prod.${p.slug.replace(/-/g,'_')}_u${i+1}`}>{u}</span>)}
          </div>
        </div>

        <div class="reveal">
          <h2 class="pd-h2" data-i18n="prod.grades_heading">Typical grades</h2>
          <div class="pd-use-grid">
            {p.grades.map((g, i) => <span class="pd-grade" data-i18n={`prod.${p.slug.replace(/-/g,'_')}_g${i+1}`}>{g}</span>)}
          </div>
        </div>
      </div>

      <!-- spec sidebar -->
      <aside class="reveal d1">
        <div class="pd-spec-card">
          <h2 class="pd-spec-title" data-i18n="prod.spec_heading">Specifications</h2>
          <dl class="pd-spec">
            {specs.map(([k, v, i18nKey, vKey]) => (
              <div class="pd-spec-row"><dt data-i18n={i18nKey}>{k}</dt><dd data-i18n={vKey}>{v}</dd></div>
            ))}
          </dl>
          <button type="button" class="btn btn-primary w-full mt-5" data-open-enquire data-product={p.name} data-category={cat.name}><span data-i18n="prod.get_pricing">Get pricing &amp; samples</span></button>
          <p class="pd-spec-note" data-i18n="prod.spec_note">Specs are indicative and can be tailored to your formulation. Full COA and spec sheet shared on request.</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ===================== RELATED ===================== -->
  {related.length > 0 && (
    <section class="py-14 lg:py-16 bg-cream">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4 mb-8 reveal">
          <h2 class="tg-1 font-extrabold text-2xl sm:text-3xl"><span data-i18n="prod.related_prefix">More from</span> <span data-i18n={`products.cat_${cat.slug.replace(/-/g,'_')}_name`}>{cat.name}</span></h2>
          <a href={`/products/${cat.slug}`} class="read-link"><span data-i18n="prod.view_all">View all</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        <div class="prod-grid">
          {related.map((r) => (
            <article class="prod-card reveal" style={`--from:${cat.accentFrom};--to:${cat.accentTo}`}>
              <a href={`/products/${cat.slug}/${r.slug}`} class="prod-media" aria-label={r.name}>
                <span class="prod-media-tint" aria-hidden="true"></span>
                {r.image ? <img src={r.image} alt={r.name} loading="lazy" /> : <span class="prod-emoji">{r.emoji}</span>}
              </a>
              <div class="prod-body">
                <span class="prod-hsn">HSN {r.hsn}</span>
                <h3 class="prod-name"><a href={`/products/${cat.slug}/${r.slug}`} data-i18n={`cat.prod_${r.slug.replace(/-/g,'_')}_name`}>{r.name}</a></h3>
                <p class="prod-tag" data-i18n={`cat.prod_${r.slug.replace(/-/g,'_')}_tagline`}>{r.tagline}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <EnquiryDialog />

  <!-- Lightbox -->
  {p.image && (
    <div class="pd-lightbox" id="pdLightbox" hidden>
      <button type="button" class="pd-lb-close" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      <img src={p.image} alt={p.name} class="pd-lb-img" id="pdLbImg" />
    </div>
  )}
</BaseLayout>

<script>
  // ---- Variety toggle ----
  const formBtns = document.querySelectorAll(".pd-form-btn");
  const selForm = document.getElementById("pdSelForm");
  formBtns.forEach((b) =>
    b.addEventListener("click", () => {
      formBtns.forEach((x) => x.classList.remove("active"));
      b.classList.add("active");
      if (selForm) selForm.textContent = b.getAttribute("data-form");
    })
  );

  // ---- Hover-zoom on the framed image ----
  const frame = document.getElementById("pdFrame");
  const img = document.getElementById("pdImg") as HTMLImageElement | null;
  if (frame && img) {
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    if (fine) {
      frame.addEventListener("pointermove", (e) => {
        const r = frame.getBoundingClientRect();
        const x = ((e.clientX - r.left) / r.width) * 100;
        const y = ((e.clientY - r.top) / r.height) * 100;
        img.style.transformOrigin = `${x}% ${y}%`;
        img.style.transform = "scale(2.1)";
      });
      frame.addEventListener("pointerleave", () => { img.style.transform = "scale(1)"; });
    }
    // ---- Click to enlarge (lightbox) ----
    const lb = document.getElementById("pdLightbox");
    if (lb) {
      const closeLb = () => { lb.hidden = true; document.body.style.overflow = ""; };
      frame.addEventListener("click", () => { lb.hidden = false; document.body.style.overflow = "hidden"; });
      lb.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest(".pd-lb-close") || e.target === lb) closeLb(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !lb.hidden) closeLb(); });
    }
  }
</script>
