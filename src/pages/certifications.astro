---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SlantDivider from "../components/SlantDivider.astro";

const title = "Certifications & Compliance — Clarté Overseas | Verified Export Credentials";
const description =
  "View and download Clarté Overseas's certifications and registrations — GST, IEC, Udyam (MSME), FSSAI, APEDA and ISO 9001:2015 — plus the food-safety standards upheld across our partner facilities.";

// Company-held credentials — each has a downloadable certificate (hosted copy).
const companyCerts = [
  {
    name: "FSSAI Central Licence",
    authority: "Food Safety & Standards Authority of India",
    tag: "Food safety",
    desc: "Our Central FSSAI licence certifies that Clarté Overseas operates within India's food-safety law as a trader and exporter of food products — your assurance that everything we handle is managed to regulation.",
    file: "https://lsmedia.linker-cdn.net/1059756/2026/14898318.png",
    kind: "Image",
    svg: '<path d="M12 2 4 5v6c0 5 3.4 8.4 8 9 4.6-.6 8-4 8-9V5l-8-3z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    name: "IEC — Import Export Code",
    authority: "DGFT, Ministry of Commerce & Industry",
    tag: "Export licence",
    desc: "The Importer-Exporter Code is the licence that authorises us to move goods across India's borders. No consignment leaves the country without it — and ours is active and in our own name.",
    file: "https://lsmedia.linker-cdn.net/1059756/2026/14801920.pdf",
    kind: "PDF",
    svg: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/>',
  },
  {
    name: "APEDA Registration",
    authority: "Agricultural & Processed Food Products Export Dev. Authority",
    tag: "Agri-export",
    desc: "Registration with APEDA, and the Registration-cum-Membership Certificate it carries, marks us as a recognised exporter of agricultural and processed food products across all of our ingredient categories.",
    file: "https://lsmedia.linker-cdn.net/1059756/2026/14878220.pdf",
    kind: "PDF",
    svg: '<path d="M12 2v20"/><path d="M12 8c-3 0-5-2-5-5 3 0 5 2 5 5z"/><path d="M12 8c3 0 5-2 5-5-3 0-5 2-5 5z"/><path d="M12 14c-3 0-5-2-5-5 3 0 5 2 5 5z"/><path d="M12 14c3 0 5-2 5-5-3 0-5 2-5 5z"/>',
  },
  {
    name: "ISO 9001:2015",
    authority: "Quality Management System",
    tag: "Quality",
    desc: "ISO 9001:2015 certification shows our quality-management system is documented, audited and built for consistency — the same disciplined process that sits behind every single order.",
    file: "https://lsmedia.linker-cdn.net/1059756/2026/14918555.pdf",
    kind: "PDF",
    svg: '<circle cx="12" cy="9" r="6"/><path d="M9 14.5 7 22l5-3 5 3-2-7.5"/>',
  },
  {
    name: "GST Registration",
    authority: "Government of India",
    tag: "Tax registered",
    desc: "Our Goods & Services Tax registration confirms Clarté Overseas as a compliant, tax-registered business entity in India — the baseline every legitimate exporter is expected to hold.",
    file: "https://lsmedia.linker-cdn.net/1059756/2026/14801919.pdf",
    kind: "PDF",
    svg: '<path d="M5 3h14a1 1 0 0 1 1 1v17l-3-2-3 2-3-2-3 2V4a1 1 0 0 1 1-1z"/><path d="M9 8h6M9 12h6"/>',
  },
  {
    name: "Udyam (MSME)",
    authority: "Ministry of Micro, Small & Medium Enterprises",
    tag: "Registered enterprise",
    desc: "Our Udyam registration recognises Clarté Overseas under India's MSME framework, supporting priority access to trade-facilitation and finance schemes for growing exporters.",
    file: "https://lsmedia.linker-cdn.net/1059756/2026/14878221.pdf",
    kind: "PDF",
    svg: '<path d="M3 21h18M5 21V8l7-5 7 5v13"/><path d="M9 21v-6h6v6"/>',
  },
];

// Standards upheld across our vetted partner facilities — shown for context, no download.
const partnerStandards = [
  {
    name: "ISO 22000",
    line: "Food safety management",
    desc: "A food-safety management standard that layers HACCP principles over a full management system — applied at the facilities that process our ingredients.",
    svg: '<path d="M12 2 4 5v6c0 5 3.4 8.4 8 9 4.6-.6 8-4 8-9V5l-8-3z"/>',
  },
  {
    name: "HACCP",
    line: "Hazard control",
    desc: "Hazard Analysis & Critical Control Points: the preventive framework that identifies and controls food-safety risks at each step of processing.",
    svg: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 11 2 2 4-4"/>',
  },
  {
    name: "BRCGS",
    line: "Retail-grade standard",
    desc: "A GFSI-recognised global standard for food safety and quality, widely required by retailers and brand owners across Europe and beyond.",
    svg: '<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>',
  },
  {
    name: "US FDA",
    line: "United States access",
    desc: "Partner facilities supplying US-bound product maintain US FDA food-facility registration, as required for import into the United States.",
    svg: '<path d="M4 6h16M4 12h16M4 18h10"/><path d="M18 16l2 2 3-3"/>',
  },
  {
    name: "Halal",
    line: "Faith-based markets",
    desc: "Halal certification at partner units for buyers serving Muslim-majority markets and communities — arranged per requirement.",
    svg: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 1 0 9.8 9.8z"/>',
  },
  {
    name: "Kosher",
    line: "Specialist supply",
    desc: "Kosher certification available through partner facilities for buyers with kosher supply requirements in their market.",
    svg: '<path d="M12 2v20M5 5l14 14M19 5 5 19"/>',
  },
];

const certFaqs = [
  {
    q: "Can I see your certificates before placing an order?",
    a: "Yes. Every company credential on this page can be downloaded directly — the files are the actual certificates issued in Clarté Overseas's name. We are also happy to share fresh copies or answer specific compliance questions over email or WhatsApp.",
  },
  {
    q: "Are these registrations held in the company's own name?",
    a: "They are. GST, IEC, Udyam (MSME), FSSAI, APEDA and ISO 9001:2015 are all registered to Clarté Overseas — not borrowed from a third party. The downloadable copies show exactly that.",
  },
  {
    q: "Do your products carry food-safety certification?",
    a: "We hold a Central FSSAI licence as a food exporter, and the manufacturing facilities we work with operate to recognised standards such as ISO 22000, HACCP and BRCGS. Facility-level certificates can be provided per order on request.",
  },
  {
    q: "Can you supply Halal or Kosher certified product?",
    a: "Yes, through partner facilities that hold the relevant certification. Tell us the product, your market and the certifying body you need, and we will confirm availability before you commit.",
  },
  {
    q: "What documents ship with my order?",
    a: "A typical export set includes the commercial invoice, packing list and certificate of origin, along with the product specification, lab/analysis reports and any market-specific certificates your importer requires.",
  },
  {
    q: "Can you meet a specific importing country's certification requirement?",
    a: "Often, yes. Share the destination country and the requirement, and we will tell you what is feasible, what documentation is involved and how we would arrange it through our network.",
  },
  {
    q: "Is your quality system independently audited?",
    a: "Yes. We run an ISO 9001:2015 quality-management system and carry out quality control and lab testing on every lot, with full batch traceability from source to dispatch.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: certFaqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <!-- ===================== HERO ===================== -->
  <PageHero
    crumb="Certifications"
    eyebrow="Compliance & Trust"
    watermark="Trust"
    heading="Credentials you can<br class='hidden sm:block'/> open, read and verify"
    subtitle="We would rather show our paperwork than talk about it. Every registration and licence below is held in Clarté Overseas's own name — download the actual certificate and check it for yourself."
    chips={["6 verifiable certificates", "All in our own name", "ISO 9001:2015 certified"]}
  />

  <!-- ===================== COMPANY CREDENTIALS (downloadable) ===================== -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-2xl reveal">
        <span class="eyebrow">Our Credentials</span>
        <h2 class="tg-1 font-extrabold text-3xl sm:text-4xl mt-4 leading-tight">Registered, licensed, downloadable</h2>
        <p class="text-slate-500 text-lg mt-4">Hover a card to inspect it, then download the certificate. These are the documents that let us trade and that buyers ask for first.</p>
      </div>

      <div class="cred-grid mt-12">
        {companyCerts.map((c, i) => (
          <article class={`cred-card reveal d${(i % 3) + 1}`} data-tilt>
            <span class="cred-shine" aria-hidden="true"></span>
            <div class="cred-top">
              <span class="cred-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={c.svg} />
              </span>
              <span class="verified">
                <svg class="vcheck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                Verified
              </span>
            </div>
            <h3 class="cred-name">{c.name}</h3>
            <p class="cred-auth">{c.authority}</p>
            <p class="cred-desc">{c.desc}</p>
            <div class="cred-actions">
              <a href={c.file} target="_blank" rel="noopener" class="cred-dl" download>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16"/></svg>
                Download
              </a>
              <a href={c.file} target="_blank" rel="noopener" class="cred-view">
                View <span class="cred-kind">{c.kind}</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <p class="text-slate-400 text-sm mt-9 flex items-center gap-2">
        <svg class="w-4 h-4 text-brand/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        Files open in a new tab. Need a stamped or more recent copy for your records? Just ask.
      </p>
    </div>
  </section>

  <SlantDivider topColor="#ffffff" bottomColor="#f6f9ff" />

  <!-- ===================== PARTNER / FACILITY STANDARDS (no download) ===================== -->
  <section class="py-20 lg:py-24 std-section">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="eyebrow center">Across Our Network</span>
        <h2 class="tg-5 font-extrabold text-3xl sm:text-4xl mt-4">Standards held by our partner facilities</h2>
        <p class="text-slate-500 text-lg mt-4">Beyond our own licences, the manufacturers we work with operate to internationally recognised food-safety standards. Open a panel to see what each one means.</p>
      </div>

      <div class="std-rail mt-12 reveal d1" id="stdRail">
        {partnerStandards.map((s, i) => (
          <div class={`std-panel${i === 0 ? " open" : ""}`} tabindex="0" role="button" aria-expanded={i === 0 ? "true" : "false"}>
            <span class="std-index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div class="std-body">
              <div class="std-head">
                <span class="std-ico">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg} />
                </span>
                <div class="std-title">
                  <span class="std-name">{s.name}</span>
                  <span class="std-line">{s.line}</span>
                </div>
              </div>
              <p class="std-desc">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="text-center text-slate-400 text-sm mt-9 max-w-2xl mx-auto">
        These certifications are maintained by our vetted manufacturing partners and apply at the facility level. We confirm and arrange the exact certification your order and market require — facility certificates are shared on request.
      </p>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center reveal">
        <span class="eyebrow center">FAQ</span>
        <h2 class="tg-2 font-extrabold text-3xl sm:text-4xl mt-4">Certifications &amp; compliance, answered</h2>
        <p class="text-slate-500 text-lg mt-4">The questions buyers ask most when they check who they are dealing with.</p>
      </div>
      <div class="mt-12 reveal d1">
        {certFaqs.map((f) => (
          <details class="faq-item">
            <summary>
              {f.q}
              <svg class="chev w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="faq-body">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section id="quote" class="py-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="hero rounded-[2rem] px-8 py-16 sm:px-16 text-center relative overflow-hidden">
        <h2 class="text-white font-extrabold text-3xl sm:text-5xl reveal">Compliance sorted. Let's talk product.</h2>
        <p class="text-slate-300 text-lg mt-5 max-w-xl mx-auto reveal d1">Tell us what you need and where it is headed. We'll reply with specs, samples and the certificates your market calls for.</p>
        <div class="flex flex-wrap justify-center gap-4 mt-9 reveal d2">
          <a href="#" data-wa class="btn btn-wa">Chat on WhatsApp
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
          </a>
          <a href="/contact" class="btn btn-ghost">Enquire Us</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ====================== CERTIFICATIONS PAGE ====================== */

  /* ---- Credential cards (cursor-tilt + holographic sheen) ---- */
  .cred-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.4rem; }
  .cred-card {
    position: relative; overflow: hidden; border-radius: 1.25rem;
    background: #fff; border: 1px solid #e7edf7; padding: 1.7rem 1.6rem 1.5rem;
    box-shadow: 0 14px 34px -22px rgba(31,70,147,.4);
    transform: perspective(950px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateZ(0);
    transition: transform .2s ease, box-shadow .35s ease, border-color .35s ease;
    will-change: transform;
  }
  .cred-card:hover { box-shadow: 0 30px 60px -26px rgba(31,70,147,.55); border-color: #cfddf5; }
  .cred-card::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: radial-gradient(440px circle at var(--mx,50%) var(--my,0%), rgba(31,70,147,.12), transparent 45%);
    transition: opacity .3s ease;
  }
  .cred-card:hover::before { opacity: 1; }
  .cred-shine {
    position: absolute; top: 0; left: -120%; width: 70%; height: 100%; pointer-events: none;
    transform: skewX(-18deg);
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.55), transparent);
    opacity: 0; transition: opacity .2s;
  }
  .cred-card:hover .cred-shine { opacity: 1; animation: cred-sheen 1s ease; }
  @keyframes cred-sheen { from { left: -120%; } to { left: 140%; } }

  .cred-top { display: flex; align-items: center; justify-content: space-between; }
  .cred-ico {
    width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; color: #fff;
    background: linear-gradient(150deg, #2b57b0, #1f4693);
    box-shadow: 0 10px 20px -10px rgba(31,70,147,.6);
  }
  .cred-ico svg { width: 26px; height: 26px; }
  .verified {
    display: inline-flex; align-items: center; gap: .35rem;
    font: 700 .72rem "Sora", sans-serif; letter-spacing: .03em; color: #0f7a52;
    background: #e7f7ef; border: 1px solid #c4ecd8; padding: .26rem .6rem; border-radius: 999px;
  }
  .verified .vcheck { width: 13px; height: 13px; color: #0f9d63;
    stroke-dasharray: 26; stroke-dashoffset: 26; }
  .reveal.in .verified .vcheck { animation: vcheck-draw .6s ease .25s forwards; }
  @keyframes vcheck-draw { to { stroke-dashoffset: 0; } }

  .cred-name { font-family: "Sora", sans-serif; font-weight: 700; font-size: 1.15rem; color: #16265a; margin-top: 1.05rem; }
  .cred-auth { color: #6b7a99; font-size: .82rem; margin-top: .25rem; line-height: 1.4; }
  .cred-desc { color: #51607a; font-size: .92rem; line-height: 1.6; margin-top: .85rem; }
  .cred-actions { display: flex; align-items: center; gap: .7rem; margin-top: 1.3rem; }
  .cred-dl {
    display: inline-flex; align-items: center; gap: .45rem;
    font: 600 .88rem "Inter", sans-serif; color: #fff;
    background: linear-gradient(135deg, #2b57b0, #1f4693); padding: .55rem 1rem; border-radius: 10px;
    transition: transform .2s ease, box-shadow .25s ease;
    box-shadow: 0 10px 22px -12px rgba(31,70,147,.8);
  }
  .cred-dl svg { width: 16px; height: 16px; }
  .cred-dl:hover { transform: translateY(-2px); box-shadow: 0 16px 26px -12px rgba(31,70,147,.9); }
  .cred-view {
    display: inline-flex; align-items: center; gap: .4rem;
    font: 600 .85rem "Inter", sans-serif; color: #1f4693;
  }
  .cred-view:hover { text-decoration: underline; }
  .cred-kind {
    font: 700 .62rem "Sora", sans-serif; letter-spacing: .05em; color: #8a97b2;
    border: 1px solid #dde5f2; border-radius: 5px; padding: .08rem .32rem;
  }

  /* ---- Partner standards: expanding image-accordion rail ---- */
  .std-section { background: linear-gradient(180deg, #f6f9ff 0%, #eef3fc 100%); }
  .std-rail { display: flex; flex-direction: column; gap: .9rem; }
  .std-panel {
    position: relative; overflow: hidden; cursor: pointer; outline: none;
    border-radius: 1.15rem; padding: 1.4rem 1.5rem; color: #fff;
    background: linear-gradient(155deg, #21356f 0%, #1f4693 100%);
    box-shadow: 0 16px 36px -26px rgba(22,38,90,.7);
    transition: box-shadow .3s ease;
  }
  .std-panel:focus-visible { box-shadow: 0 0 0 3px rgba(214,179,106,.6); }
  .std-head { display: flex; align-items: center; gap: .9rem; }
  .std-ico {
    width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; flex: none;
    background: rgba(255,255,255,.12); color: #fff;
  }
  .std-ico svg { width: 23px; height: 23px; }
  .std-body { width: 100%; }
  .std-name { display: block; font-family: "Sora", sans-serif; font-weight: 700; font-size: 1.1rem; }
  .std-line { display: block; color: #b9c8ea; font-size: .78rem; margin-top: .12rem; letter-spacing: .03em; }
  .std-desc {
    color: #d7e0f4; font-size: .92rem; line-height: 1.6; margin-top: .9rem;
    max-height: 0; opacity: 0; overflow: hidden;
    transition: max-height .45s ease, opacity .3s ease, margin-top .4s ease;
  }
  .std-panel.open .std-desc {
    max-height: 240px; opacity: 1;
    transition: max-height .45s ease, opacity .4s ease .22s, margin-top .4s ease;
  }
  .std-index {
    position: absolute; right: 1.1rem; top: .8rem; font: 800 .8rem "Sora", sans-serif;
    color: rgba(255,255,255,.22);
  }

  @media (min-width: 920px) {
    .std-rail { flex-direction: row; height: 340px; gap: 1rem; }
    .std-panel {
      flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; justify-content: flex-end;
      transition: flex .55s cubic-bezier(.4,0,.2,1), box-shadow .3s ease;
    }
    /* Fixed-width body = text is laid out at its final (expanded) width from
       the start and stays constant while the panel widens (the panel's
       overflow:hidden simply clips it when collapsed) — so it never re-wraps. */
    .std-body { width: 340px; }
    .std-panel .std-head { flex-direction: column; align-items: flex-start; gap: .7rem; }
    .std-panel .std-desc { max-height: 0; }
    .std-panel.open { flex: 3.4 1 0; }
    .std-panel.open .std-desc { max-height: 200px; }
    .std-panel:not(.open) .std-name { white-space: nowrap; }
    .std-panel:not(.open) .std-line { display: none; }
  }

  /* ---- Reduced motion ---- */
  @media (prefers-reduced-motion: reduce) {
    .cred-card { transform: none !important; transition: box-shadow .3s ease; }
    .cred-card:hover .cred-shine { animation: none; opacity: 0; }
    .reveal.in .verified .vcheck { animation: none; stroke-dashoffset: 0; }
    .std-desc { transition: opacity .3s ease; }
  }
</style>

<script>
  // ---- Cursor tilt + light tracking on credential cards (desktop, fine pointer) ----
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (fine && !reduce) {
    document.querySelectorAll("[data-tilt]").forEach((card) => {
      const el = card as HTMLElement;
      const MAX = 6; // degrees
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        el.style.setProperty("--ry", `${(px - 0.5) * MAX * 2}deg`);
        el.style.setProperty("--rx", `${-(py - 0.5) * MAX * 2}deg`);
        el.style.setProperty("--mx", `${px * 100}%`);
        el.style.setProperty("--my", `${py * 100}%`);
      });
      el.addEventListener("pointerleave", () => {
        el.style.setProperty("--rx", "0deg");
        el.style.setProperty("--ry", "0deg");
      });
    });
  }

  // ---- Expanding standards rail: hover (desktop via :hover sibling logic) + click/keyboard ----
  const rail = document.getElementById("stdRail");
  if (rail) {
    const panels = Array.from(rail.querySelectorAll(".std-panel"));
    const openOnly = (target: Element) => {
      panels.forEach((p) => {
        const on = p === target;
        p.classList.toggle("open", on);
        p.setAttribute("aria-expanded", on ? "true" : "false");
      });
    };
    panels.forEach((p) => {
      p.addEventListener("click", () => openOnly(p));
      p.addEventListener("mouseenter", () => {
        if (window.matchMedia("(min-width: 920px)").matches) openOnly(p);
      });
      p.addEventListener("keydown", (e) => {
        const ev = e as KeyboardEvent;
        if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); openOnly(p); }
      });
    });
  }
</script>
