<script>
  // ---- Journey: scroll-driven route draw + marker travel + stage activation ----
  const journey = document.getElementById("journey");
  if (journey) {
    const steps = Array.from(journey.querySelectorAll(".jstep")) as HTMLElement[];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce) journey.classList.add("journey-anim");

    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = journey.getBoundingClientRect();
      const h = journey.offsetHeight || 1;
      const startAt = window.innerHeight * 0.6;
      let p = (startAt - rect.top) / h;
      p = Math.max(0, Math.min(1, p));
      journey.style.setProperty("--p", p.toFixed(4));
      const passed = p * h;
      steps.forEach((s) => {
        const trigger = s.offsetTop + Math.min(s.offsetHeight * 0.45, 80);
        if (reduce || passed >= trigger) s.classList.add("active");
        else s.classList.remove("active");
      });
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", update);
  }

  // ---- Incoterms explorer ----
  const inco = document.getElementById("inco");
  if (inco) {
    const cover = inco.querySelector(".inco-cover") as HTMLElement;
    const flag = inco.querySelector(".inco-flag") as HTMLElement;
    const name = inco.querySelector(".inco-name") as HTMLElement;
    const hand = inco.querySelector(".inco-hand") as HTMLElement;
    const desc = inco.querySelector(".inco-desc") as HTMLElement;
    const tabs = Array.from(inco.querySelectorAll(".inco-tab")) as HTMLElement[];
    const select = (btn: HTMLElement) => {
      tabs.forEach((t) => t.classList.toggle("active", t === btn));
      const cv = btn.dataset.cover || "0";
      cover.style.width = cv + "%";
      flag.style.left = cv + "%";
      name.textContent = btn.dataset.name || "";
      hand.textContent = btn.dataset.hand || "";
      desc.textContent = btn.dataset.desc || "";
      inco.classList.toggle("has-ins", btn.dataset.ins === "1");
    };
    tabs.forEach((t) => t.addEventListener("click", () => select(t)));
    const def = tabs.find((t) => t.classList.contains("active")) || tabs[0];
    if (def) select(def);
  }
</script>
