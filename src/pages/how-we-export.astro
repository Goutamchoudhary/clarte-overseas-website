---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import WaveDivider from "../components/WaveDivider.astro";

const title = "How We Export — From India's Harvest to Your Port | Clarté Overseas";
const description =
  "Follow a Clarté Overseas shipment end to end: sourcing, customer-led procurement, quality and compliance, export packing, documentation, loading and delivery — plus the after-sales support that keeps the relationship going.";

// The export journey — sequential stages, no numbers. The last one is the finale.
const journey = [
  {
    t: "Sourcing the right material",
    d: "It starts upstream. We map your requirement to a vetted network of growers, processors and manufacturers across India, choosing each source for the crop belt, capability and track record behind it.",
    svg: '<path d="M7 20h10"/><path d="M12 20V9"/><path d="M12 9C9 9 7 7 7 4c3 0 5 2 5 5z"/><path d="M12 9c3 0 5-2 5-5-3 0-5 2-5 5z"/>',
  },
  {
    t: "Procurement built around you",
    d: "Specs before stock. We buy to your grade, mesh, moisture, pack size and volume — confirming the brief, samples and timeline first, so what we procure is what you actually need.",
    svg: '<path d="M8 4H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"/><rect x="8" y="3" width="8" height="4" rx="1"/><path d="m9 14 2 2 4-4"/>',
  },
  {
    t: "Quality inspection & compliance",
    d: "Nothing moves until it passes. Every lot is graded and lab-checked — moisture, microbial counts, foreign matter, metal detection — with documentation matched to the rules of the market you sell into.",
    svg: '<path d="M12 3 4 6v6c0 5 3.4 8.4 8 9 4.6-.6 8-4 8-9V6l-8-3z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    t: "Packed to travel",
    d: "Food-grade liners, sturdy export cartons or bags, clear lot marking and proper palletisation — packaging built for long ocean transits and easy handling at your warehouse.",
    svg: '<path d="M21 8 12 3 3 8m18 0-9 5m9-5v8l-9 5m0-13L3 8m9 5v8m0-8L3 8v8l9 5"/>',
  },
  {
    t: "Documentation that clears customs",
    d: "Commercial invoice, packing list, certificate of origin, phytosanitary and lab certificates — prepared accurately and on time so your consignment moves without hold-ups.",
    svg: '<path d="M14 3v5h5"/><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-5z"/><path d="M9 13h6M9 17h4"/>',
  },
  {
    t: "Loading & onto the vessel",
    d: "Container booking, supervised stuffing and dispatch on the Incoterms we've agreed — with tracking shared so you always know where your goods are on the water.",
    svg: '<path d="M3 17s1.5 1.5 3.5 1.5S10 17 12 17s3.5 1.5 5.5 1.5S21 17 21 17"/><path d="M5 17 3.5 11h17L19 17"/><path d="M12 11V7H7"/><path d="M12 7h5l2 4"/><path d="M12 3v4"/>',
  },
  {
    t: "After the shipment, we stay",
    d: "The container sails and it feels like the deal is done. For us, that's where the relationship really begins — we track it to your door, help with any clearance query, check the product landed right, and get your next order moving.",
    final: true,
    svg: '<path d="M4 15v-3a8 8 0 0 1 16 0v3"/><path d="M4 15a2 2 0 0 0 2 2h1v-6H6a2 2 0 0 0-2 2z"/><path d="M20 15a2 2 0 0 1-2 2h-1v-6h1a2 2 0 0 1 2 2z"/><path d="M18 17v1a3 3 0 0 1-3 3h-3"/>',
  },
];

const incoterms = [
  {
    code: "EXW",
    name: "Ex Works",
    cover: 9,
    hand: "Collected at the source",
    desc: "You take charge right at the source. We make the goods ready; you arrange pickup, export clearance and everything onward. Maximum control for buyers with their own India logistics.",
  },
  {
    code: "FOB",
    name: "Free on Board",
    cover: 38,
    hand: "Handed over once loaded at the origin port",
    desc: "We handle everything up to and including loading your goods onto the vessel at the Indian port. From there, ocean freight and risk are yours. The term most of our buyers choose.",
  },
  {
    code: "CFR",
    name: "Cost & Freight",
    cover: 66,
    hand: "Sea freight paid to your port",
    desc: "We cover the goods plus the sea freight to your destination port. Risk passes once loaded at origin, so you insure the voyage. Useful when you'd rather we book the shipping line.",
  },
  {
    code: "CIF",
    name: "Cost, Insurance & Freight",
    cover: 66,
    ins: true,
    hand: "Freight + marine insurance to your port",
    desc: "Everything in CFR, plus we arrange marine insurance for the voyage to your destination port. The most hands-off term — you simply take over at the destination quay.",
  },
];

const sustain = [
  { t: "Responsible sourcing", d: "We favour growers and processors who treat land and labour fairly.", svg: '<path d="M11 20A7 7 0 0 1 4 13c0-5 7-9 7-9s7 4 7 9a7 7 0 0 1-7 7z"/><path d="M11 20v-7"/>' },
  { t: "Less-waste packaging", d: "Right-sized, food-grade packing that protects product without excess.", svg: '<path d="M7 19a3 3 0 0 1-2.6-4.5L6 11"/><path d="M12 4 9.5 8.3"/><path d="M17 19a3 3 0 0 0 2.6-4.5l-3-5.2a3 3 0 0 0-5.2 0"/><path d="M9 19h8"/>' },
  { t: "Smarter loads", d: "Consolidated, well-planned shipments that cut empty miles and emissions.", svg: '<path d="M3 17h11V6H3zM14 9h4l3 3v5h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>' },
];

const exportFaqs = [
  {
    q: "What is your minimum order quantity?",
    a: "It depends on the product and packing, but we keep MOQs trial-friendly so first-time buyers can start with a test order and scale once the relationship is working. Tell us the item and target volume and we'll confirm what's workable.",
  },
  {
    q: "Can I order a sample before placing a full order?",
    a: "Yes. For most products we can arrange representative samples so you can check the grade, colour, mesh and aroma against your spec before committing to a shipment.",
  },
  {
    q: "Which Incoterms do you work with?",
    a: "Commonly EXW, FOB, CFR and CIF. FOB is what most of our buyers choose, but if you'd rather we book and pay the freight (and insurance), CFR or CIF work just as well. The Incoterms section above shows exactly how far we cover under each.",
  },
  {
    q: "How long does a typical shipment take?",
    a: "Production and pre-shipment checks usually take a couple of weeks after the order is confirmed, then ocean transit depends on your destination port. We share an indicative timeline with your quote and keep you posted as dates firm up.",
  },
  {
    q: "What payment terms do you accept?",
    a: "Every order starts with a proforma invoice. We typically work on an advance T/T deposit with the balance against a copy of the bill of lading, and we accept irrevocable letters of credit at sight for larger or first-time contracts. Terms are flexible for repeat buyers.",
  },
  {
    q: "Which documents come with my consignment?",
    a: "A standard set includes the commercial invoice, packing list and certificate of origin, along with the product specification, lab/analysis reports and any market-specific certificates your importer requires.",
  },
  {
    q: "Can you handle packaging and private labelling to our spec?",
    a: "Yes. We supply food-grade bulk packing as standard and can arrange custom pack sizes, retail packaging and private-label branding when you need it — just share the brief.",
  },
  {
    q: "What happens after my goods are shipped?",
    a: "We don't disappear at the port. We track the shipment to your door, help with any clearance query, check the product landed as expected, and stay on hand to plan your next order. The relationship is the point.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: exportFaqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <!-- ===================== HERO (blueprint) ===================== -->
  <PageHero
    crumb="How We Export"
    eyebrow="The Export Journey"
    watermark="Export"
    heading="How your order travels<br class='hidden sm:block'/> from India to your port"
    subtitle="No black boxes. Here is the route every Clarté Overseas shipment follows — from the field it is sourced in to the vessel it sails on, and the support that carries on long after it lands."
    chips={["Sourced & vetted in India", "Quality-checked, lot by lot", "After-sales included"]}
  />

  <!-- ===================== THE JOURNEY ===================== -->
  <section class="hx-journey-sec blueprint">
    <span class="bp-plus" style="top:6%;left:9%"></span>
    <span class="bp-plus" style="top:46%;right:8%"></span>
    <span class="bp-plus" style="top:88%;left:12%"></span>
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="eyebrow center">Stage by Stage</span>
        <h2 class="tg-1 font-extrabold text-3xl sm:text-4xl mt-4">Follow the route</h2>
        <p class="text-slate-500 text-lg mt-4">Scroll down and the road draws itself. Each stop lights up as your shipment reaches it.</p>
      </div>

      <div class="journey mt-16" id="journey">
        <div class="journey-track" aria-hidden="true">
          <span class="journey-fill"></span>
          <span class="journey-marker"><span class="jm-dot"></span></span>
        </div>
        <ol class="journey-steps">
          {journey.map((s, i) => (
            <li class={`jstep${s.final ? " jstep-final" : ""}`} data-side={i % 2 === 0 ? "left" : "right"}>
              <span class="jstep-node" aria-hidden="true"></span>
              <div class="jstep-card">
                <span class="jstep-ico">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg} />
                </span>
                <div class="jstep-text">
                  {s.final && <span class="jstep-flag">After-sales</span>}
                  <h3 class="jstep-title">{s.t}</h3>
                  <p class="jstep-desc">{s.d}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="hx-aftercare reveal">
        <div class="hx-aftercare-glow" aria-hidden="true"></div>
        <p class="hx-aftercare-kicker">Deal closed? Not quite.</p>
        <p class="hx-aftercare-line">
          A lot of exporters wave goodbye at the port. We see the loaded container as a beginning — because
          the next order, and the one after that, are built on how we show up after this one lands.
        </p>
        <div class="flex flex-wrap justify-center gap-4 mt-8">
          <a href="#" data-wa class="btn btn-wa">Talk to us on WhatsApp
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== INCOTERMS EXPLORER ===================== -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="eyebrow center">Delivery Terms</span>
        <h2 class="tg-5 font-extrabold text-3xl sm:text-4xl mt-4">Incoterms, without the jargon</h2>
        <p class="text-slate-500 text-lg mt-4">Pick a term and see exactly how far we carry the shipment — and where you take over.</p>
      </div>

      <div class="inco reveal d1" id="inco">
        <div class="inco-tabs" role="tablist">
          {incoterms.map((t, i) => (
            <button
              class={`inco-tab${i === 1 ? " active" : ""}`}
              role="tab"
              data-cover={String(t.cover)}
              data-name={t.name}
              data-desc={t.desc}
              data-ins={t.ins ? "1" : "0"}
              data-hand={t.hand}
            >{t.code}</button>
          ))}
        </div>

        <div class="inco-bar">
          <span class="inco-cover"></span>
          <span class="inco-flag"><span class="inco-flag-pole"></span></span>
          <div class="inco-seg" style="flex:18"><span>Source</span></div>
          <div class="inco-seg" style="flex:20"><span>Origin port</span></div>
          <div class="inco-seg" style="flex:28"><span>Ocean freight</span></div>
          <div class="inco-seg" style="flex:18"><span>Your port</span></div>
          <div class="inco-seg" style="flex:16"><span>You</span></div>
        </div>
        <div class="inco-legend">
          <span class="inco-legend-item inco-legend-we">We cover this</span>
          <span class="inco-legend-item inco-legend-you">You take over here</span>
        </div>

        <div class="inco-detail">
          <h3 class="inco-name">Free on Board</h3>
          <p class="inco-hand"></p>
          <p class="inco-desc"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PAYMENT ===================== -->
  <section class="py-20 lg:py-24 pay-sec">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="eyebrow center">Payment, Made Simple</span>
        <h2 class="tg-3 font-extrabold text-3xl sm:text-4xl mt-4 leading-tight">Clear terms, no surprises</h2>
        <p class="text-slate-500 text-lg mt-4">A few small things that make paying — and getting paid — straightforward on both sides.</p>
      </div>

      <div class="pay-bento mt-12">
        <!-- Proforma (wide feature) -->
        <article class="pay-tile pay-wide reveal">
          <span class="pay-corner" aria-hidden="true"></span>
          <span class="pay-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5"/><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M9 13h6M9 17h3"/></svg>
          </span>
          <h3 class="pay-title">Proforma first</h3>
          <p class="pay-desc">Every order opens with a clear proforma invoice — quantity, grade, price and terms set out in writing, before anything moves.</p>
          <div class="pay-deco" aria-hidden="true"><span></span><span></span><span></span></div>
        </article>

        <!-- Costs (wide feature with breakdown bar) -->
        <article class="pay-tile pay-wide reveal d1">
          <span class="pay-corner" aria-hidden="true"></span>
          <span class="pay-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V9M10 20V4M16 20v-7M22 20H2"/></svg>
          </span>
          <h3 class="pay-title">Costs laid bare</h3>
          <p class="pay-desc">FOB or CIF, broken down line by line — you see exactly what each part costs, with nothing hidden.</p>
          <div class="pay-split">
            <span class="ps ps1" style="flex:55">Goods</span>
            <span class="ps ps2" style="flex:30">Freight</span>
            <span class="ps ps3" style="flex:15">Insurance</span>
          </div>
        </article>

        <!-- Advance T/T -->
        <article class="pay-tile reveal d2">
          <span class="pay-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 15h3"/></svg>
          </span>
          <h3 class="pay-title">Advance T/T</h3>
          <p class="pay-desc">A telegraphic-transfer deposit confirms your order and books production.</p>
          <span class="pay-tag">Deposit to start</span>
        </article>

        <!-- L/C at sight -->
        <article class="pay-tile reveal d1">
          <span class="pay-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 8 9 6 9-6"/></svg>
          </span>
          <h3 class="pay-title">L/C at sight</h3>
          <p class="pay-desc">Irrevocable letters of credit for larger or first-time contracts.</p>
          <span class="pay-tag">Bank-backed</span>
        </article>

        <!-- Flexible -->
        <article class="pay-tile reveal d2">
          <span class="pay-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
          </span>
          <h3 class="pay-title">Flexible for regulars</h3>
          <p class="pay-desc">Balance against a copy of the bill of lading, and other terms we tune for repeat buyers.</p>
          <span class="pay-tag">Copy of BL · balance</span>
        </article>

        <!-- Currencies -->
        <article class="pay-tile reveal d1">
          <span class="pay-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/></svg>
          </span>
          <h3 class="pay-title">Billed in your currency</h3>
          <div class="pay-cur">
            <span><b>$</b> USD</span><span><b>€</b> EUR</span><span><b>£</b> GBP</span><span><b>₹</b> INR</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================== SUSTAINABILITY ===================== -->
  <section class="py-20 lg:py-24 sus-sec">
    <span class="sus-leaf" aria-hidden="true"></span>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="eyebrow center eyebrow-green">Doing It Responsibly</span>
        <h2 class="tg-green font-extrabold text-3xl sm:text-4xl mt-4 leading-tight">Trade that respects the source</h2>
        <p class="text-slate-500 text-lg mt-4">Exporting well isn't only about speed and price. A few principles we hold to from field to port.</p>
      </div>
      <div class="sus-grid mt-12">
        {sustain.map((s, i) => (
          <article class={`sus-card reveal d${i + 1}`}>
            <span class="sus-ring">
              <span class="sus-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg} />
              </span>
            </span>
            <h3 class="sus-title">{s.t}</h3>
            <p class="sus-desc">{s.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <WaveDivider topColor="#e9f8f0" bottomColor="#ffffff" accent="rgba(15,107,74,0.12)" />

  <!-- ===================== FAQ ===================== -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center reveal">
        <span class="eyebrow center">FAQ</span>
        <h2 class="tg-2 font-extrabold text-3xl sm:text-4xl mt-4">Exporting with us, answered</h2>
        <p class="text-slate-500 text-lg mt-4">The practical questions buyers ask before the first shipment.</p>
      </div>
      <div class="mt-12 reveal d1">
        {exportFaqs.map((f) => (
          <details class="faq-item">
            <summary>
              {f.q}
              <svg class="chev w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="faq-body">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section id="quote" class="py-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="hero rounded-[2rem] px-8 py-16 sm:px-16 text-center relative overflow-hidden">
        <h2 class="text-white font-extrabold text-3xl sm:text-5xl reveal">Ready to start the journey?</h2>
        <p class="text-slate-300 text-lg mt-5 max-w-xl mx-auto reveal d1">Tell us the product, the form and your destination. We'll map the route, the terms and a quote — and stay with you the whole way.</p>
        <div class="flex flex-wrap justify-center gap-4 mt-9 reveal d2">
          <a href="#" data-wa class="btn btn-wa">Chat on WhatsApp
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
          </a>
          <a href="mailto:info@clarteoverseas.com" class="btn btn-ghost">Enquire Us</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ====================== HOW WE EXPORT PAGE ====================== */
  /* (Blueprint backdrop, crosshairs and the page hero now live in the
     shared stylesheet — see PageHero.astro / styles.css.) */

  /* ---- Journey ---- */
  .hx-journey-sec { padding: 4.5rem 0 5.5rem; }
  .journey { position: relative; max-width: 980px; margin: 0 auto; }
  .journey-track {
    position: absolute; top: 6px; bottom: 6px; left: 24px; width: 0;
    border-left: 2px dashed #cdd9ef;
  }
  .journey-fill {
    position: absolute; left: -2px; top: 0; width: 3px; border-radius: 3px;
    height: calc(var(--p, 0) * 100%);
    background: linear-gradient(180deg, #2b57b0, #1f4693);
    box-shadow: 0 0 14px rgba(31,70,147,.45);
  }
  .journey-marker {
    position: absolute; left: 0; top: calc(var(--p, 0) * 100%); transform: translate(-50%, -50%);
    width: 22px; height: 22px;
  }
  .jm-dot {
    position: absolute; inset: 0; border-radius: 50%; background: #fff; border: 3px solid #1f4693;
    box-shadow: 0 0 0 4px rgba(31,70,147,.15);
  }
  .jm-dot::after {
    content: ""; position: absolute; inset: -3px; border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(31,70,147,.5); animation: jm-pulse 1.8s ease-out infinite;
  }
  @keyframes jm-pulse { 0% { transform: scale(.7); opacity: .8; } 100% { transform: scale(2.1); opacity: 0; } }

  .journey-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2.4rem; }
  .jstep { position: relative; padding-left: 64px; }
  .jstep-node {
    position: absolute; left: 24px; top: 26px; width: 16px; height: 16px; transform: translate(-50%, -50%);
