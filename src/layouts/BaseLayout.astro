---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { SITE, ANALYTICS, SOCIAL, CONTACT } from "../consts";
// Real-user performance monitoring (Core Web Vitals from actual visitors,
// broken down by country, in the Vercel dashboard). Cookie-free, so it
// doesn't need to sit behind the cookie-consent gate the way GA/Clarity do.
import SpeedInsights from "@vercel/speed-insights/astro";
// Vercel Web Analytics — page views/visitor counts by page and country,
// also cookie-free. Named VercelAnalytics to avoid clashing with our own
// GTM/GA4/Clarity loader component, which is already imported as Analytics.
import VercelAnalytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  image = SITE.defaultImage,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  logo: new URL("/assets/logo/logo-icon.svg", SITE.url).href,
  description: SITE.defaultDescription,
  address: {
    "@type": "PostalAddress",
    streetAddress: "1st Floor, CW-59, Sanjay Gandhi Transport Nagar",
    addressLocality: "New Delhi",
    postalCode: "110042",
    addressCountry: "IN",
  },
  telephone: "+919818915310",
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+919818915310",
    contactType: "customer service",
    availableLanguage: "English",
  },
  sameAs: [SOCIAL.linkedin, SOCIAL.instagram, SOCIAL.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={SITE.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts — self-hosted (mirrors Google's own Sora/Inter files+unicode
         ranges exactly, just served from our own origin). Removes a
         render-blocking dependency on fonts.googleapis.com/fonts.gstatic.com,
         which is slow or outright blocked from some countries — the whole
         page used to stall behind that request. -->
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="stylesheet" href="/css/styles.css" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />

    <slot name="head" />
    <Analytics />
    <!-- Instantly (Leadsy) website-visitor identification pixel — async, no
         render-blocking impact. -->
    <script id="vtag-ai-js" is:inline async src="https://r2.leadsy.ai/tag.js" data-pid="6vZuTdMWjDA7rrrb" data-version="062024"></script>
    <!-- defer: i18n.js only needs the DOM to exist (it already waits for
         DOMContentLoaded internally) — it doesn't need to block HTML
         parsing. Blocking here was pushing the page's own Tailwind
         stylesheet further down the load queue, which is what visitors on
         slow connections were seeing as an unstyled flash (oversized logo,
         broken nav) for several seconds before everything caught up. -->
    <script is:inline defer src="/js/i18n.js"></script>
    {CONTACT.calendlyUrl && (
      <>
        <!-- Calendly's popup CSS is only needed if someone actually opens
             that widget — it's never part of the initial page, so it
             shouldn't block first paint on every page load. The
             media="print" swap is the standard no-JS-framework way to load
             a stylesheet without it blocking rendering. -->
        <link rel="preconnect" href="https://assets.calendly.com" />
        <link
          rel="stylesheet"
          href="https://assets.calendly.com/assets/external/widget.css"
          media="print"
          onload="this.media='all'"
        />
        <noscript><link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" /></noscript>
        <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
      </>
    )}
  </head>

  <body class="font-body">
    {ANALYTICS.gtm && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${ANALYTICS.gtm}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}

    <Navbar />
    <slot />
    <Footer />
    <CookieBanner />
    <script is:inline src="/js/script.js"></script>
    <SpeedInsights />
    <VercelAnalytics />
  </body>
</html>
