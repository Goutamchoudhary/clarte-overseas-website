---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { SITE, ANALYTICS, SOCIAL, CONTACT } from "../consts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  image = SITE.defaultImage,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  logo: new URL("/assets/logo/logo-icon.svg", SITE.url).href,
  description: SITE.defaultDescription,
  address: {
    "@type": "PostalAddress",
    streetAddress: "1st Floor, CW-59, Sanjay Gandhi Transport Nagar",
    addressLocality: "Delhi",
    postalCode: "110042",
    addressCountry: "IN",
  },
  telephone: "+919818915310",
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+919818915310",
    contactType: "customer service",
    availableLanguage: "English",
  },
  sameAs: [SOCIAL.linkedin, SOCIAL.instagram, SOCIAL.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={SITE.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="stylesheet" href="/css/styles.css" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />

    <slot name="head" />
    <Analytics />
    <script is:inline src="/js/i18n.js"></script>
    {CONTACT.calendlyUrl && (
      <>
        <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
        <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
      </>
    )}
  </head>

  <body class="font-body">
    {ANALYTICS.gtm && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${ANALYTICS.gtm}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}

    <Navbar />
    <slot />
    <Footer />
    <CookieBanner />
    <script is:inline src="/js/script.js"></script>
  </body>
</html>
